'' ############################################################################
''  analysis/symbols.ti -- what a document declares
''
''  One flat array with PARENT INDICES rather than a tree of pointers. Three
''  reasons, all of which matter later:
''
''    - a document symbol tree is rebuilt from it in one pass, by walking the
''      array and grouping on Parent;
''    - "which symbol contains this offset" is a linear scan, and phase 6's
''      workspace index is the same array with a file id added;
''    - there is nothing to free. The table is a value; copying it copies
''      everything, and no symbol can outlive its table.
''
''  FREEBASIC IS CASE-INSENSITIVE, so every symbol carries its name twice: as
''  the user spelled it, for display, and lower-cased, for lookup. Comparing
''  the display name is the bug this prevents.
'' ############################################################################

#pragma once

#include once "lexer.ti"

'' The values are LSP's SymbolKind and go on the wire unchanged.
enum SymbolKind
    SYM_FILE          = 1
    SYM_MODULE        = 2
    SYM_NAMESPACE     = 3
    SYM_PACKAGE       = 4
    SYM_CLASS         = 5
    SYM_METHOD        = 6
    SYM_PROPERTY      = 7
    SYM_FIELD         = 8
    SYM_CONSTRUCTOR   = 9
    SYM_ENUM          = 10
    SYM_INTERFACE     = 11
    SYM_FUNCTION      = 12
    SYM_VARIABLE      = 13
    SYM_CONSTANT      = 14
    SYM_STRING        = 15
    SYM_NUMBER        = 16
    SYM_BOOLEAN       = 17
    SYM_ARRAY         = 18
    SYM_OBJECT        = 19
    SYM_KEY           = 20
    SYM_NULL          = 21
    SYM_ENUMMEMBER    = 22
    SYM_STRUCT        = 23
    SYM_EVENT         = 24
    SYM_OPERATOR      = 25
    SYM_TYPEPARAMETER = 26
end enum

type SymbolInfo
    Name_         as string       '' as written
    LowerName     as string       '' as compared
    Kind_         as SymbolKind
    Detail_       as string       '' the signature or type, shown after the name
    Doc_          as string       '' the '' comment block above the declaration

    Parent        as long         '' index into the table; -1 at file level

    '' The whole declaration -- for a procedure, opener to closer. This is what
    '' an editor highlights when the outline row is selected.
    RangeStart    as long
    RangeEnd      as long

    '' Just the identifier. This is where "go to definition" lands, and what
    '' an outline shows as selected.
    NameStart     as long
    NameEnd       as long

    IsLocal       as boolean      '' a local or a parameter: NOT in the outline
    IsDeclaration as boolean      '' a DECLARE prototype, not a body

    '' A parameter, rather than a local declared in the body. Both are locals
    '' and neither belongs in the outline, but only a parameter has a place in
    '' a signature -- which is what inlay hints and semantic tokens need to
    '' tell them apart, and what nothing before phase 7 had to ask.
    IsParameter   as boolean

    '' Declared with a leading `public`. In a tiko MODULE (a directory of files that each
    '' begin `#module "name"`) that is what an importer may name through the import's
    '' alias; in classic code it means nothing, as in FreeBASIC.
    IsPublic      as boolean
end type

type SymbolArray as containers.Array( of SymbolInfo )

'' ----------------------------------------------------------------------------
''  SymbolTable
'' ----------------------------------------------------------------------------
type SymbolTable
    public:
        Items as SymbolArray

        declare function Count( ) as long
        declare sub      Clear( )

        '' Appends and returns its index, so the caller can use it as a parent.
        declare function Add( byref sym as SymbolInfo ) as long

        '' The INNERMOST symbol whose range contains `offset`, or -1. This is
        '' how "what scope am I in" is answered.
        declare function InnermostAt( byval offset as long ) as long

        '' Name lookup from a position, honouring scope: locals and parameters
        '' of the enclosing procedure first, then the members of each enclosing
        '' type or namespace, then file level. -1 if nothing matches.
        declare function Resolve( byref lowerName as string, byval fromOffset as long ) as long

        '' Member lookup, for `something.Name`. Phase 4 has no type inference,
        '' so this matches on NAME AND KIND across the file and takes the first
        '' -- correct for a field name that appears once, a guess when the same
        '' member name appears in two types. The type system replaces it.
        declare function ResolveMember( byref lowerName as string ) as long

        '' True when `index` is a container: a type, union, enum or namespace.
        declare function IsContainer( byval index_ as long ) as boolean
end type

'' ----------------------------------------------------------------------------
''  Finding the word under the cursor
'' ----------------------------------------------------------------------------

'' Index of the token containing `offset`, or -1. A position at the very end of
'' an identifier still belongs to it, which is what an editor means when the
'' caret sits after the last letter.
declare function TokenIndexAt( byref tokens as TokenArray, byval offset as long ) as long

'' True if the token before `index`, skipping nothing, is a dot or a `->` --
'' i.e. the identifier is being used as a member.
declare function IsMemberAccess( byref text_ as string, byref tokens as TokenArray, byval index_ as long ) as boolean

'' The markdown a hover shows for a symbol: a tiko code block with the
'' declaration, a line naming the kind, then the documentation comment.
declare function SymbolHoverMarkdown( byref sym as SymbolInfo ) as string

'' The hover for one of tiko-lang's fixed-width type names at `offset` --
'' `type int32 as long` and its size; or one of its string-slice types, slice,
'' uslice and wslice, and what they view -- or "" when the token there is not one,
'' or is a member after a dot. The caller asks only once the name has failed
'' to resolve, so a file's own int32 wins, as it does in the compiler.
declare function BuiltinTypedefHoverMarkdown( byref text_ as string, byref tokens as TokenArray, _
                                              byval offset as long ) as string
'' ...and tiko-lang's predeclared constant, nullptr, on the same terms.
declare function BuiltinConstantHoverMarkdown( byref text_ as string, byref tokens as TokenArray, _
                                               byval offset as long ) as string

'' The human name for a kind, used in hover text.
declare function SymbolKindName( byval kind as SymbolKind ) as string
