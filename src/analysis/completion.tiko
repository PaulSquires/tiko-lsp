'' ############################################################################
''  analysis/completion.tiko -- what could be typed here
'' ############################################################################

#import "std/containers"
#import "std/strings"
#include once "completion.ti"
#include once "intrinsics.ti"

'' The reserved words a type can begin with, offered after a declaration's
'' `as`. Any that the keyword table does not hold is skipped.
const TYPE_KEYWORDS = "any boolean byte const double function integer long longint " & _
                      "short single string sub ubyte uinteger ulong ulongint ushort " & _
                      "ustring wstring zstring"

'' ############################################################################
''  Context
'' ############################################################################

'' The index of the last token that STARTS before `offset`. That is the token
'' the cursor is in or just past, which is what decides the context: a caret
'' sitting after `customer.` is past the dot, and after `customer.Na` is past
'' the partial name.
private function TokenBefore( byref tokens as TokenArray, byval offset as long ) as long
    dim as long found = -1

    for i as long = 0 to tokens.Count( ) - 1
        dim as Token t = tokens[i]
        if( t.Kind = TK_EOF ) then exit for
        if( t.Kind = TK_EOL ) then continue for
        if( t.Start_ >= offset ) then exit for
        found = i
    next

    return found
end function

'' A member access: `.`, or `->` through a pointer -- `p->x` is `(*p).x`, and
'' its members are the pointed-to type's, which is what the declared type
'' NAME already names (`as Point ptr` reads as Point).
private function IsDot( byref text_ as string, byref t as Token ) as boolean
    if( t.Kind <> TK_OP ) then return false
    dim as string op = TokenText( text_, t )
    return op = "." orelse op = "->"
end function

'' Reads the member chain that ends at the dot `dotIdx`, right to left:
''
''     lg.Warn( ).Str( "user", name ).Int_( "n", 4 ).
''
'' is base `lg`, chain warn, str, int_. A call's or an index's parentheses,
'' and a pointer index's brackets, are skipped as one balanced group -- the
'' arguments are not read, only the name before them. The chain stops at the first thing that is not `name`,
'' `name( ... )` or a dot between them, and at a line end. False when there is
'' no name at all left of the dot -- `(a + b).` -- so nothing is resolved.
function ReadMemberChain( byref text_ as string, byref tokens as TokenArray, _
                             byval dotIdx as long, byref ctx as CompletionContext ) as boolean
    dim names as CompletionChain
    dim as long nameAt = -1
    dim as long j = dotIdx - 1

    do while( j >= 0 )
        if( tokens[j].Kind = TK_RPAREN orelse tokens[j].Kind = TK_RBRACKET ) then
            dim as long depth = 0
            while( j >= 0 )
                dim as TokenKind k = tokens[j].Kind
                if( k = TK_EOL ) then return false
                if( k = TK_RPAREN orelse k = TK_RBRACKET ) then depth += 1
                if( k = TK_LPAREN orelse k = TK_LBRACKET ) then
                    depth -= 1
                    if( depth = 0 ) then exit while
                end if
                j -= 1
            wend
            j -= 1
            if( j < 0 ) then return false
        end if

        dim as Token nm = tokens[j]
        if( nm.Kind <> TK_IDENT andalso nm.Kind <> TK_KEYWORD ) then return false
        names.Push( lcase( TokenText( text_, nm ) ) )
        nameAt = nm.Start_

        if( j >= 2 andalso IsDot( text_, tokens[j - 1] ) ) then
            j -= 2
        else
            exit do
        end if
    loop
    if( names.Count( ) = 0 ) then return false

    '' Collected last-first; the base is the leftmost name.
    ctx.BaseName   = names[names.Count( ) - 1]
    ctx.BaseOffset = nameAt
    ctx.Chain.Clear( )
    for k as long = names.Count( ) - 2 to 0 step -1
        ctx.Chain.Push( names[k] )
    next
    return true
end function

'' True when token `asIdx` is an `as` that a TYPE follows: `dim p as `,
'' `function f( ) as `, `x as ` in a parameter list. Not the `as` of
'' `#import "std/strings" as s` or `name "a" as "b"` (a string before it),
'' `open "f" for input as #1` (an OPEN statement), or `select case as const`.
private function IsTypeAs_( byref text_ as string, byref tokens as TokenArray, _
                            byval asIdx as long ) as boolean
    if( tokens[asIdx].Kind <> TK_KEYWORD ) then return false
    if( lcase( TokenText( text_, tokens[asIdx] ) ) <> "as" ) then return false
    if( asIdx = 0 ) then return false

    dim as Token prev = tokens[asIdx - 1]
    if( prev.Kind = TK_STRING orelse prev.Kind = TK_EOL ) then return false
    if( prev.Kind = TK_KEYWORD andalso lcase( TokenText( text_, prev ) ) = "case" ) then return false

    '' The statement's first token.
    dim as long j = asIdx
    while( j > 0 )
        dim as TokenKind k = tokens[j - 1].Kind
        if( k = TK_EOL orelse k = TK_COLON ) then exit while
        j -= 1
    wend
    if( tokens[j].Kind = TK_KEYWORD ) then
        select case lcase( TokenText( text_, tokens[j] ) )
            case "open", "name"
                return false
        end select
    end if
    return true
end function

function CompletionContextAt( byref text_ as string, byref tokens as TokenArray, _
                              byval offset as long ) as CompletionContext
    dim as CompletionContext ctx
    ctx.Kind_      = CMPCTX_SCOPE
    ctx.BaseOffset = -1

    dim as long i = TokenBefore( tokens, offset )
    if( i < 0 ) then return ctx

    dim as Token last_ = tokens[i]

    '' Inside a comment or a string, there is nothing to complete. Returning
    '' the scope list there is how an editor ends up offering `function` in the
    '' middle of a sentence.
    if( last_.Kind = TK_COMMENT orelse last_.Kind = TK_STRING ) then
        if( offset <= last_.Start_ + last_.Length_ ) then
            ctx.Kind_ = CMPCTX_NONE
            return ctx
        end if
    end if

    '' `something.` or `something->` -- the cursor is right after the dot.
    if( IsDot( text_, last_ ) ) then
        ctx.Kind_ = CMPCTX_MEMBER
        ReadMemberChain( text_, tokens, i, ctx )
        return ctx
    end if

    '' `dim p as |` -- past the `as` and on its line: a type comes next.
    if( last_.Kind = TK_KEYWORD andalso offset > last_.Start_ + last_.Length_ ) then
        dim as long gap = offset - ( last_.Start_ + last_.Length_ )
        if( instr( mid( text_, last_.Start_ + last_.Length_ + 1, gap ), chr(10) ) = 0 ) then
            if( IsTypeAs_( text_, tokens, i ) ) then ctx.Kind_ = CMPCTX_TYPE
        end if
        return ctx
    end if

    '' A partial word. It may follow a dot or a type's `as`.
    if( last_.Kind = TK_IDENT orelse last_.Kind = TK_KEYWORD ) then
        if( offset <= last_.Start_ + last_.Length_ ) then
            ctx.Prefix = lcase( mid( text_, last_.Start_ + 1, offset - last_.Start_ ) )

            if( i >= 2 ) then
                if( IsDot( text_, tokens[i - 1] ) ) then
                    if( ReadMemberChain( text_, tokens, i - 1, ctx ) ) then ctx.Kind_ = CMPCTX_MEMBER
                end if
            end if
            if( ctx.Kind_ = CMPCTX_SCOPE andalso i >= 1 ) then
                if( IsTypeAs_( text_, tokens, i - 1 ) ) then ctx.Kind_ = CMPCTX_TYPE
            end if
        end if
    end if

    return ctx
end function

'' ############################################################################
''  Candidates
'' ############################################################################

function CompletionKindOf( byval kind as SymbolKind ) as CompletionKind
    select case kind
        case SYM_METHOD      : return CMP_METHOD
        case SYM_FUNCTION    : return CMP_FUNCTION
        case SYM_CONSTRUCTOR : return CMP_CONSTRUCTOR
        case SYM_PROPERTY    : return CMP_PROPERTY
        case SYM_OPERATOR    : return CMP_OPERATOR
        case SYM_FIELD       : return CMP_FIELD
        case SYM_VARIABLE    : return CMP_VARIABLE
        case SYM_CONSTANT    : return CMP_CONSTANT
        case SYM_ENUM        : return CMP_ENUM
        case SYM_ENUMMEMBER  : return CMP_ENUMMEMBER
        case SYM_STRUCT      : return CMP_STRUCT
        case SYM_CLASS       : return CMP_CLASS
        case SYM_NAMESPACE   : return CMP_MODULE
    end select
    return CMP_TEXT
end function

function IsOfferedMember( byref sym as SymbolInfo ) as boolean
    if( sym.Kind_ = SYM_CONSTRUCTOR orelse sym.Kind_ = SYM_OPERATOR ) then return false
    if( sym.LowerName = "constructor" orelse sym.LowerName = "destructor" ) then return false
    return true
end function

function IsTypeSymbol( byref sym as SymbolInfo ) as boolean
    if( len(sym.Name_) = 0 ) then return false
    select case sym.Kind_
        case SYM_STRUCT, SYM_CLASS, SYM_ENUM, SYM_INTERFACE, SYM_NAMESPACE
            return true
    end select
    return false
end function

'' The type name in `as <type>...`.
private function TypeNameAfterAs_( byref detail as string ) as string
    if( lcase( left( detail, 3 ) ) <> "as " ) then return ""

    dim as string rest = trim( mid( detail, 4 ) )
    if( len(rest) = 0 ) then return ""

    '' Take the first name, and stop at anything that is not part of one --
    '' `Customer ptr`, `containers.Array( of string )` and `long` all end here. A
    '' DOTTED name is qualified by its namespace, and the type is its LAST
    '' segment: `FB.Result( of boolean, TrkError )` names Result, not FB.
    dim as string word_
    for i as long = 0 to len(rest) - 1
        dim as ubyte c = rest[i]
        dim as boolean part = false
        if( c >= asc("a") andalso c <= asc("z") ) then part = true
        if( c >= asc("A") andalso c <= asc("Z") ) then part = true
        if( c >= asc("0") andalso c <= asc("9") ) then part = true
        if( c = asc("_") ) then part = true
        if( c = asc(".") ) then part = true
        if( part = false ) then exit for
        word_ &= chr( c )
    next

    dim as long dotAt = instrrev( word_, "." )
    if( dotAt > 0 ) then word_ = mid( word_, dotAt + 1 )
    return word_
end function

function DeclaredTypeName( byref sym as SymbolInfo ) as string
    '' The detail of a variable or field is `as <type>`; of a procedure, its
    '' signature. Only the first form names a type.
    return TypeNameAfterAs_( sym.Detail_ )
end function

function ReturnTypeName( byref sym as SymbolInfo ) as string
    select case sym.Kind_
        case SYM_FUNCTION, SYM_METHOD, SYM_PROPERTY
        case else
            return ""
    end select

    '' The return type follows the parameter list: the first `(` outside a
    '' string -- `overload alias "x" ( ... )` has one first -- to its match.
    '' No list at all (`function Now as double`) leaves the detail whole.
    dim as string d = sym.Detail_
    dim as long depth = 0
    dim as long closeAt = -1
    dim as boolean quoted = false
    for i as long = 0 to len(d) - 1
        dim as ubyte c = d[i]
        if( c = 34 ) then quoted = ( quoted = false )
        if( quoted ) then continue for
        if( c = asc("(") ) then depth += 1
        if( c = asc(")") ) then
            depth -= 1
            if( depth = 0 ) then
                closeAt = i
                exit for
            end if
        end if
    next

    dim as string rest = trim( iif( closeAt >= 0, mid( d, closeAt + 2 ), d ) )
    if( lcase( left( rest, 6 ) ) = "byref " ) then rest = trim( mid( rest, 7 ) )
    return TypeNameAfterAs_( rest )
end function

function MemberTypeName( byref sym as SymbolInfo ) as string
    select case sym.Kind_
        case SYM_FUNCTION, SYM_METHOD, SYM_PROPERTY
            return ReturnTypeName( sym )
    end select
    return DeclaredTypeName( sym )
end function

'' The name of the symbol a member expression is reaching into, resolved to a
'' CONTAINER symbol index, or -1.
''
'' Three cases are worth having, and the third is why this is not just a name
'' lookup:
''
''     Colour.       the base IS a type, enum or namespace
''     this.         inside a method, the type it belongs to
''     customer.     a variable, whose DECLARED TYPE is the container
''
'' That last one is the whole of phase 5's type knowledge: the type NAME is
'' read out of the declaration and looked up. A CHAIN -- `GetCustomer( ).`,
'' `lg.Warn( ).Str( "k", v ).` -- is walked a link at a time, each member's
'' declared or return type naming the next container. It is not inference:
'' `(a + b).` and a generic's `E` are not resolved, and fall back to the
'' file-wide member list.
'' The container a TYPE NAME stands for in this file, following aliases --
'' `type CustAlias as Customer` -- as many hops as there are, bounded so a
'' cycle cannot loop. -1 when the name, or what it finally names, is not a
'' container this file declares (the handler then asks the index).
private function ContainerNamed_( byref syms as SymbolTable, byref typeName as string ) as long
    dim as string want = typeName
    for hop as long = 1 to 8
        dim as long found = -1
        for i as long = 0 to syms.Count( ) - 1
            if( syms.IsContainer( i ) andalso syms.Items[i].LowerName = want ) then
                found = i
                exit for
            end if
        next
        if( found < 0 ) then return -1

        '' An alias's detail is `as <target>`; a real type's is its keyword.
        dim as string target = lcase( DeclaredTypeName( syms.Items[found] ) )
        if( len(target) = 0 orelse target = want ) then return found
        want = target
    next
    return -1
end function

function EnclosingTypeIndex( byref syms as SymbolTable, byval offset as long ) as long
    dim as long scope_ = syms.InnermostAt( offset )
    while( scope_ >= 0 )
        if( syms.IsContainer( scope_ ) ) then return scope_

        '' An out-of-line member -- `sub Customer.SetName` -- is parented
        '' to the file, so its type is found through its own name.
        dim as string nm = syms.Items[scope_].Name_
        dim as long dotAt = instr( nm, "." )
        if( dotAt > 0 ) then
            dim as string typeName = lcase( left( nm, dotAt - 1 ) )
            for i as long = 0 to syms.Count( ) - 1
                if( syms.IsContainer( i ) andalso syms.Items[i].LowerName = typeName ) then return i
            next
        end if

        scope_ = syms.Items[scope_].Parent
    wend
    return -1
end function

'' The member `lowerName` of the container `parent`: declared inside it, or
'' defined out of line as `T.name`. Of an overload set -- `Warn( ) as LogEvent`
'' beside `sub Warn( m )` -- the first that HAS a type wins, since only that
'' one can continue a chain.
private function MemberChild_( byref syms as SymbolTable, byval parent as long, _
                               byref lowerName as string ) as long
    dim as long fallback = -1
    dim as string dotted = lcase( syms.Items[parent].Name_ ) & "." & lowerName
    for i as long = 0 to syms.Count( ) - 1
        if( syms.Items[i].IsLocal ) then continue for
        if( syms.Items[i].LowerName <> lowerName ) then continue for
        if( syms.Items[i].Parent <> parent andalso lcase( syms.Items[i].Name_ ) <> dotted ) then continue for
        if( len( MemberTypeName( syms.Items[i] ) ) > 0 ) then return i
        if( fallback < 0 ) then fallback = i
    next
    return fallback
end function

private function ResolveMemberBase( byref syms as SymbolTable, byref ctx as CompletionContext ) as long
    if( len(ctx.BaseName) = 0 ) then return -1

    dim as long c = -1

    if( ctx.BaseName = "this" ) then
        '' `this` means the type whose method we are inside.
        c = EnclosingTypeIndex( syms, ctx.BaseOffset )
    else
        '' A container named directly: `Colour.`, `App.`
        for i as long = 0 to syms.Count( ) - 1
            if( syms.IsContainer( i ) andalso syms.Items[i].LowerName = ctx.BaseName ) then
                c = ContainerNamed_( syms, ctx.BaseName )
                exit for
            end if
        next

        '' A variable, field or parameter: follow its declared type -- a
        '' function, its return type -- and through any alias to the type
        '' that has the members.
        if( c < 0 ) then
            dim as long v = syms.Resolve( ctx.BaseName, ctx.BaseOffset )
            if( v >= 0 ) then
                dim as string typeName = lcase( MemberTypeName( syms.Items[v] ) )
                if( len(typeName) > 0 ) then c = ContainerNamed_( syms, typeName )
            end if
        end if
    end if

    '' Then each link of the chain: the member's type is the next container.
    for k as long = 0 to ctx.Chain.Count( ) - 1
        if( c < 0 ) then return -1
        dim as long m = MemberChild_( syms, c, ctx.Chain[k] )
        if( m < 0 ) then return -1
        dim as string typeName = lcase( MemberTypeName( syms.Items[m] ) )
        if( len(typeName) = 0 ) then return -1
        c = ContainerNamed_( syms, typeName )
    next

    return c
end function

'' Appends, unless that label is already there. tiko is case-insensitive,
'' so the comparison is too -- and a DECLARE plus its body must not show the
'' same name twice.
private sub AddItem( byref items as CompletionItemArray, byref label_ as string, _
                     byval kind as CompletionKind, byref detail as string, _
                     byref doc as string, byval group as CompletionGroup )
    if( len(label_) = 0 ) then exit sub

    dim as string want = lcase( label_ )
    for i as long = 0 to items.Count( ) - 1
        if( items[i].LowerLabel = want ) then exit sub
    next

    dim as CompletionItem it
    it.Label      = label_
    it.LowerLabel = want
    it.Kind_      = kind
    it.Detail_    = detail
    it.Doc_       = doc
    it.SortGroup  = group
    items.Push( it )
end sub

private sub AddSymbolItem( byref items as CompletionItemArray, byref sym as SymbolInfo, _
                           byval group as CompletionGroup )
    '' A dotted name is offered by its LAST segment: after `Customer.` the
    '' member is `SetName`, not `Customer.SetName`.
    dim as string label_ = sym.Name_
    dim as long dotAt = instrrev( label_, "." )
    if( dotAt > 0 ) then label_ = mid( label_, dotAt + 1 )

    AddItem( items, label_, CompletionKindOf( sym.Kind_ ), sym.Detail_, sym.Doc_, group )
end sub

'' Children of `parent`, for a member list.
private sub AddMembersOf( byref syms as SymbolTable, byref items as CompletionItemArray, _
                          byval parent as long )
    for i as long = 0 to syms.Count( ) - 1
        if( syms.Items[i].Parent <> parent ) then continue for
        if( syms.Items[i].IsLocal ) then continue for
        if( IsOfferedMember( syms.Items[i] ) = false ) then continue for
        AddSymbolItem( items, syms.Items[i], CMPGROUP_MEMBER )
    next

    '' Members defined OUT OF LINE are parented to the file, not to the type,
    '' so they are found by their dotted name instead.
    dim as string typeName = lcase( syms.Items[parent].Name_ ) & "."
    for i as long = 0 to syms.Count( ) - 1
        if( syms.Items[i].IsLocal ) then continue for
        if( left( lcase( syms.Items[i].Name_ ), len(typeName) ) = typeName ) then
            if( IsOfferedMember( syms.Items[i] ) ) then AddSymbolItem( items, syms.Items[i], CMPGROUP_MEMBER )
        end if
    next
end sub

sub CollectCompletions( byref text_ as string, byref tokens as TokenArray, _
                        byref syms as SymbolTable, byval offset as long, _
                        byref items as CompletionItemArray )
    items.Clear( )

    dim as CompletionContext ctx = CompletionContextAt( text_, tokens, offset )

    '' -- nowhere -------------------------------------------------------------
    if( ctx.Kind_ = CMPCTX_NONE ) then exit sub

    '' -- after a dot ---------------------------------------------------------
    if( ctx.Kind_ = CMPCTX_MEMBER ) then
        dim as long base_ = ResolveMemberBase( syms, ctx )

        if( base_ >= 0 ) then
            AddMembersOf( syms, items, base_ )
            exit sub
        end if

        '' The base could not be resolved -- an expression, an #included type,
        '' something half-typed. Offering every member in the file is a guess,
        '' but a useful one, and it is strictly better than offering keywords.
        for i as long = 0 to syms.Count( ) - 1
            select case syms.Items[i].Kind_
                case SYM_FIELD, SYM_METHOD, SYM_PROPERTY, SYM_ENUMMEMBER
                    AddSymbolItem( items, syms.Items[i], CMPGROUP_MEMBER )
            end select
        next
        exit sub
    end if

    '' -- after a declaration's `as` --------------------------------------------
    ''
    '' Types only: what the file declares, tiko's typedefs, and the reserved
    '' words a type can begin with. A local or `if` here is never the answer.
    if( ctx.Kind_ = CMPCTX_TYPE ) then
        for i as long = 0 to syms.Count( ) - 1
            if( IsTypeSymbol( syms.Items[i] ) ) then AddSymbolItem( items, syms.Items[i], CMPGROUP_FILE )
        next

        dim tds as containers.Array( of string ) = AllBuiltinTypedefs( )
        for i as long = 0 to tds.Count( ) - 1
            AddItem( items, tds[i], CMP_STRUCT, _
                     "type " & tds[i] & " as " & BuiltinTypedefTarget( tds[i] ), _
                     "", CMPGROUP_KEYWORD )
        next

        dim tws as containers.Array( of string ) = strings.Split( TYPE_KEYWORDS, " " )
        for i as long = 0 to tws.Count( ) - 1
            if( IsKeyword( tws[i] ) = false ) then continue for
            AddItem( items, tws[i], CMP_KEYWORD, "keyword", "", CMPGROUP_KEYWORD )
        next
        exit sub
    end if

    '' -- an ordinary position -------------------------------------------------
    ''
    '' Nearest scope first. The groups are what make a local outrank a keyword
    '' in the client's list even when the keyword sorts earlier.
    dim as long scope_ = syms.InnermostAt( offset )

    '' 1. locals and parameters of the enclosing procedure, then whatever
    ''    encloses that, walking outwards.
    dim as long walk = scope_
    while( walk >= 0 )
        for i as long = 0 to syms.Count( ) - 1
            if( syms.Items[i].Parent <> walk ) then continue for

            dim as CompletionGroup g = CMPGROUP_TYPE
            if( syms.Items[i].IsLocal ) then g = CMPGROUP_LOCAL
            AddSymbolItem( items, syms.Items[i], g )
        next
        walk = syms.Items[walk].Parent
    wend

    '' 2. everything the file declares, including the procedure we are in.
    for i as long = 0 to syms.Count( ) - 1
        if( syms.Items[i].IsLocal ) then continue for
        AddSymbolItem( items, syms.Items[i], CMPGROUP_FILE )
    next

    '' 3. tiko-lang's fixed-width type names, which are typedefs rather than
    ''    reserved words -- so a local or a file-level name of the same
    ''    spelling, added above, keeps the slot (AddItem drops the repeat).
    dim typedefs as containers.Array( of string ) = AllBuiltinTypedefs( )
    for i as long = 0 to typedefs.Count( ) - 1
        AddItem( items, typedefs[i], CMP_STRUCT, _
                 "type " & typedefs[i] & " as " & BuiltinTypedefTarget( typedefs[i] ), _
                 "", CMPGROUP_KEYWORD )
    next

    ''    ...and its predeclared constant, nullptr, on the same terms.
    dim consts as containers.Array( of string ) = AllBuiltinConstants( )
    for i as long = 0 to consts.Count( ) - 1
        AddItem( items, consts[i], CMP_CONSTANT, BuiltinConstantDecl( consts[i] ), _
                 "", CMPGROUP_KEYWORD )
    next

    ''    ...and its built-in procedures -- left, mid, instr -- as functions, with their
    ''    codetip as the detail. Before the keywords, so that `left` is offered once,
    ''    as the function it is (AddItem keeps the first of a name).
    dim builtins as containers.Array( of string ) = IntrinsicNames( )
    for i as long = 0 to builtins.Count( ) - 1
        AddItem( items, lcase( builtins[i] ), CMP_FUNCTION, IntrinsicCodetip( builtins[i] ), _
                 "", CMPGROUP_KEYWORD )
    next

    '' 4. the language. Last, because a reserved word is almost never what the
    ''    user is reaching for, and there are 247 of them.
    dim words as containers.Array( of string ) = AllKeywords( )
    for i as long = 0 to words.Count( ) - 1
        AddItem( items, words[i], CMP_KEYWORD, "keyword", "", CMPGROUP_KEYWORD )
    next
end sub
