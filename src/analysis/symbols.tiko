'' ############################################################################
''  analysis/symbols.tiko -- the symbol table and name resolution
'' ############################################################################

#import "std/containers"
#include once "symbols.ti"

function SymbolTable.Count( ) as long
    return this.Items.Count( )
end function

sub SymbolTable.Clear( )
    this.Items.Clear( )
end sub

function SymbolTable.Add( byref sym as SymbolInfo ) as long
    this.Items.Push( sym )
    return this.Items.Count( ) - 1
end function

function SymbolTable.IsContainer( byval index_ as long ) as boolean
    if( index_ < 0 orelse index_ >= this.Items.Count( ) ) then return false
    select case this.Items[index_].Kind_
        case SYM_STRUCT, SYM_CLASS, SYM_INTERFACE, SYM_ENUM, SYM_NAMESPACE : return true
    end select
    return false
end function

function SymbolTable.InnermostAt( byval offset as long ) as long
    dim as long best = -1
    dim as long bestSize = 0

    for i as long = 0 to this.Items.Count( ) - 1
        dim as SymbolInfo s = this.Items[i]
        if( offset < s.RangeStart orelse offset > s.RangeEnd ) then continue for

        '' Smallest containing range wins, which is the innermost scope.
        dim as long size_ = s.RangeEnd - s.RangeStart
        if( best < 0 orelse size_ <= bestSize ) then
            best = i
            bestSize = size_
        end if
    next

    return best
end function

function SymbolTable.Resolve( byref lowerName as string, byval fromOffset as long ) as long
    if( len(lowerName) = 0 ) then return -1

    '' -- 1. walk out from the innermost scope ---------------------------------
    ''
    '' At each level, only that scope's own children are considered: a local of
    '' the procedure, then a member of the enclosing type, and so on. This is
    '' what makes a local shadow a global of the same name, as it does in the
    '' language.
    dim as long scope_ = this.InnermostAt( fromOffset )

    while( scope_ >= 0 )
        for i as long = 0 to this.Items.Count( ) - 1
            if( this.Items[i].Parent <> scope_ ) then continue for
            if( this.Items[i].LowerName = lowerName ) then return i
        next

        '' The scope symbol itself may be what was named -- a recursive call
        '' naming its own procedure, for instance.
        if( this.Items[scope_].LowerName = lowerName ) then return scope_

        scope_ = this.Items[scope_].Parent
    wend

    '' -- 2. file level ---------------------------------------------------------
    ''
    '' A definition beats a DECLARE: hovering a call should show the body's
    '' location, not the prototype's, when the file has both.
    dim as long prototype_ = -1
    for i as long = 0 to this.Items.Count( ) - 1
        if( this.Items[i].Parent <> -1 ) then continue for
        if( this.Items[i].LowerName <> lowerName ) then continue for
        if( this.Items[i].IsDeclaration = false ) then return i
        if( prototype_ < 0 ) then prototype_ = i
    next
    if( prototype_ >= 0 ) then return prototype_

    '' -- 3. anywhere ------------------------------------------------------------
    ''
    '' A member defined out of line -- `sub Customer.SetName` -- is parented to
    '' its type, not to the file, so a plain name may still find it here.
    for i as long = 0 to this.Items.Count( ) - 1
        if( this.Items[i].IsLocal ) then continue for
        if( this.Items[i].LowerName = lowerName ) then return i
    next

    return -1
end function

function SymbolTable.ResolveMember( byref lowerName as string ) as long
    if( len(lowerName) = 0 ) then return -1

    for i as long = 0 to this.Items.Count( ) - 1
        dim as SymbolInfo s = this.Items[i]
        if( s.LowerName <> lowerName ) then continue for
        select case s.Kind_
            case SYM_FIELD, SYM_METHOD, SYM_PROPERTY, SYM_ENUMMEMBER, SYM_CONSTRUCTOR
                return i
        end select
    next

    '' Not a member of anything known. Fall back to any symbol of that name --
    '' `Foo.Bar` where Foo is a namespace looks like member access too.
    for i as long = 0 to this.Items.Count( ) - 1
        if( this.Items[i].LowerName = lowerName ) then return i
    next

    return -1
end function

'' ############################################################################
''  Finding the word under the cursor
'' ############################################################################

function TokenIndexAt( byref tokens as TokenArray, byval offset as long ) as long
    for i as long = 0 to tokens.Count( ) - 1
        dim as Token t = tokens[i]
        if( t.Kind = TK_EOL orelse t.Kind = TK_EOF ) then continue for

        '' The end is inclusive: with the caret just after the last letter of a
        '' name, an editor still means that name.
        if( offset >= t.Start_ andalso offset <= t.Start_ + t.Length_ ) then
            '' Prefer a token the offset is strictly inside; only fall back to
            '' the one that merely ends here.
            if( offset < t.Start_ + t.Length_ ) then return i
            if( i + 1 < tokens.Count( ) ) then
                dim as Token nxt = tokens[i + 1]
                if( nxt.Start_ = offset andalso _
                    (nxt.Kind = TK_IDENT orelse nxt.Kind = TK_KEYWORD) ) then return i + 1
            end if
            return i
        end if
    next

    return -1
end function

function IsMemberAccess( byref text_ as string, byref tokens as TokenArray, byval index_ as long ) as boolean
    if( index_ <= 0 ) then return false
    dim as Token prev_ = tokens[index_ - 1]
    if( prev_.Kind <> TK_OP ) then return false
    dim as string op = TokenText( text_, prev_ )
    return op = "." orelse op = "->"
end function

function SymbolKindName( byval kind as SymbolKind ) as string
    select case kind
        case SYM_NAMESPACE   : return "namespace"
        case SYM_CLASS       : return "class"
        case SYM_INTERFACE   : return "interface"
        case SYM_STRUCT      : return "type"
        case SYM_ENUM        : return "enum"
        case SYM_ENUMMEMBER  : return "enum member"
        case SYM_FUNCTION    : return "procedure"
        case SYM_METHOD      : return "method"
        case SYM_PROPERTY    : return "property"
        case SYM_CONSTRUCTOR : return "constructor"
        case SYM_OPERATOR    : return "operator"
        case SYM_FIELD       : return "field"
        case SYM_VARIABLE    : return "variable"
        case SYM_CONSTANT    : return "constant"
    end select
    return "symbol"
end function

'' ############################################################################
''  Hover text
''
''  Markdown rather than plain text, so an editor syntax-highlights the
''  declaration. It lives here, not in the handler, because it is a pure
''  function of a symbol -- which is what makes it testable without a server.
'' ############################################################################

function SymbolHoverMarkdown( byref sym as SymbolInfo ) as string
    '' The first line is the declaration as tiko, in a fenced block, so an
    '' editor syntax-highlights it.
    dim as string decl = sym.Name_
    if( len(sym.Detail_) > 0 ) then decl &= " " & sym.Detail_

    dim as string keyword_ = ""
    select case sym.Kind_
        case SYM_FUNCTION, SYM_METHOD : keyword_ = "declare "
        case SYM_CONSTRUCTOR          : keyword_ = "constructor "
        case SYM_PROPERTY             : keyword_ = "property "
        case SYM_OPERATOR             : keyword_ = "operator "
        case SYM_STRUCT               : keyword_ = "type "
        case SYM_CLASS                : keyword_ = "class "
        case SYM_INTERFACE            : keyword_ = "interface "
        case SYM_ENUM                 : keyword_ = "enum "
        case SYM_NAMESPACE            : keyword_ = "namespace "
        case SYM_CONSTANT             : keyword_ = "const "
        case SYM_FIELD, SYM_VARIABLE  : keyword_ = ""
        case SYM_ENUMMEMBER           : keyword_ = ""
    end select

    '' `declare Foo (...)` reads wrong; the kind is already in the second line.
    if( keyword_ = "declare " ) then keyword_ = ""

    dim as string out_ = "```tiko" & chr(10) & keyword_ & decl & chr(10) & "```"

    '' A short note about what kind of thing it is, which is what tells a
    '' reader that `Count` is a field rather than a method.
    out_ &= chr(10) & chr(10) & "*" & SymbolKindName( sym.Kind_ )
    if( sym.IsDeclaration ) then out_ &= ", declared"
    if( sym.IsLocal ) then out_ &= ", local"
    out_ &= "*"

    if( len(sym.Doc_) > 0 ) then out_ &= chr(10) & chr(10) & sym.Doc_

    return out_
end function

'' The size of the type a fixed-width name stands for.
private function BuiltinTypedefBytes( byref target as string ) as long
    select case target
        case "byte", "ubyte"       : return 1
        case "short", "ushort"     : return 2
        case "long", "ulong"       : return 4
        case "single"              : return 4
        case "longint", "ulongint" : return 8
        case "double"              : return 8
    end select
    return 0
end function

function BuiltinTypedefHoverMarkdown( byref text_ as string, byref tokens as TokenArray, _
                                      byval offset as long ) as string
    dim as long tokIdx = TokenIndexAt( tokens, offset )
    if( tokIdx < 0 ) then return ""

    dim as Token tok = tokens[tokIdx]
    if( tok.Kind <> TK_IDENT ) then return ""
    if( IsMemberAccess( text_, tokens, tokIdx ) ) then return ""

    dim as string word_ = TokenText( text_, tok )

    '' A string-slice type: a view of a string's code units.
    dim as string unit_ = BuiltinSliceUnit( word_ )
    if( len(unit_) > 0 ) then
        return "```tiko" & chr(10) & "type " & lcase(word_) & chr(10) & "```" & _
               chr(10) & chr(10) & "*built-in type: a string slice, a view of " & unit_ & " code units*"
    end if

    dim as string target = BuiltinTypedefTarget( word_ )
    if( len(target) = 0 ) then return ""

    return "```tiko" & chr(10) & "type " & lcase(word_) & " as " & target & chr(10) & "```" & _
           chr(10) & chr(10) & "*built-in type, " & BuiltinTypedefBytes( target ) & " bytes*"
end function

function BuiltinConstantHoverMarkdown( byref text_ as string, byref tokens as TokenArray, _
                                       byval offset as long ) as string
    dim as long tokIdx = TokenIndexAt( tokens, offset )
    if( tokIdx < 0 ) then return ""

    dim as Token tok = tokens[tokIdx]
    if( tok.Kind <> TK_IDENT ) then return ""
    if( IsMemberAccess( text_, tokens, tokIdx ) ) then return ""

    dim as string decl = BuiltinConstantDecl( TokenText( text_, tok ) )
    if( len(decl) = 0 ) then return ""

    return "```tiko" & chr(10) & decl & chr(10) & "```" & chr(10) & chr(10) & _
           "*built-in constant: the null pointer, which converts to every pointer type*"
end function
