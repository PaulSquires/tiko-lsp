'' ############################################################################
''  analysis/signature.tiko -- calls, and the parameters they are filling in
'' ############################################################################

#import "std/containers"
#include once "signature.ti"
#include once "../utils/position.ti"

'' ----------------------------------------------------------------------------
''  Splitting a recorded signature back into parameters
'' ----------------------------------------------------------------------------

'' The identifier inside one parameter label.
''
'' `byval count as long = 0` -> "count"; `bytes() as ubyte` -> "bytes";
'' `...` -> "", because a variadic ellipsis has no name to show.
private function ParamName( byref label as string ) as string
    dim as string s = trim( label )
    if( len(s) = 0 ) then return ""

    '' Leading modifiers. BYVAL and BYREF are the only two a parameter can
    '' carry before its name; CONST binds to the TYPE, after the AS.
    do
        dim as string firstWord
        dim as long sp = instr( s, " " )
        if( sp = 0 ) then firstWord = s else firstWord = left( s, sp - 1 )

        select case lcase( firstWord )
            case "byval", "byref"
                if( sp = 0 ) then return ""
                s = ltrim( mid( s, sp + 1 ) )
            case else
                exit do
        end select
    loop

    '' The name runs to the first thing that cannot be part of it.
    dim as string out_
    for i as long = 0 to len(s) - 1
        dim as ubyte c = s[i]
        dim as boolean ok_ = false
        if( (c >= 65 andalso c <= 90) orelse (c >= 97 andalso c <= 122) ) then ok_ = true
        if( c = 95 ) then ok_ = true                                  '' _
        if( c >= 48 andalso c <= 57 andalso len(out_) > 0 ) then ok_ = true
        if( ok_ = false ) then exit for
        out_ &= chr( c )
    next

    '' A type name is not a parameter name: `as long` on its own is what an
    '' unnamed parameter in a DECLARE looks like.
    if( lcase( out_ ) = "as" ) then return ""
    return out_
end function

function ParseSignature( byref name_ as string, byref detail as string, _
                         byref fullLabel as string, _
                         byref params as SigParamArray ) as boolean

    params.Clear( )
    fullLabel = name_ & detail

    dim as string d = detail

    '' PROCEDURE MODIFIERS BEFORE THE LIST -- `overload alias "fb_StrPadLeft" (`,
    '' `cdecl (`, `lib "user32" alias "MessageBoxW" (` -- are dropped, and the
    '' label is the name plus the list: most of fb/*.bi and the Win32 headers
    '' declare this way, and none of them had a signature. A detail that is a
    '' TYPE (`as function( ... )`) is not a procedure's and is not reread as one.
    if( left( d, 1 ) <> "(" ) then
        if( lcase( left( d, 3 ) ) = "as " ) then return false
        dim as long openAt = -1
        dim as boolean quoted = false
        for j as long = 0 to len(d) - 1
            if( d[j] = 34 ) then
                quoted = ( quoted = false )
            elseif( quoted = false andalso d[j] = asc("(") ) then
                openAt = j
                exit for
            end if
        next
        if( openAt < 0 ) then return false
        d = mid( d, openAt + 1 )
        fullLabel = name_ & d
    end if

    '' The parameter list ends at the parenthesis that matches the first one.
    '' Depth counting, and STRINGS ARE SKIPPED WHOLE: a default value may be
    '' `= ","` or `= ")"`, and splitting on the comma inside it would produce
    '' two parameters where the source has one.
    dim as long depth = 0
    dim as long closeAt = -1
    dim as long i = 0

    while( i < len(d) )
        dim as ubyte c = d[i]
        if( c = asc("""") ) then
            i += 1
            while( i < len(d) )
                if( d[i] = asc("""") ) then
                    '' "" inside a literal is an escaped quote, not the end.
                    if( i + 1 < len(d) andalso d[i + 1] = asc("""") ) then
                        i += 2
                        continue while
                    end if
                    exit while
                end if
                i += 1
            wend
        elseif( c = asc("(") ) then
            depth += 1
        elseif( c = asc(")") ) then
            depth -= 1
            if( depth = 0 ) then
                closeAt = i
                exit while
            end if
        end if
        i += 1
    wend

    '' An unbalanced list means the user is mid-edit. There is a signature, it
    '' just has no parameters that can be located, and saying so beats
    '' guessing where the list ended.
    if( closeAt < 0 ) then return true

    dim as long labelOffset = len(name_)   '' where `detail` starts in fullLabel

    '' -- split at the commas of the outer list --------------------------------
    dim as long segStart = 1
    depth = 0
    i = 1

    while( i <= closeAt )
        dim as ubyte c = d[i]
        dim as boolean isSplit = false

        if( c = asc("""") ) then
            i += 1
            while( i < len(d) )
                if( d[i] = asc("""") ) then
                    if( i + 1 < len(d) andalso d[i + 1] = asc("""") ) then
                        i += 2
                        continue while
                    end if
                    exit while
                end if
                i += 1
            wend
        elseif( c = asc("(") orelse c = asc("[") ) then
            depth += 1
        elseif( c = asc("]") ) then
            depth -= 1
        elseif( c = asc(")") ) then
            if( depth = 0 andalso i = closeAt ) then
                isSplit = true
            else
                depth -= 1
            end if
        elseif( c = asc(",") andalso depth = 0 ) then
            isSplit = true
        end if

        if( isSplit ) then
            dim as string raw_ = mid( d, segStart + 1, i - segStart )
            dim as string label = trim( raw_ )

            if( len(label) > 0 ) then
                '' Where the trimmed label really sits, so the highlight lands
                '' on the parameter and not on the space before it.
                dim as long lead = 0
                while( lead < len(raw_) andalso (raw_[lead] = 32 orelse raw_[lead] = 9) )
                    lead += 1
                wend

                dim as long byteStart = labelOffset + segStart + lead
                dim as long byteEnd   = byteStart + len(label)

                dim as SigParam p
                p.Label      = label
                p.Name_      = ParamName( label )
                p.LabelStart = Utf16UnitsInRange( fullLabel, 0, byteStart )
                p.LabelEnd   = p.LabelStart + Utf16UnitsInRange( fullLabel, byteStart, byteEnd )
                params.Push( p )
            end if

            segStart = i + 1
        end if

        i += 1
    wend

    return true
end function

'' ----------------------------------------------------------------------------
''  The call the caret is inside
'' ----------------------------------------------------------------------------

'' The last token that begins STRICTLY BEFORE `offset`, or -1.
''
'' Strictly, because a caret sits BETWEEN tokens and belongs to what is behind
'' it. At the end of a line the token starting at the caret is the end-of-line
'' itself, and including it would end the backward search before it started --
'' which is exactly where a user leaves the caret while typing a wrapped
'' argument list.
private function TokenBefore( byref tokens as TokenArray, byval offset as long ) as long
    dim as long best = -1
    for i as long = 0 to tokens.Count( ) - 1
        if( tokens[i].Start_ >= offset ) then exit for
        best = i
    next
    return best
end function

function FindCallContext( byref text_ as string, byref tokens as TokenArray, _
                          byval offset as long, byref ctx as CallContext ) as boolean

    ctx.Found     = false
    ctx.NameTok   = -1
    ctx.OpenTok   = -1
    ctx.ActiveArg = 0
    ctx.ArgTok    = -1

    dim as long from_ = TokenBefore( tokens, offset )
    if( from_ < 0 ) then return false

    '' -- back to the innermost '(' that is still open -------------------------
    dim as long depth = 0
    dim as long openTok = -1

    for i as long = from_ to 0 step -1
        dim as Token t = tokens[i]

        select case t.Kind
            case TK_EOL, TK_EOF
                exit for
            case TK_COMMENT
                '' A comment inside a wrapped argument list is legal and says
                '' nothing about nesting.
            case TK_RPAREN, TK_RBRACKET
                depth += 1
            case TK_LBRACKET
                if( depth = 0 ) then exit for
                depth -= 1
            case TK_LPAREN
                if( depth = 0 ) then
                    openTok = i
                    exit for
                end if
                depth -= 1
        end select
    next

    if( openTok < 0 ) then return false

    '' -- what is being called -------------------------------------------------
    dim as long nameTok = -1
    for i as long = openTok - 1 to 0 step -1
        if( tokens[i].Kind = TK_COMMENT ) then continue for
        if( tokens[i].Kind = TK_IDENT ) then nameTok = i
        '' After a dot a member may be spelled like a keyword: LogEvent.Str(.
        if( tokens[i].Kind = TK_KEYWORD andalso IsMemberAccess( text_, tokens, i ) ) then nameTok = i
        exit for
    next

    if( nameTok < 0 ) then return false

    '' -- which argument the caret is in ---------------------------------------
    ''
    '' Forward this time, from the opener, because that is where the argument
    '' boundaries are: the commas at the call's own depth.
    dim as long arg = 0
    dim as long argTok = -1
    depth = 0

    for i as long = openTok + 1 to from_
        dim as Token t = tokens[i]

        select case t.Kind
            case TK_COMMENT, TK_EOL
                '' not part of an argument
            case TK_LPAREN, TK_LBRACKET
                if( argTok < 0 ) then argTok = i
                depth += 1
            case TK_RPAREN, TK_RBRACKET
                depth -= 1
            case TK_COMMA
                if( depth = 0 ) then
                    arg   += 1
                    argTok = -1
                end if
            case else
                if( depth = 0 andalso argTok < 0 ) then argTok = i
        end select
    next

    ctx.Found     = true
    ctx.NameTok   = nameTok
    ctx.OpenTok   = openTok
    ctx.ActiveArg = arg
    ctx.ArgTok    = argTok
    return true
end function

'' ----------------------------------------------------------------------------
''  Every argument of every call in a range
'' ----------------------------------------------------------------------------
sub FindArgSites( byref text_ as string, byref tokens as TokenArray, _
                  byval startOffset as long, byval endOffset as long, _
                  byref sites as ArgSiteArray )

    sites.Clear( )

    for i as long = 0 to tokens.Count( ) - 2
        dim as Token t = tokens[i]
        if( t.Kind <> TK_IDENT ) then continue for
        if( t.Start_ < startOffset orelse t.Start_ >= endOffset ) then continue for

        '' An identifier followed IMMEDIATELY by '(' -- with nothing between,
        '' not even a comment, which is what tells a call from `x and (y)`.
        if( tokens[i + 1].Kind <> TK_LPAREN ) then continue for
        if( tokens[i + 1].Start_ <> t.Start_ + t.Length_ ) then continue for

        dim as long arg    = 0
        dim as long argTok = -1
        dim as long depth  = 0

        for j as long = i + 2 to tokens.Count( ) - 1
            dim as Token u = tokens[j]

            select case u.Kind
                case TK_EOF
                    exit for
                case TK_COMMENT, TK_EOL
                    '' skipped
                case TK_LPAREN, TK_LBRACKET
                    if( depth = 0 andalso argTok < 0 ) then argTok = j
                    depth += 1
                case TK_RBRACKET
                    depth -= 1
                case TK_RPAREN
                    if( depth = 0 ) then
                        if( argTok >= 0 ) then
                            dim as ArgSite s
                            s.NameTok  = i
                            s.ArgIndex = arg
                            s.ArgTok   = argTok
                            sites.Push( s )
                        end if
                        exit for
                    end if
                    depth -= 1
                case TK_COMMA
                    if( depth = 0 ) then
                        if( argTok >= 0 ) then
                            dim as ArgSite s
                            s.NameTok  = i
                            s.ArgIndex = arg
                            s.ArgTok   = argTok
                            sites.Push( s )
                        end if
                        arg   += 1
                        argTok = -1
                    end if
                case else
                    if( depth = 0 andalso argTok < 0 ) then argTok = j
            end select
        next
    next
end sub

'' ----------------------------------------------------------------------------
''  Which declaration is being called
'' ----------------------------------------------------------------------------
function IsCallableKind( byval kind as SymbolKind ) as boolean
    select case kind
        case SYM_FUNCTION, SYM_METHOD, SYM_CONSTRUCTOR, SYM_OPERATOR, SYM_PROPERTY
            return true
    end select
    return false
end function

function FindCallable( byref symbols as SymbolTable, byref lowerName as string, _
                       byval fromOffset as long, byref alternatives as long ) as long

    alternatives = 0

    dim as long best      = -1
    dim as long bestScore = -1
    dim as long bodies    = 0
    dim as long protos    = 0

    for i as long = 0 to symbols.Count( ) - 1
        if( symbols.Items[i].LowerName <> lowerName ) then continue for
        if( IsCallableKind( symbols.Items[i].Kind_ ) = false ) then continue for

        if( symbols.Items[i].IsDeclaration ) then protos += 1 else bodies += 1

        '' A body outranks a prototype: same signature, but it is the one the
        '' user means and the one that is definitely compiled.
        dim as long score = iif( symbols.Items[i].IsDeclaration, 1, 2 )
        if( score > bestScore ) then
            bestScore = score
            best      = i
        end if
    next

    '' The overload count, not the declaration count: a DECLARE and its body
    '' are one procedure written twice, and reporting "1 of 2" for that would
    '' be a lie the user cannot act on.
    alternatives = iif( bodies > 0, bodies, protos )
    return best
end function
