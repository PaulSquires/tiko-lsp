'' ############################################################################
''  handlers/definition.tiko -- textDocument/definition
''
''  Resolution is shared with hover, deliberately: an editor that shows one
''  thing in a tooltip and jumps somewhere else is worse than one that does
''  neither.
''
''  THIS FILE FIRST, then the workspace. A name the open document declares
''  wins, because a local definition is what the user means; only when the file
''  has never heard of it does the index get asked, which is what makes a jump
''  into an #included header work.
'' ############################################################################

#import "std/containers"
#include once "definition.ti"
#include once "workspace_symbols.ti"
#include once "../analysis/includes.ti"
#include once "hover.ti"
#include once "../lsp/publish.ti"
#include once "../utils/logging.ti"
#include once "../utils/uri.ti"

private function OnDefinition( byref srv as Server, _
                               byref req as RpcMessage, _
                               byref rb as JsonBuilder, _
                               byref err_ as RpcError ) as JsonNode

    dim as string uriText = req.Params( ).Member( "textDocument" ).Member( "uri" ).AsString( "" )
    dim as TextDocumentPtr doc = srv.Documents.Find( uriText )
    if( doc = 0 ) then return rb.NewNull( )

    dim as JsonValue posVal = req.Params( ).Member( "position" )
    dim as long lineNo   = clng( posVal.Member( "line"      ).AsLongInt( 0 ) )
    dim as long charNo   = clng( posVal.Member( "character" ).AsLongInt( 0 ) )
    dim as long offset   = clng( doc->PositionToOffset( lineNo, charNo ) )

    '' -- an #include line is a definition too ---------------------------------
    ''
    '' Ctrl-clicking `#include once "shared.bi"` should open shared.bi. Nothing
    '' else in LSP expresses "go to this file", and every editor already binds
    '' the gesture to this request.
    ''
    '' The CHEAP HALF of the question is asked first, from this document's own
    '' tokens: is the caret on an include path at all? Only then is the index
    '' needed -- otherwise every go-to-definition in an open file would start
    '' by waiting for a workspace scan it does not need.
    dim includeRefs as IncludeRefArray
    FindIncludes( doc->Text( ), doc->Tokens( ), includeRefs )
    '' ...or on a `#cinclude` header, whose edge goes to the BINDING tiko made of it
    '' (workspace/cincludes.ti): the C file itself is never indexed.
    dim cincludeRefs as IncludeRefArray
    FindCIncludes( doc->Text( ), doc->Tokens( ), cincludeRefs )

    if( IncludeAtOffset( includeRefs, offset ) >= 0 orelse _
        IncludeAtOffset( cincludeRefs, offset ) >= 0 ) then
        EnsureWorkspaceIndex( srv )
        dim as long here = srv.Index->IndexOfUri( uriText )

        for i as long = 0 to srv.Index->IncludeCount( here ) - 1
            dim as IncludeEdge e = srv.Index->IncludeAt( here, i )
            if( e.Line <> lineNo ) then continue for
            if( charNo < e.StartChar orelse charNo > e.EndChar ) then continue for

            '' A path this server could not place -- a compiler header, or a
            '' file no workspace folder covers. There is nothing to open, and
            '' saying so beats opening the wrong thing.
            if( e.ToFile < 0 ) then
                LogDebug( "include '" & e.Target & "' is not a file in the workspace" )
                return rb.NewNull( )
            end if

            dim as JsonNode start_ = rb.NewObject( )
            rb.SetInt( start_, "line", 0 )
            rb.SetInt( start_, "character", 0 )

            dim as JsonNode range_ = rb.NewObject( )
            rb.SetNode( range_, "start", start_ )
            rb.SetNode( range_, "end", start_ )

            dim as JsonNode locNode = rb.NewObject( )
            rb.SetStr ( locNode, "uri", srv.Index->FileUri( e.ToFile ) )
            rb.SetNode( locNode, "range", range_ )

            LogDebug( "include '" & e.Target & "' -> " & UriFileName( srv.Index->FileUri( e.ToFile ) ) )
            return locNode
        next
    end if

    '' -- and so is an #import line, and a name reached through its alias ------------
    ''
    '' tiko-lang's modules (ADR 0017): `#import "acme/net/http"` opens the module's first
    '' file, and `http.Fetch` goes to Fetch in the module's files -- whatever its visibility,
    '' since going to a definition is not naming it.
    dim importRefs as ImportRefArray
    FindImports( doc->Text( ), doc->Tokens( ), importRefs )
    if( importRefs.Count( ) > 0 ) then
        dim as long onPath = -1
        for i as long = 0 to importRefs.Count( ) - 1
            if( offset >= importRefs[i].Start_ andalso offset <= importRefs[i].Start_ + importRefs[i].Length_ ) then onPath = i
        next

        dim as string lowerName = "", alias_ = ""
        if( onPath < 0 ) then
            dim as long ti = TokenIndexAt( doc->Tokens( ), offset )
            if( ti >= 2 ) then
                dim as Token nameTok = doc->Tokens( )[ti]
                dim as Token dotTok  = doc->Tokens( )[ti - 1]
                dim as Token baseTok = doc->Tokens( )[ti - 2]
                dim as boolean shaped = (nameTok.Kind = TK_IDENT) andalso (dotTok.Kind = TK_OP) andalso _
                                        (baseTok.Kind = TK_IDENT)
                if( shaped ) then shaped = ( TokenText( doc->Text( ), dotTok ) = "." )
                if( shaped ) then
                    dim as string b = lcase( TokenText( doc->Text( ), baseTok ) )
                    for i as long = 0 to importRefs.Count( ) - 1
                        if( importRefs[i].Alias_ = b ) then
                            alias_ = b
                            lowerName = lcase( TokenText( doc->Text( ), nameTok ) )
                        end if
                    next
                end if
            end if
        end if

        if( onPath >= 0 orelse len(alias_) > 0 ) then
            EnsureWorkspaceIndex( srv )
            dim as long here = srv.Index->IndexOfUri( uriText )
            dim files_ as containers.Array( of long )
            dim as string wantAlias = iif( onPath >= 0, importRefs[iif( onPath >= 0, onPath, 0 )].Alias_, alias_ )
            if( srv.Index->ModuleFilesOf( here, wantAlias, files_ ) = false orelse files_.Count( ) = 0 ) then
                LogDebug( "import '" & wantAlias & "' is not a module in the workspace" )
                return rb.NewNull( )
            end if

            dim as long hitFile = files_[0], hitSym = -1
            dim as long expLine = -1, expStart = 0, expEnd = 0
            if( len(lowerName) > 0 ) then
                hitFile = -1
                for each f as long in files_
                    for s as long = 0 to srv.Index->FileSymbolCount( f ) - 1
                        dim as SymbolInfo sym = srv.Index->SymbolAt( f, s )
                        if( sym.Parent <> -1 orelse sym.LowerName <> lowerName ) then continue for
                        hitFile = f
                        hitSym = s
                        exit for
                    next
                    if( hitFile >= 0 ) then exit for
                next
                '' An EXPORTED MACRO, which is no symbol: what it names when that is found --
                '' a std facade's `FB.PathJoin`, in the header -- else its `#define`.
                if( hitFile < 0 ) then
                    dim as IndexHit t
                    dim as ExportHit x
                    if( srv.Index->ModuleMemberAt( here, wantAlias, lowerName, t, x ) = 2 ) then
                        if( t.FileIndex >= 0 ) then
                            hitFile = t.FileIndex
                            hitSym = t.SymIndex
                        else
                            dim as ExportEdge e = srv.Index->ExportAt( x.FileIndex, x.ExportIndex )
                            hitFile = x.FileIndex
                            expLine = e.Line
                            expStart = e.StartChar
                            expEnd = e.EndChar
                        end if
                    end if
                end if
                if( hitFile < 0 ) then return rb.NewNull( )
            end if

            dim as JsonNode start_ = rb.NewObject( )
            dim as JsonNode end_ = rb.NewObject( )
            if( expLine >= 0 ) then
                rb.SetInt( start_, "line", expLine )
                rb.SetInt( start_, "character", expStart )
                rb.SetInt( end_, "line", expLine )
                rb.SetInt( end_, "character", expEnd )
            elseif( hitSym >= 0 ) then
                dim as IndexedRange r = srv.Index->RangeAt( hitFile, hitSym )
                rb.SetInt( start_, "line", r.StartLine )
                rb.SetInt( start_, "character", r.StartChar )
                rb.SetInt( end_, "line", r.EndLine )
                rb.SetInt( end_, "character", r.EndChar )
            else
                rb.SetInt( start_, "line", 0 )
                rb.SetInt( start_, "character", 0 )
                rb.SetInt( end_, "line", 0 )
                rb.SetInt( end_, "character", 0 )
            end if
            dim as JsonNode range_ = rb.NewObject( )
            rb.SetNode( range_, "start", start_ )
            rb.SetNode( range_, "end", end_ )
            dim as JsonNode locNode = rb.NewObject( )
            rb.SetStr ( locNode, "uri", srv.Index->FileUri( hitFile ) )
            rb.SetNode( locNode, "range", range_ )
            LogDebug( "definition (module " & wantAlias & "): " & lowerName & " in " & _
                      UriFileName( srv.Index->FileUri( hitFile ) ) )
            return locNode
        end if
    end if

    dim as long wordStart, wordEnd
    dim as long symIndex = ResolveAtOffset( doc, offset, wordStart, wordEnd )

    '' -- not in this file: ask the workspace ----------------------------------
    if( symIndex < 0 ) then
        dim as long tokIdx = TokenIndexAt( doc->Tokens( ), offset )
        if( tokIdx < 0 ) then return rb.NewNull( )
        if( doc->Tokens( )[tokIdx].Kind <> TK_IDENT ) then return rb.NewNull( )

        dim as string lowerName = lcase( TokenText( doc->Text( ), doc->Tokens( )[tokIdx] ) )

        '' ONLY HERE. A definition the open file can answer -- which is most of
        '' them, and all of them while a user is writing a procedure -- was
        '' answered above without waiting for anything. This is the fallback,
        '' and it is the only path in this handler that needs the workspace.
        EnsureWorkspaceIndex( srv )

        '' ASKED FROM SOMEWHERE. The include graph decides which of several
        '' declarations of one name this file can actually see; without it the
        '' answer was "whichever the index liked best", which is right whenever
        '' a name is unique and a coin toss when it is not.
        dim as IndexHit hit
        if( srv.Index->FindDefinitionFrom( srv.Index->IndexOfUri( uriText ), lowerName, hit ) = false ) then
            return rb.NewNull( )
        end if

        '' The index stores its ranges already converted, so nothing has to be
        '' read from disk to answer this.
        dim as IndexedRange r = srv.Index->RangeAt( hit.FileIndex, hit.SymIndex )

        dim as JsonNode start_ = rb.NewObject( )
        rb.SetInt( start_, "line", r.StartLine )
        rb.SetInt( start_, "character", r.StartChar )

        dim as JsonNode end_ = rb.NewObject( )
        rb.SetInt( end_, "line", r.EndLine )
        rb.SetInt( end_, "character", r.EndChar )

        dim as JsonNode range_ = rb.NewObject( )
        rb.SetNode( range_, "start", start_ )
        rb.SetNode( range_, "end", end_ )

        dim as JsonNode remote = rb.NewObject( )
        rb.SetStr ( remote, "uri", srv.Index->FileUri( hit.FileIndex ) )
        rb.SetNode( remote, "range", range_ )

        LogDebug( "definition (workspace): " & lowerName & " in " & _
                  UriFileName( srv.Index->FileUri( hit.FileIndex ) ) )
        return remote
    end if

    dim as SymbolInfo sym = doc->Symbols( ).Items[symIndex]

    '' A Location, not a LocationLink: the simple form every client supports,
    '' and the range is the NAME, so the editor puts the caret on it rather
    '' than selecting the whole procedure.
    dim as JsonNode location_ = rb.NewObject( )
    rb.SetStr( location_, "uri", doc->Uri( ) )
    rb.SetNode( location_, "range", _
                BuildLspRange( rb, doc->Text( ), doc->Index( ), sym.NameStart, sym.NameEnd ) )

    LogDebug( "definition: " & sym.Name_ & " at byte " & sym.NameStart )
    return location_
end function

sub RegisterDefinitionHandlers( )
    RegisterHandler( LSP_DEFINITION, @OnDefinition )
end sub
