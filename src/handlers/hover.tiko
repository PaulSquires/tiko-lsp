'' ############################################################################
''  handlers/hover.tiko -- textDocument/hover
'' ############################################################################

#import "std/containers"
#include once "hover.ti"
#include once "workspace_symbols.ti"
#include once "completion.ti"
#include once "../analysis/completion.ti"
#include once "../analysis/includes.ti"
#include once "../analysis/intrinsics.ti"
#include once "../workspace/index_builder.ti"
#include once "../lsp/publish.ti"
#include once "../utils/logging.ti"

function ResolveAtOffset( byval doc as TextDocumentPtr, byval offset as long, _
                          byref wordRangeStart as long, byref wordRangeEnd as long ) as long
    wordRangeStart = offset
    wordRangeEnd   = offset
    if( doc = 0 ) then return -1

    dim as string body = doc->Text( )
    dim as long tokIdx = TokenIndexAt( doc->Tokens( ), offset )
    if( tokIdx < 0 ) then return -1

    dim as Token tok = doc->Tokens( )[tokIdx]

    '' Only a name resolves. Hovering a keyword, a number or a string is a
    '' legitimate thing for a user to do and the honest answer is nothing.
    if( tok.Kind <> TK_IDENT ) then return -1

    wordRangeStart = tok.Start_
    wordRangeEnd   = tok.Start_ + tok.Length_

    dim as string word_ = lcase( TokenText( body, tok ) )

    '' `customer.Name` is a different question from `Name`: the first is a
    '' member of something, the second is whatever is in scope here.
    if( IsMemberAccess( body, doc->Tokens( ), tokIdx ) ) then
        return doc->Symbols( ).ResolveMember( word_ )
    end if

    return doc->Symbols( ).Resolve( word_, offset )
end function

'' A NAME THIS FILE DOES NOT DECLARE: a sub in another workspace file, or a
'' toolchain header's -- MessageBoxW from windows.bi. Answered from the index
'' through the files this one can see first (FindDefinitionFrom), the lookup
'' go-to-definition makes. "" when the caret is on no name, on a member
'' (`obj.Method` needs the type before the dot), or on a name nothing declares.
'' Never waits for the index: hover is asked for as the mouse moves.
'' A MEMBER: `lg.MinLevel` where `dim shared as Logger lg`. The base's declared
'' type is read from its declaration in this file, followed through aliases to the
'' type that has the members -- searching includes AND #imports, the lookup member
'' completion makes -- and the member is that type's child of that name. A base
'' this file does not declare is taken as a type or namespace named directly
'' (`FB.Something`).
''
'' A CHAIN LINK -- `Str` in `lg.Warn( ).Str( k, v )` -- is the member of the type
'' the chain has reached (ResolveChainMember, member completion's walk). Of an
'' overload set, a link the chain continues past is the one with a type: `Warn`
'' in `lg.Warn( ).Str(` is `function Warn( ) as LogEvent`, not `sub Warn( m )`.
private function ContinuesChain_( byval doc as TextDocumentPtr, byval ti as long ) as boolean
    dim as long j = ti + 1
    dim as long n = doc->Tokens( ).Count( )
    if( j < n andalso doc->Tokens( )[j].Kind = TK_LPAREN ) then
        dim as long depth = 0
        while( j < n )
            dim as TokenKind k = doc->Tokens( )[j].Kind
            if( k = TK_EOL orelse k = TK_EOF ) then return false
            if( k = TK_LPAREN ) then depth += 1
            if( k = TK_RPAREN ) then
                depth -= 1
                if( depth = 0 ) then exit while
            end if
            j += 1
        wend
        j += 1
    end if
    if( j >= n ) then return false
    dim as Token t = doc->Tokens( )[j]
    if( t.Kind <> TK_OP ) then return false
    dim as string op = TokenText( doc->Text( ), t )
    return op = "." orelse op = "->"
end function

private function MemberHover_( byref srv as Server, byval doc as TextDocumentPtr, _
                               byval ti as long ) as string
    if( ti < 2 ) then return ""

    dim as SymbolInfo link_
    dim as long overloads
    if( ResolveChainMember( srv, doc, ti - 1, lcase( TokenText( doc->Text( ), doc->Tokens( )[ti] ) ), _
                            ContinuesChain_( doc, ti ), link_, overloads ) ) then
        return SymbolHoverMarkdown( link_ )
    end if

    dim as Token baseTok = doc->Tokens( )[ti - 2]
    if( baseTok.Kind <> TK_IDENT ) then return ""

    dim as long here = srv.Index->IndexOfUri( doc->Uri( ) )
    if( here < 0 ) then return ""

    dim as string member_  = lcase( TokenText( doc->Text( ), doc->Tokens( )[ti] ) )
    dim as string baseName = lcase( TokenText( doc->Text( ), baseTok ) )
    dim as string typeName = baseName
    dim as long b = doc->Symbols( ).Resolve( baseName, baseTok.Start_ )
    if( b >= 0 ) then
        typeName = DeclaredTypeName( doc->Symbols( ).Items[b] )
        if( len(typeName) = 0 ) then return ""
    end if

    dim visible as containers.Array( of long )
    VisibleWithImports( srv, here, visible )
    dim as string want = FinalTypeName( srv, visible, typeName )

    for v as long = 0 to visible.Count( ) - 1
        dim as long f = visible[v]
        for t as long = 0 to srv.Index->FileSymbolCount( f ) - 1
            dim as SymbolInfo owner = srv.Index->SymbolAt( f, t )
            if( owner.LowerName <> want ) then continue for
            select case owner.Kind_
                case SYM_STRUCT, SYM_CLASS, SYM_ENUM, SYM_NAMESPACE, SYM_INTERFACE
                case else
                    continue for
            end select
            if( lcase( left( owner.Detail_, 3 ) ) = "as " ) then continue for

            for i as long = 0 to srv.Index->FileSymbolCount( f ) - 1
                dim as SymbolInfo m = srv.Index->SymbolAt( f, i )
                if( m.Parent = t andalso m.LowerName = member_ ) then return SymbolHoverMarkdown( m )
            next
        next
    next
    return ""
end function

private function IndexHover_( byref srv as Server, byval doc as TextDocumentPtr, _
                              byval offset as long ) as string
    dim as long ti = TokenIndexAt( doc->Tokens( ), offset )
    if( ti < 0 ) then return ""
    if( doc->Tokens( )[ti].Kind <> TK_IDENT ) then return ""
    if( IsMemberAccess( doc->Text( ), doc->Tokens( ), ti ) ) then return MemberHover_( srv, doc, ti )

    dim as string lowerName = lcase( TokenText( doc->Text( ), doc->Tokens( )[ti] ) )
    dim as IndexHit hit
    if( srv.Index->FindDefinitionFrom( srv.Index->IndexOfUri( doc->Uri( ) ), lowerName, hit ) = false ) then
        return ""
    end if
    return SymbolHoverMarkdown( srv.Index->SymbolAt( hit.FileIndex, hit.SymIndex ) )
end function

'' `alias.name` WHERE alias IS ONE OF THE DOCUMENT'S IMPORTS (tiko-lang ADR 0017): the
'' module's public declaration, or the macro it `#export`s -- shown as its `#define` and,
'' when that names a declaration (a std facade's `FB.PathJoin`), as that declaration too.
'' "" when the caret is on no such name.
private function ModuleMemberHover_( byref srv as Server, byval doc as TextDocumentPtr, _
                                     byval offset as long, byref wordStart as long, _
                                     byref wordEnd as long ) as string
    dim as long ti = TokenIndexAt( doc->Tokens( ), offset )
    if( ti < 2 ) then return ""
    dim as Token nameTok = doc->Tokens( )[ti]
    dim as Token dotTok  = doc->Tokens( )[ti - 1]
    dim as Token baseTok = doc->Tokens( )[ti - 2]
    if( nameTok.Kind <> TK_IDENT orelse dotTok.Kind <> TK_OP orelse baseTok.Kind <> TK_IDENT ) then return ""
    if( TokenText( doc->Text( ), dotTok ) <> "." ) then return ""
    dim as string alias_ = lcase( TokenText( doc->Text( ), baseTok ) )
    dim refs as ImportRefArray
    FindImports( doc->Text( ), doc->Tokens( ), refs )
    dim as boolean isAlias = false
    for i as long = 0 to refs.Count( ) - 1
        if( refs[i].Alias_ = alias_ ) then isAlias = true
    next
    if( isAlias = false ) then return ""

    EnsureWorkspaceIndex( srv )
    dim as long here = srv.Index->IndexOfUri( doc->Uri( ) )
    if( here < 0 ) then return ""
    dim as IndexHit sym
    dim as ExportHit exp_
    dim as long got = srv.Index->ModuleMemberAt( here, alias_, lcase( TokenText( doc->Text( ), nameTok ) ), sym, exp_ )
    if( got = 0 ) then return ""
    wordStart = nameTok.Start_
    wordEnd   = nameTok.Start_ + nameTok.Length_
    if( got = 1 ) then return SymbolHoverMarkdown( srv.Index->SymbolAt( sym.FileIndex, sym.SymIndex ) )
    dim as ExportEdge e = srv.Index->ExportAt( exp_.FileIndex, exp_.ExportIndex )
    dim as string md = "```tiko" & chr( 10 ) & "#define " & e.Name_
    if( len(e.Body) > 0 ) then md &= " " & e.Body
    md &= chr( 10 ) & "```" & chr( 10 ) & "*exported macro of `" & alias_ & "`*"
    if( sym.FileIndex >= 0 ) then
        md &= chr( 10 ) & chr( 10 ) & "---" & chr( 10 ) & chr( 10 ) & _
              SymbolHoverMarkdown( srv.Index->SymbolAt( sym.FileIndex, sym.SymIndex ) )
    end if
    return md
end function

private function OnHover( byref srv as Server, _
                          byref req as RpcMessage, _
                          byref rb as JsonBuilder, _
                          byref err_ as RpcError ) as JsonNode

    dim as string uriText = req.Params( ).Member( "textDocument" ).Member( "uri" ).AsString( "" )
    dim as TextDocumentPtr doc = srv.Documents.Find( uriText )
    if( doc = 0 ) then return rb.NewNull( )

    dim as JsonValue posVal = req.Params( ).Member( "position" )
    dim as long lineNo   = clng( posVal.Member( "line"      ).AsLongInt( 0 ) )
    dim as long charNo   = clng( posVal.Member( "character" ).AsLongInt( 0 ) )
    dim as long offset   = clng( doc->PositionToOffset( lineNo, charNo ) )

    dim as long wordStart, wordEnd
    dim as string markdown = ModuleMemberHover_( srv, doc, offset, wordStart, wordEnd )

    '' A MEMBER is answered by its type before by its name: ResolveAtOffset's
    '' member lookup takes ANY member of that name in this file, which in
    '' `lg.Warn( ).Str(` is whichever `Str` the file happens to declare. Only
    '' when the index is there -- hover never waits for a scan.
    if( len(markdown) = 0 andalso ( IndexBuildPending( ) = false orelse IndexBuildReady( ) ) ) then
        dim as long ti = TokenIndexAt( doc->Tokens( ), offset )
        if( ti >= 0 ) then
            dim as Token tok = doc->Tokens( )[ti]
            '' A member may be spelled like a keyword: `.Str` of LogEvent.
            dim as boolean named = ( tok.Kind = TK_IDENT orelse tok.Kind = TK_KEYWORD )
            if( named andalso IsMemberAccess( doc->Text( ), doc->Tokens( ), ti ) ) then
                EnsureWorkspaceIndex( srv )
                markdown = MemberHover_( srv, doc, ti )
                if( len(markdown) > 0 ) then
                    wordStart = tok.Start_
                    wordEnd   = tok.Start_ + tok.Length_
                end if
            end if
        end if
    end if

    dim as long symIndex = -1
    if( len(markdown) = 0 ) then symIndex = ResolveAtOffset( doc, offset, wordStart, wordEnd )

    if( len(markdown) > 0 ) then
        '' A module's member, answered above.
    elseif( symIndex >= 0 ) then
        markdown = SymbolHoverMarkdown( doc->Symbols( ).Items[symIndex] )
    else
        markdown = IndexHover_( srv, doc, offset )
        if( len(markdown) = 0 ) then
            markdown = BuiltinTypedefHoverMarkdown( doc->Text( ), doc->Tokens( ), offset )
        end if
        if( len(markdown) = 0 ) then
            markdown = BuiltinConstantHoverMarkdown( doc->Text( ), doc->Tokens( ), offset )
        end if
        '' A built-in procedure -- left, mid, instr -- by its codetip. Last, so a
        '' declaration of the same name anywhere the file can see answers instead.
        if( len(markdown) = 0 ) then
            dim as long ti = TokenIndexAt( doc->Tokens( ), offset )
            if( ti >= 0 ) then
                dim as Token tok = doc->Tokens( )[ti]
                if( ( tok.Kind = TK_IDENT orelse tok.Kind = TK_KEYWORD ) andalso _
                    IsMemberAccess( doc->Text( ), doc->Tokens( ), ti ) = false ) then
                    dim as string tip = IntrinsicCodetip( TokenText( doc->Text( ), tok ) )
                    if( len(tip) > 0 ) then
                        markdown = "```tiko" & chr(10) & tip & chr(10) & "```" & chr(10) & _
                                   "Built-in. Square brackets mark optional arguments."
                        wordStart = tok.Start_
                        wordEnd   = tok.Start_ + tok.Length_
                    end if
                end if
            end if
        end if
    end if

    '' A null result is the correct answer for "nothing to say here", and is
    '' what stops an editor from showing an empty tooltip.
    if( len(markdown) = 0 ) then return rb.NewNull( )

    dim as JsonNode contents = rb.NewObject( )
    rb.SetStr( contents, "kind",  "markdown" )
    rb.SetStr( contents, "value", markdown )

    dim as JsonNode result_ = rb.NewObject( )
    rb.SetNode( result_, "contents", contents )
    rb.SetNode( result_, "range", _
                BuildLspRange( rb, doc->Text( ), doc->Index( ), wordStart, wordEnd ) )

    return result_
end function

sub RegisterHoverHandlers( )
    RegisterHandler( LSP_HOVER, @OnHover )
end sub
