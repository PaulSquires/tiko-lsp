'' ############################################################################
''  handlers/lifecycle.ti -- initialize / initialized / shutdown / exit
''
''  One file rather than the four the directory sketch implies: the four
''  methods are a single state machine and splitting them would put three
''  lines in each of three files.
'' ############################################################################

#pragma once

#include once "../lsp/dispatcher.ti"

'' Registers every lifecycle method with the dispatcher. Call once, from main,
'' before the message loop starts.
declare sub RegisterLifecycleHandlers( )
