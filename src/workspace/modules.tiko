'' ############################################################################
''  workspace/modules.tiko -- where a tiko `#import` leads. See modules.bi.
'' ############################################################################

#import "std/containers"
#import "std/fs"
#include once "modules.ti"
#include once "metadata.ti"

private function DirPart( byref path_ as string ) as string
    for i as long = len(path_) - 1 to 0 step -1
        if( path_[i] = asc( "\" ) orelse path_[i] = asc( "/" ) ) then
            return left( path_, i )
        end if
    next
    return ""
end function

'' `base` joined with a '/'-separated `rel`, native and absolute.
private function JoinNative( byref base_ as string, byref rel as string ) as string
    if( len(rel) = 0 ) then return NormalizePath( base_ )
    dim as string t = rel
#ifdef __FB_WIN32__
    for i as long = 0 to len(t) - 1
        if( t[i] = asc( "/" ) ) then t[i] = asc( "\" )
    next
    return NormalizePath( base_ & "\" & t )
#else
    return NormalizePath( base_ & "/" & t )
#endif
end function

'' THE MANIFEST, as much of it as resolution reads: [package] name, and the path of each
'' [dependencies] entry. The TOML subset tiko-lang accepts (its RFC-0007 section 2) is read
'' line by line; anything this does not understand is passed over -- the compiler says
'' what is wrong with a manifest, and this only has to find modules.
private sub ReadManifest( byref dir_ as string, byref name_ as string, _
                          byref depNames as PathArray, byref depPaths as PathArray )
    name_ = ""
    dim as string text_
    if( ReadSourceFile( dir_ & "\tiko.toml", text_ ) = false ) then
        if( ReadSourceFile( dir_ & "/tiko.toml", text_ ) = false ) then exit sub
    end if

    dim as string table_ = ""
    dim as long p = 1
    while( p <= len(text_) )
        dim as long e = instr( p, text_, chr(10) )
        if( e = 0 ) then e = len(text_) + 1
        dim as string ln = trim( mid( text_, p, e - p ), any chr(13) & chr(9) & " " )
        p = e + 1
        if( len(ln) = 0 orelse left( ln, 1 ) = "#" ) then continue while

        if( left( ln, 1 ) = "[" ) then
            table_ = lcase( trim( mid( ln, 2, instr( ln, "]" ) - 2 ) ) )
            continue while
        end if

        dim as long eq = instr( ln, "=" )
        if( eq = 0 ) then continue while
        dim as string k = lcase( trim( left( ln, eq - 1 ), any chr(34) & "' " ) )
        dim as string v = trim( mid( ln, eq + 1 ) )

        '' The first quoted string in v: a value, or an inline table's `path`.
        dim as string s = ""
        dim as long q1 = instr( v, chr(34) )
        dim as long qa = instr( v, "'" )
        dim as string qc = chr(34)
        if( q1 = 0 orelse (qa > 0 andalso qa < q1) ) then
            q1 = qa
            qc = "'"
        end if
        if( q1 > 0 ) then
            dim as long q2 = instr( q1 + 1, v, qc )
            if( q2 > q1 ) then s = mid( v, q1 + 1, q2 - q1 - 1 )
        end if

        if( table_ = "package" andalso k = "name" ) then
            name_ = lcase( s )
        elseif( table_ = "dependencies" andalso instr( v, "path" ) > 0 andalso len(s) > 0 ) then
            depNames.Push( k )
            depPaths.Push( JoinNative( dir_, s ) )
        elseif( left( table_, 13 ) = "dependencies." andalso k = "path" andalso len(s) > 0 ) then
            dim as string dn = mid( table_, 14 )
            if( instr( dn, "." ) = 0 ) then
                depNames.Push( dn )
                depPaths.Push( JoinNative( dir_, s ) )
            end if
        end if
    wend
end sub

function ManifestDirAbove( byref dir_ as string ) as string
    dim as string d = dir_
    for guard as long = 0 to 64
        if( len(d) = 0 ) then exit for
        if( fs.IsFile( d & "\tiko.toml" ) orelse fs.IsFile( d & "/tiko.toml" ) ) then return d
        dim as string up_ = DirPart( d )
        if( len(up_) = 0 orelse up_ = d ) then exit for
        d = up_
    next
    return ""
end function

'' What `initialize` was told. Written once, before the index worker starts.
dim shared as PathArray g_configuredPackageDirs
dim shared as PathArray g_configuredIncludeDirs

sub SetConfiguredPackageDirs( byref dirs as PathArray )
    g_configuredPackageDirs.Clear( )
    for i as long = 0 to dirs.Count( ) - 1
        dim as string d = NormalizePath( dirs[i] )
        if( len(d) > 0 ) then g_configuredPackageDirs.Push( d )
    next
end sub

'' <dir>/<sub> or <dir>/../<sub> beside the first `tiko` on PATH that has one, or "":
'' <dir>/pkg and <dir>/inc in a packaged toolchain, <dir>/../pkg and <dir>/../inc in the
'' tiko-lang repository. Found without running it.
private function BesideTikoOnPath_( byref sub_ as string ) as string
    dim as string p = environ( "PATH" )
#ifdef __FB_WIN32__
    dim as string sep = ";", exe = "\tiko.exe"
#else
    dim as string sep = ":", exe = "/tiko"
#endif
    dim as long st = 1
    while( st <= len(p) )
        dim as long en = instr( st, p, sep )
        if( en = 0 ) then en = len(p) + 1
        dim as string d = trim( mid( p, st, en - st ), any chr(34) )
        st = en + 1
        if( len(d) = 0 ) then continue while
        if( fs.IsFile( d & exe ) = false ) then continue while
        dim as string cand = JoinNative( d, sub_ )
        if( fs.IsDir( cand ) ) then return cand
        cand = JoinNative( d, "../" & sub_ )
        if( fs.IsDir( cand ) ) then return cand
    wend
    return ""
end function

'' THE PATH WALK, ONCE A SESSION. It stats <dir>\tiko.exe in every PATH entry -- about a
'' millisecond on a developer's machine -- and ModuleCandidates asks ToolchainPkgDir once
'' per import of every indexed file, on every didOpen, didChange and didClose: with
'' nothing configured, a session that had opened 300 files spent ~0.5 s in this walk per
'' didOpen, and the time grew with every file. Neither PATH nor an installed toolchain
'' moves during a session, so CacheToolchainOnPath takes both answers when `initialize`
'' arrives, before the index worker starts; until then -- the unit tests -- each call
'' walks, as before.
dim shared as boolean g_pathWalked = false
dim shared as string g_pathPkgDir
dim shared as string g_pathIncDir
dim shared as string g_pathTiko

#ifdef __FB_WIN32__
const TIKO_EXE_NAME = "tiko.exe"
#else
const TIKO_EXE_NAME = "tiko"
#endif

'' The first <dir>/tiko(.exe) on PATH.
private function TikoExeOnPath_( ) as string
    dim as string p = environ( "PATH" )
#ifdef __FB_WIN32__
    dim as string sep = ";"
#else
    dim as string sep = ":"
#endif
    dim as long st = 1
    while( st <= len(p) )
        dim as long en = instr( st, p, sep )
        if( en = 0 ) then en = len(p) + 1
        dim as string d = trim( mid( p, st, en - st ), any chr(34) )
        st = en + 1
        if( len(d) = 0 ) then continue while
        dim as string cand = JoinNative( d, TIKO_EXE_NAME )
        if( fs.IsFile( cand ) ) then return cand
    wend
    return ""
end function

sub CacheToolchainOnPath( )
    g_pathPkgDir = BesideTikoOnPath_( "pkg" )
    g_pathIncDir = BesideTikoOnPath_( "inc" )
    g_pathTiko   = TikoExeOnPath_( )
    g_pathWalked = true
end sub

function TikoOnPath( ) as string
    if( g_pathWalked ) then return g_pathTiko
    return TikoExeOnPath_( )
end function

function ToolchainCompilerIn( byref root as string ) as string
    if( len(root) = 0 ) then return ""
    dim as string cand = JoinNative( root, TIKO_EXE_NAME )
    if( fs.IsFile( cand ) ) then return cand
    cand = JoinNative( root, "bin/" & TIKO_EXE_NAME )
    if( fs.IsFile( cand ) ) then return cand
    return ""
end function

function ToolchainRootFrom( byref given as string ) as string
    if( len(given) = 0 ) then return ""
    dim as string p = NormalizePath( given )
    '' The compiler itself was named: start from its directory.
    if( fs.IsFile( p ) ) then p = DirPart( p )
    '' The root, or -- one level down -- its bin directory.
    for tries as long = 0 to 1
        if( len(p) = 0 ) then exit for
        if( len( ToolchainCompilerIn( p ) ) > 0 andalso fs.IsDir( JoinNative( p, "inc" ) ) ) then return p
        p = DirPart( p )
    next
    return ""
end function

function DetectToolchainRoot( ) as string
    dim cands as PathArray
#ifdef __FB_WIN32__
    dim as string home = environ( "USERPROFILE" )
#else
    dim as string home = environ( "HOME" )
#endif
    if( len(home) > 0 ) then
        cands.Push( JoinNative( home, "tiko-lang" ) )
        dim as string downloads = JoinNative( home, "Downloads" )
        cands.Push( JoinNative( downloads, "tiko-lang" ) )
        '' Windows' Extract All unpacks tiko-windows-x86_64-<sha>.zip into a folder of that
        '' name, so the toolchain is one level further down.
        if( fs.IsDir( downloads ) ) then
            dim entries as containers.Array( of fs.DirEntry )
            if( fs.ListDir( downloads, entries ).IsOk( ) ) then
                for q as long = 0 to entries.Count( ) - 1
                    if( entries[q].IsDirectory( ) = false ) then continue for
                    dim as string nm = entries[q].Name( )
                    if( lcase( left( nm, 5 ) ) <> "tiko-" ) then continue for
                    cands.Push( JoinNative( downloads, nm & "/tiko-lang" ) )
                next
            end if
        end if
    end if
#ifdef __FB_WIN32__
    dim as string drive_ = environ( "SystemDrive" )
    if( len(drive_) = 0 ) then drive_ = "C:"
    cands.Push( JoinNative( drive_ & "\", "tiko-lang" ) )
#else
    cands.Push( "/opt/tiko-lang" )
    if( len(home) > 0 ) then cands.Push( JoinNative( home, ".local/tiko-lang" ) )
#endif

    for i as long = 0 to cands.Count( ) - 1
        dim as string root = ToolchainRootFrom( cands[i] )
        if( len(root) > 0 ) then return root
    next
    return ""
end function

function ToolchainPkgDir( ) as string
    for i as long = 0 to g_configuredPackageDirs.Count( ) - 1
        if( fs.IsDir( g_configuredPackageDirs[i] ) ) then return g_configuredPackageDirs[i]
    next

    '' The one the configured compiler named (metadata.ti): not a guess.
    dim as string mp = MetadataPkgDir( )
    if( len(mp) > 0 andalso fs.IsDir( mp ) ) then return mp

    '' <toolchain>/inc was named, so <toolchain>/pkg is the package tree -- the layout
    '' every packaged toolchain has. Without this a client that configured includePaths
    '' alone found headers but no `#import "std/strings"`.
    for i as long = 0 to g_configuredIncludeDirs.Count( ) - 1
        dim as string cand = JoinNative( g_configuredIncludeDirs[i], "../pkg" )
        if( fs.IsDir( cand ) ) then return cand
    next

    dim as string env_ = environ( "TKO_PKG" )
    if( len(env_) > 0 ) then return NormalizePath( env_ )

    '' BESIDE A `tiko` ON PATH, found without running it: <dir>/pkg in a packaged
    '' toolchain, <dir>/../pkg in the tiko-lang repository.
    if( g_pathWalked ) then return g_pathPkgDir
    return BesideTikoOnPath_( "pkg" )
end function

function ToolchainIncDir( ) as string
    dim as string env_ = environ( "TKO_INCLUDE" )
    if( len(env_) > 0 ) then return NormalizePath( env_ )
    if( g_pathWalked ) then return g_pathIncDir
    return BesideTikoOnPath_( "inc" )
end function

sub SetConfiguredIncludeDirs( byref dirs as PathArray )
    g_configuredIncludeDirs.Clear( )
    for i as long = 0 to dirs.Count( ) - 1
        dim as string d = NormalizePath( dirs[i] )
        if( len(d) > 0 ) then g_configuredIncludeDirs.Push( d )
    next
end sub

function ToolchainIncDirs( ) as PathArray
    dim out_ as PathArray
    for i as long = 0 to g_configuredIncludeDirs.Count( ) - 1
        if( fs.IsDir( g_configuredIncludeDirs[i] ) ) then out_.Push( g_configuredIncludeDirs[i] )
    next
    if( out_.IsEmpty( ) ) then
        '' What the configured compiler compiles the workspace's roots with (metadata.ti).
        dim md as PathArray = MetadataIncludeDirs( )
        for i as long = 0 to md.Count( ) - 1
            if( fs.IsDir( md[i] ) ) then out_.Push( md[i] )
        next
    end if
    if( out_.IsEmpty( ) ) then
        dim as string d = ToolchainIncDir( )
        if( len(d) > 0 ) then out_.Push( d )
    end if
    return out_
end function

'' The manifest above `here` and what it says, through `memo` when there is one.
private sub ManifestFor_( byref here as string, byval memo as ManifestMemo ptr, _
                          byref md as string, byref pkgName as string, _
                          byref depNames as PathArray, byref depPaths as PathArray )
    depNames.Clear( )
    depPaths.Clear( )
    pkgName = ""
    if( memo = 0 ) then
        md = ManifestDirAbove( here )
        if( len(md) > 0 ) then ReadManifest( md, pkgName, depNames, depPaths )
        exit sub
    end if

    if( memo->above_.TryGet( here, md ) = false ) then
        md = ManifestDirAbove( here )
        memo->above_.Put( here, md )
    end if
    if( len(md) = 0 ) then exit sub

    dim as string packed
    if( memo->read_.TryGet( md, packed ) = false ) then
        ReadManifest( md, pkgName, depNames, depPaths )
        packed = pkgName & chr(1)
        for i as long = 0 to depNames.Count( ) - 1
            packed &= depNames[i] & chr(1) & depPaths[i] & chr(1)
        next
        memo->read_.Put( md, packed )
        exit sub
    end if

    '' Unpacked in the order it was packed: the name, then name/path pairs.
    dim as long st = 1, field_ = 0
    while( st <= len(packed) )
        dim as long en = instr( st, packed, chr(1) )
        dim as string v = mid( packed, st, en - st )
        if( field_ = 0 ) then
            pkgName = v
        elseif( (field_ and 1) = 1 ) then
            depNames.Push( v )
        else
            depPaths.Push( v )
        end if
        field_ += 1
        st = en + 1
    wend
end sub

sub ModuleCandidates( byref importerPath as string, byref importPath as string, _
                      byref roots as PathArray, byref outDirs as PathArray, _
                      byval memo as ManifestMemo ptr = 0 )
    outDirs.Clear( )
    dim as string p = importPath
    if( len(p) = 0 ) then exit sub
    dim as string here = DirPart( importerPath )

    '' 1. relative.
    if( left( p, 2 ) = "./" orelse left( p, 3 ) = "../" ) then
        outDirs.Push( JoinNative( here, p ) )
        exit sub
    end if

    '' 0. where the configured compiler found it (metadata.ti), when it was asked and
    '' a target of this file's package reaches the module.
    dim as string known = MetadataModuleDir( importerPath, p )
    if( len(known) > 0 ) then outDirs.Push( known )

    dim as long sl = instr( p, "/" )
    dim as string first_ = lcase( iif( sl = 0, p, left( p, sl - 1 ) ) )
    dim as string rest = iif( sl = 0, "", mid( p, sl + 1 ) )

    '' std/, vendor/ AND sys/ ARE THE TOOLCHAIN'S (tiko-lang RFC-0007 §3; tiko-vendor RFC-0002
    '' V3; sys/win, as the compiler's Reserved_): looked for in its pkg/ alone, never in a
    '' package, a dependency or an -i root.
    if( first_ <> "std" andalso first_ <> "vendor" andalso first_ <> "sys" ) then
        '' 2 and 3: the importing file's package, and its manifest's dependencies.
        dim as string md, pkgName
        dim depNames as PathArray
        dim depPaths as PathArray
        ManifestFor_( here, memo, md, pkgName, depNames, depPaths )
        if( len(md) > 0 ) then
            if( pkgName = first_ ) then outDirs.Push( JoinNative( md, rest ) )
            for i as long = 0 to depNames.Count( ) - 1
                if( depNames[i] = first_ ) then outDirs.Push( JoinNative( depPaths[i], rest ) )
            next
        end if

        '' 4. the -i roots the compiler searched, when it said; then the workspace
        '' folders, which stand in for them.
        dim ir as PathArray
        MetadataSearchRoots( importerPath, ir )
        for i as long = 0 to ir.Count( ) - 1
            outDirs.Push( JoinNative( ir[i], p ) )
        next
        for i as long = 0 to roots.Count( ) - 1
            outDirs.Push( JoinNative( roots[i], p ) )
        next
    end if

    '' 5. the toolchain.
    dim as string pk
    if( memo = 0 ) then
        pk = ToolchainPkgDir( )
    else
        if( memo->pkgKnown_ = false ) then
            memo->pkgDir_ = ToolchainPkgDir( )
            memo->pkgKnown_ = true
        end if
        pk = memo->pkgDir_
    end if
    if( len(pk) > 0 ) then outDirs.Push( JoinNative( pk, p ) )
end sub
