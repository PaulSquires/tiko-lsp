'' ############################################################################
''  workspace/modules.ti -- where a tiko `#import` leads
'' ############################################################################
''
''  tiko-lang's module system (its ADR 0017): a MODULE is a directory whose files
''  each begin `#module "name"`, and `#import "acme/net/http"` names one. This
''  finds the directory an import names, following tiko-lang's RFC-0007 section 3 --
''  implemented HERE, independently, because the server never runs the compiler:
''
''    1. a path beginning `./` or `../`, against the importing file's directory
''    2. the importing file's own package: the nearest tiko.toml above it, when
''       its [package] name is the path's first segment
''    3. that manifest's [dependencies] -- `x = { path = "..." }`
''    4. each workspace folder, standing in for tiko's -i directories, which the
''       server is never told
''    5. the toolchain's pkg/: TKO_PKG, else beside a `tiko` found on PATH
''
''  `std` skips 2-4: it is always the toolchain's.
''
''  WHEN A COMPILER IS CONFIGURED (metadata.ti) its answer comes FIRST: the
''  directory it resolved the chain to, ahead of 2; the -i roots it really
''  searched, ahead of the workspace folders in 4; and its pkg/ in 5. Everything
''  above stays, behind it, as the fallback.
''
''  The answer is a list of CANDIDATES, in that order. Which of them holds the
''  module is the index's question -- it knows which files it has.
'' ----------------------------------------------------------------------------

#pragma once

#include once "workspace.ti"

'' THE MANIFESTS ONE PASS HAS ALREADY FOUND AND READ. ModuleCandidates walks up from the
'' importer to the nearest tiko.toml -- two stats a level -- and reads it, for every import
'' of every file; ResolveImports_ runs that over the whole index on every didOpen,
'' didChange and didClose, so a package of a few dozen files (tracks-2026) cost ~1,900
'' walks and reads, 170 ms, per keystroke. A memo lives for one pass and no longer: an
'' edited manifest is read again by the next one, and the worker's pass and the message
'' loop's each have their own.
type ManifestStringMap as containers.Map( of string, string )
type ManifestMemo
    '' a directory -> the manifest directory above it, "" for none
    as ManifestStringMap above_
    '' a manifest directory -> its [package] name, then each dependency's name and path,
    '' every field ended by chr(1)
    as ManifestStringMap read_
    '' ToolchainPkgDir, asked once a pass: it stats each configured directory, and
    '' every import that is not relative asks for it.
    as boolean pkgKnown_ = false
    as string pkgDir_
end type

'' The directories `importPath`, imported from the file at `importerPath`, may
'' name, first choice first. Native, absolute, not necessarily there.
''
'' `memo`, when given, keeps the manifest found above each directory and what it says,
'' so a pass over the whole index finds and reads each tiko.toml once -- see
'' ManifestMemo. Without one, every call walks up and reads the file.
declare sub ModuleCandidates( byref importerPath as string, byref importPath as string, _
                              byref roots as PathArray, byref outDirs as PathArray, _
                              byval memo as ManifestMemo ptr = 0 )

'' The nearest directory at or above `dir_` holding a tiko.toml, or "".
declare function ManifestDirAbove( byref dir_ as string ) as string

'' The toolchain's package tree, or "" when none can be found. First choice first: what the
'' client configured (initializationOptions.packagePaths -- SetConfiguredPackageDirs), then
'' the configured compiler's own (metadata.ti), then a `pkg` BESIDE a configured include directory (a packaged toolchain is <dir>/inc and
'' <dir>/pkg, so naming the one finds the other), then TKO_PKG, then beside a `tiko` on PATH.
declare function ToolchainPkgDir( ) as string

'' Walks PATH for a `tiko` once and keeps what ToolchainPkgDir and ToolchainIncDir find
'' beside it, for the rest of the session. Called once, from `initialize`, before the
'' index worker starts; until it is, each of them walks PATH on every call.
declare sub CacheToolchainOnPath( )

'' Records the client's `packagePaths`. Same rule as SetConfiguredIncludeDirs: called once,
'' from `initialize`, before the index worker starts.
declare sub SetConfiguredPackageDirs( byref dirs as PathArray )

'' THE TOOLCHAIN'S HEADER DIRECTORY, as the compiler finds it (tiko-lang cmdline.bas,
'' AppendDefaultIncludeDir): TKO_INCLUDE, else <dir>/inc or <dir>/../inc beside a `tiko` on
'' PATH; "" when there is none. A std facade includes `fb/...` headers from here.
declare function ToolchainIncDir( ) as string

'' THE DIRECTORIES A WORKSPACE'S INCLUDES ARE LOOKED UP IN after the includer's own
'' directory and the workspace folders, first choice first: what the client configured
'' (initializationOptions.includePaths -- SetConfiguredIncludeDirs), else the configured
'' compiler's (metadata.ti), else ToolchainIncDir.
'' Empty when there is neither. Only directories that exist are returned.
declare function ToolchainIncDirs( ) as PathArray

'' Records the client's `includePaths`. Called once, from `initialize` -- BEFORE the index
'' worker is started, so the thread start orders the write before every read and the worker
'' needs no lock. A later call would race the worker; there is none.
declare sub SetConfiguredIncludeDirs( byref dirs as PathArray )

'' THE TOOLCHAIN AS ONE FOLDER -- what a user unpacked: `tiko-lang`, holding the compiler
'' (`tiko.exe` on Windows, `bin/tiko` elsewhere), `inc` and `pkg`. A user knows that
'' folder; `includePaths`, `packagePaths` and `compilerPath` are derived from it.

'' The compiler inside a toolchain root -- <root>/tiko(.exe) or <root>/bin/tiko(.exe) --
'' or "" when there is none.
declare function ToolchainCompilerIn( byref root as string ) as string

'' The toolchain root `given` names, or "": the root itself, its `bin` directory, or the
'' compiler. A root is a directory holding a compiler (ToolchainCompilerIn) and `inc`.
declare function ToolchainRootFrom( byref given as string ) as string

'' A toolchain unpacked where the website's instructions leave one, or "": <home>/tiko-lang,
'' <home>/Downloads/tiko-lang, <home>/Downloads/tiko-*/tiko-lang (Windows' Extract All makes
'' a folder named after the archive), then C:\tiko-lang on Windows or /opt/tiko-lang and
'' ~/.local/tiko-lang elsewhere. <home> is USERPROFILE on Windows, HOME elsewhere. Reads
'' the environment on every call; called once, from `initialize`.
declare function DetectToolchainRoot( ) as string

'' The first `tiko` on PATH, or "". Cached by CacheToolchainOnPath like the two above.
declare function TikoOnPath( ) as string
