'' ############################################################################
''  workspace/symbol_index.ti -- every symbol in the workspace
''
''  One SymbolTable per file, kept whole rather than flattened, because that is
''  what makes an incremental update cheap: a file changes, its table is
''  replaced, and nothing else is touched. A flat list would have to be
''  rebuilt, or grow holes.
''
''  THE OPEN BUFFER WINS. A file that the editor has open is indexed from the
''  buffer, not from disk -- the same rule as everything else in this server,
''  and the reason a symbol appears in the workspace list as soon as it is
''  typed rather than when it is saved.
'' ############################################################################

#pragma once

#include once "workspace.ti"
#include once "../analysis/parser.ti"
#include once "../analysis/includes.ti"

'' A symbol's NAME range, in LSP coordinates, worked out when the file was
'' indexed.
''
'' Storing the position rather than the byte offset is what lets the index
'' answer without keeping every file's text in memory: converting an offset to
'' a UTF-16 column needs the bytes of that line, and holding a workspace's
'' worth of source to be able to do it later would cost tens of megabytes for
'' a question already answered.
type IndexedRange
    StartLine as long
    StartChar as long
    EndLine   as long
    EndChar   as long
end type

type IndexedRangeArray as containers.Array( of IndexedRange )

'' Where a symbol is: which file, and which entry of that file's table.
type IndexHit
    FileIndex as long
    SymIndex  as long
    Score     as long        '' higher is a better match; see Query
end type

type IndexHitArray as containers.Array( of IndexHit )

'' ----------------------------------------------------------------------------
''  The include graph
''
''  One edge per `#include` that names a file THIS INDEX KNOWS ABOUT. Anything
''  else -- a compiler header, a path built by a macro, a file outside every
''  workspace folder -- is an edge to nowhere, and a file that has one is a file
''  whose visibility cannot be known. That distinction is the whole reason the
''  graph is worth having: it says where the server may be precise, and it says
''  so per file rather than in general.
''
''  RESOLUTION IS LEXICAL, and deliberately does no file I/O. A candidate path
''  is built from the includer's directory and the workspace roots, normalised,
''  and looked up among the files already indexed. Twenty thousand includes
''  then cost twenty thousand hash probes rather than twenty thousand stat
''  calls -- and the question being asked really is "is this one of ours?".
'' ----------------------------------------------------------------------------
type IncludeEdge
    Target    as string   '' as written
    ToFile    as long     '' index into the index, or -1 for outside it

    '' A `#cinclude`: Target is a C header, and ToFile the BINDING tiko made of it
    '' (cincludes.ti) -- found by asking, never by path, since the header itself is
    '' not FreeBASIC and is never read.
    IsC_      as boolean

    '' `public #include` / `public #cinclude` in a module file: an importer of the module
    '' sees the header's names bare (VisibleFrom).
    Public_   as boolean

    '' Where the quoted path is, in LSP coordinates, so a jump to it has a
    '' range to answer with.
    Line      as long
    StartChar as long
    EndChar   as long
end type

type IncludeEdgeArray as containers.Array( of IncludeEdge )

'' ONE `#import` (tiko-lang ADR 0017; the resolution rules are workspace/modules.ti). The
'' import edges, like the include edges, are resolved by ResolveIncludes -- but not only
'' lexically: a module directory no indexed file lives in, which is what the toolchain's
'' pkg/ looks like, is read and its files indexed.
''
'' The alias it binds, the module directory it
'' resolved to, and that module's files in the index. A module is a directory, so an
'' import is an edge to SEVERAL files; an unresolved one has Dir_ "" and no files.
'' Aliased before use in a field: a generic will not instantiate as a TYPE field.
type ImportFileArray as containers.Array( of long )

type ImportEdge
    Alias_    as string    '' lower-cased: the path's last segment, or what `as` says
    Target    as string    '' the path as written
    Public_   as boolean   '' `#import ... public`
    Line      as long
    StartChar as long
    EndChar   as long
    Dir_      as string    '' the module's directory, native, or ""
    Files     as ImportFileArray
end type

type ImportEdgeArray as containers.Array( of ImportEdge )

'' ONE `#export`ed MACRO of a module file (analysis/includes.ti, ExportRef), its name's
'' range converted as the symbols' are. NOT A SYMBOL, and kept apart from them on purpose:
'' an exported macro is written `alias.NAME` and never bare, so it must not reach the
'' outline, workspace/symbol, or a bare name's definition -- only `alias.`.
type ExportEdge
    Name_      as string
    LowerName  as string
    Body       as string    '' the `#define` body as written, or ""
    TargetNs   as string    '' `FB` of `FB.PathJoin`, lower-cased; "" when not `A.B`
    TargetName as string
    Line       as long
    StartChar  as long
    EndChar    as long
end type

type ExportEdgeArray as containers.Array( of ExportEdge )

'' An exported macro, by file and entry.
type ExportHit
    FileIndex   as long
    ExportIndex as long
end type

type ExportHitArray as containers.Array( of ExportHit )

type IndexedFile
    Uri        as string
    Path_      as string

    '' The file's IDENTITY: its absolute path, lower-cased. The URI is what
    '' goes back to the client, but two spellings of one path -- the client's
    '' and the scan's -- must be ONE entry, or every symbol in the file is
    '' found twice.
    Key_       as string
    Symbols    as SymbolTable
    Ranges     as IndexedRangeArray   '' one per symbol, aligned by index
    Includes   as IncludeEdgeArray    '' what this file pulls in
    Imports    as ImportEdgeArray     '' the modules it imports
    Exports    as ExportEdgeArray     '' the macros it `#export`s
    FromBuffer as boolean    '' indexed from an open document, not from disk

    '' A TOOLCHAIN HEADER -- windows.bi, AfxNova -- read in because a workspace
    '' file includes it. It is visible to completion, hover, definition and
    '' signature help, which is why it is read at all; it is never edited by a
    '' rename, never searched for references, and never offered by
    '' workspace/symbol, whose picker thirty thousand Win32 names would swamp.
    External_  as boolean
end type

type IndexedFileArray as containers.Array( of IndexedFile )

type SymbolIndex
    private:
        m_files       as IndexedFileArray
        m_searchPaths as PathArray

    public:
        declare sub      Clear( )
        declare function FileCount  ( ) as long
        declare function SymbolCount( ) as long

        declare function FileUri ( byval fileIndex as long ) as string
        declare function FilePath( byval fileIndex as long ) as string
        declare function IsFromBuffer( byval fileIndex as long ) as boolean
        declare function IsExternal  ( byval fileIndex as long ) as boolean

        '' -1 when that file is not indexed.
        declare function IndexOfUri( byref uri as string ) as long

        '' Adds or REPLACES the entry for `uri`. Analysis happens here, so a
        '' caller never has to know whether this file was seen before.
        declare sub IndexText( byref uri as string, byref path_ as string, _
                               byref text_ as string, byval fromBuffer as boolean = false )

        '' Reads the file and indexes it. False when it could not be read.
        declare function IndexPath( byref path_ as string ) as boolean

        '' Indexes a `#cinclude` binding (cincludes.ti) as an EXTERNAL file, with a
        '' larger size cap than a source. False when it could not be read.
        declare function IndexBinding( byref path_ as string ) as boolean

        '' True when the file has a `#cinclude` edge.
        declare function HasCIncludes( byval fileIndex as long ) as boolean

        declare sub Remove( byref uri as string )

        '' -- the include graph ------------------------------------------------

        '' Where to look for an include that is not relative to its includer:
        '' the workspace folders. Set once; indexing does not need them, only
        '' resolution does.
        declare sub SetSearchPaths( byref paths as PathArray )

        '' Points every include edge at the file it names, or at -1. Cheap
        '' (one hash probe per edge) and must be re-run after anything that
        '' adds, removes or replaces a file -- a scan, a merge, a buffer.
        ''
        '' `readHeaders` also READS the toolchain headers the workspace's
        '' includes reach (ToolchainIncDirs) and indexes them as External_ --
        '' hundreds of files and seconds of work for a Win32 project, so only
        '' the worker's full build passes it. Lexical resolution afterwards
        '' still finds them: they are in the index.
        declare sub ResolveIncludes( byval readHeaders as boolean = false )

        declare function IncludeCount( byval fileIndex as long ) as long
        declare function IncludeAt   ( byval fileIndex as long, byval i as long ) as IncludeEdge

        '' True when this file includes something the index cannot place.
        '' Its visible set is then a LOWER BOUND, not an answer, and every
        '' caller treats it that way.
        declare function HasUnresolvedIncludes( byval fileIndex as long ) as boolean

        '' The file's `#import`s, resolved by ResolveIncludes (workspace/modules.ti).
        declare function ImportCount( byval fileIndex as long ) as long
        declare function ImportAt   ( byval fileIndex as long, byval i as long ) as ImportEdge

        '' The files of the module `lowerAlias` names in that file -- false when it is
        '' no alias of the file's imports.
        declare function ModuleFilesOf( byval fileIndex as long, byref lowerAlias as string, _
                                        byref out_ as containers.Array( of long ) ) as boolean

        '' WHAT `alias.` MAY NAME: the module's file-level declarations marked `public`.
        declare sub ModuleMembers( byval fileIndex as long, byref lowerAlias as string, _
                                   byref out_ as IndexHitArray )

        '' ...AND ITS `#export`ED MACROS, which are not symbols: a std facade (tiko-lang
        '' RFC-0009) is nothing else, so `fs.` would otherwise offer nothing.
        declare sub ModuleExports( byval fileIndex as long, byref lowerAlias as string, _
                                   byref out_ as ExportHitArray )
        declare function ExportAt( byval fileIndex as long, byval i as long ) as ExportEdge

        '' WHAT AN EXPORTED MACRO NAMES, when its body is `A.B` -- a facade's `FB.PathJoin`:
        '' a declaration of B inside a namespace A, among the files its module file can see
        '' (the header it includes). False when the body names nothing found.
        declare function ExportTarget( byval exportFile as long, byref e as ExportEdge, _
                                       byref out_ as IndexHit ) as boolean

        '' ModuleExports and ExportTarget together, for a whole module at once: `targets`
        '' aligned with `exports`, FileIndex -1 where nothing is named. One pass over what
        '' each module file can see, not one per name -- std/tui exports 352, and completion
        '' runs on every keystroke.
        declare sub ModuleExportTargets( byval fileIndex as long, byref lowerAlias as string, _
                                         byref exports as ExportHitArray, _
                                         byref targets as IndexHitArray )

        '' `alias.name` AS ONE ANSWER, for hover and definition: a public declaration of the
        '' module (returns 1, `sym` set), else an exported macro (returns 2, `exp` set, and
        '' `sym` set to what it names when that is found, else FileIndex -1); 0 for neither.
        declare function ModuleMemberAt( byval fileIndex as long, byref lowerAlias as string, _
                                         byref lowerName as string, byref sym as IndexHit, _
                                         byref exp_ as ExportHit ) as long

        '' The files `fileIndex` can see: itself, what it includes, and what
        '' those include, transitively. Cycles terminate -- a file already
        '' visited is not visited again, which is also what `#include once`
        '' means.
        declare sub VisibleFrom( byval fileIndex as long, byref out_ as containers.Array( of long ) )

        '' The reverse: every file that can see `fileIndex`. This is the set a
        '' rename of something declared there could possibly touch.
        declare sub IncludedBy( byval fileIndex as long, byref out_ as containers.Array( of long ) )

        '' True when `fromFile` can see `targetFile` -- the question everything
        '' above is really asking.
        declare function CanSee( byval fromFile as long, byval targetFile as long ) as boolean

        '' Takes every file `other` holds, replacing any entry for the same
        '' file. Used to merge a batch the worker re-indexed back into the live
        '' index -- the targeted counterpart of adopting a whole fresh index.
        declare sub Absorb( byref other as SymbolIndex )

        '' A symbol, by file and entry. The reference dies with the index.
        declare function SymbolAt( byval fileIndex as long, byval symIndex as long ) byref as SymbolInfo

        '' Its name's range, in LSP line/character coordinates.
        declare function RangeAt( byval fileIndex as long, byval symIndex as long ) as IndexedRange

        '' How many symbols one indexed file declares.
        declare function FileSymbolCount( byval fileIndex as long ) as long

        '' workspace/symbol. Matches case-insensitively, and scores an exact
        '' name above a prefix above a substring above a subsequence, so the
        '' obvious answer is first. An empty query matches everything, which is
        '' what a client sends to populate its picker.
        declare sub Query( byref queryText as string, byval limit as long, byref hits as IndexHitArray )

        '' The best DEFINITION of `lowerName` anywhere in the workspace, or
        '' false. A body beats a DECLARE, and a file the editor has open beats
        '' one read from disk.
        declare function FindDefinition( byref lowerName as string, byref hit as IndexHit ) as boolean

        '' The same question asked from somewhere: a declaration `fromFile` can
        '' actually see beats one it cannot, whatever else is true of them.
        '' Falls back to the workspace-wide answer, because a definition the
        '' user can be shown beats none -- and an include this server could not
        '' resolve must not turn into "no such name".
        declare function FindDefinitionFrom( byval fromFile as long, byref lowerName as string, _
                                             byref hit as IndexHit ) as boolean
end type

'' Byte offsets of every identifier token in `text_` that matches `lowerName`.
''
'' Kept out of SymbolIndex on purpose: references are answered by re-lexing,
'' not from a stored occurrence list. A list of every identifier in a workspace
'' is tens of megabytes to hold and to keep current, and a "find references" is
'' a deliberate action a user waits for, not something typed against.
declare sub FindIdentifierOffsets( byref text_ as string, byref lowerName as string, _
                                   byref offsets as containers.Array( of long ) )
