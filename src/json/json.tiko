'' ############################################################################
''  json/json.tiko -- implementation of the JSON facade over cJSON
''
''  cJSON is tiko's `vendor/cJSON` package (cJSON 1.7.19), linked STATICALLY:
''  the server stays one file, and nothing has to be built or installed beside
''  the toolchain. This is the only file that names it.
''
''  Four cJSON rules are load-bearing here and are kept in exactly one place
''  each:
''
''    1. Text cJSON prints is cJSON's to free -- cJSON_free, never DEALLOCATE.
''       Only Serialize() ever holds any.
''    2. STRPTR() on an empty FreeBASIC string is NULL, and cJSON reads a NULL
''       string as a failure, not as "". Every call that could be handed an
''       empty string goes through TextPtr().
''    3. cJSON has no arena: a node that was never attached to anything is
''       freed by nobody. The builder records what it made (Made_) and frees the
''       strays itself.
''    4. A number is a double, printed with %1.15g -- 1e15 and up comes out in
''       exponent form. NewInt therefore writes the integer's own digits.
'' ############################################################################

#import "std/containers"
#import "vendor/cJSON" link static
#include once "crt.bi"
#include once "json.ti"

'' A one-byte static that is never written to, so an empty FB string can still
'' be passed as a valid, NUL-terminated, non-NULL zstring.
dim shared as zstring * 1 g_EmptyText

private function TextPtr( byref s as string ) as zstring ptr
    if( len(s) = 0 ) then return @g_EmptyText
    return strptr(s)
end function

private function J_( byval p as any ptr ) as cJSON ptr
    return cast( cJSON ptr, p )
end function

'' ############################################################################
''  Invalid UTF-8 on the way out
''
''  LSP says content is UTF-8; real files predate the machine that says so. 155
''  of AfxNova's 179 source files carry a Latin-1 `é` in their copyright line.
''  A client that receives a stray byte may reject the whole message -- and
''  the library that came before cJSON refused to write one at all, so a
''  completion list drawn from any of those files was silently unanswerable.
''
''  So everything that goes out is checked, and a byte that cannot be part of a
''  valid sequence becomes U+FFFD. The user sees one replacement character in a
''  copyright line instead of a feature that does not work.
'' ############################################################################

'' How long a UTF-8 sequence starting with this byte should be, or 0 when the
'' byte cannot start one.
private function Utf8Len( byval c as ubyte ) as long
    if( c < &h80 ) then return 1
    if( c >= &hC2 andalso c <= &hDF ) then return 2
    if( c >= &hE0 andalso c <= &hEF ) then return 3
    if( c >= &hF0 andalso c <= &hF4 ) then return 4
    return 0
end function

private function IsContinuation( byval c as ubyte ) as boolean
    return ( c >= &h80 andalso c <= &hBF )
end function

'' `s` with every byte that is not part of a well-formed sequence replaced. The
'' common case -- text that is already valid -- copies nothing: the scan runs,
'' finds nothing wrong, and the original is returned.
private function SanitiseUtf8( byref s as string ) as string
    dim as long n = len(s)
    dim as long i = 0
    dim as boolean clean_ = true

    while( i < n )
        dim as long need = Utf8Len( s[i] )
        if( need = 0 ) then
            clean_ = false
            exit while
        end if

        if( i + need > n ) then
            clean_ = false
            exit while
        end if

        for k as long = 1 to need - 1
            if( IsContinuation( s[i + k] ) = false ) then
                clean_ = false
                exit for
            end if
        next
        if( clean_ = false ) then exit while

        i += need
    wend

    if( clean_ ) then return s

    '' Rebuild, keeping every valid sequence whole.
    dim as string out_
    i = 0

    while( i < n )
        dim as long need = Utf8Len( s[i] )
        dim as boolean ok_ = ( need > 0 ) andalso ( i + need <= n )

        if( ok_ ) then
            for k as long = 1 to need - 1
                if( IsContinuation( s[i + k] ) = false ) then
                    ok_ = false
                    exit for
                end if
            next
        end if

        if( ok_ ) then
            out_ &= mid( s, i + 1, need )
            i += need
        else
            out_ &= chr( &hEF, &hBF, &hBD )   '' U+FFFD REPLACEMENT CHARACTER
            i += 1
        end if
    wend

    return out_
end function

'' A FreeBASIC string from a NUL-terminated C string; "" for NULL.
private function TextOf( byval p as const zstring ptr ) as string
    if( p = NULL ) then return ""
    dim as uinteger n = strlen( p )
    if( n = 0 ) then return ""
    dim as string s = space( n )
    memcpy( strptr(s), p, n )
    return s
end function

'' ############################################################################
''  JsonValue
'' ############################################################################

constructor JsonValue( )
    this.m_val = NULL
end constructor

constructor JsonValue( byval v as any ptr )
    this.m_val = v
end constructor

function JsonValue.Handle( ) as any ptr
    return this.m_val
end function

function JsonValue.IsValid( ) as boolean
    return this.m_val <> NULL
end function

function JsonValue.IsNull( ) as boolean
    if( this.m_val = NULL ) then return false
    return cJSON_IsNull( J_( this.m_val ) ) <> 0
end function

function JsonValue.IsObject( ) as boolean
    if( this.m_val = NULL ) then return false
    return cJSON_IsObject( J_( this.m_val ) ) <> 0
end function

function JsonValue.IsArray( ) as boolean
    if( this.m_val = NULL ) then return false
    return cJSON_IsArray( J_( this.m_val ) ) <> 0
end function

function JsonValue.IsString( ) as boolean
    if( this.m_val = NULL ) then return false
    return cJSON_IsString( J_( this.m_val ) ) <> 0
end function

function JsonValue.IsNumber( ) as boolean
    if( this.m_val = NULL ) then return false
    return cJSON_IsNumber( J_( this.m_val ) ) <> 0
end function

function JsonValue.IsBool( ) as boolean
    if( this.m_val = NULL ) then return false
    return cJSON_IsBool( J_( this.m_val ) ) <> 0
end function

function JsonValue.Has( byref key as string ) as boolean
    if( this.IsObject( ) = false ) then return false
    return cJSON_GetObjectItemCaseSensitive( J_( this.m_val ), TextPtr(key) ) <> NULL
end function

function JsonValue.Member( byref key as string ) as JsonValue
    if( this.IsObject( ) = false ) then return JsonValue( )
    return JsonValue( cJSON_GetObjectItemCaseSensitive( J_( this.m_val ), TextPtr(key) ) )
end function

'' cJSON keeps an object's members in the same child list as an array's
'' elements, so one count serves both.
function JsonValue.Count( ) as long
    if( this.IsArray( ) = false andalso this.IsObject( ) = false ) then return 0
    return cJSON_GetArraySize( J_( this.m_val ) )
end function

function JsonValue.Item( byval idx as long ) as JsonValue
    if( this.IsArray( ) = false ) then return JsonValue( )
    if( idx < 0 orelse idx >= this.Count( ) ) then return JsonValue( )
    return JsonValue( cJSON_GetArrayItem( J_( this.m_val ), idx ) )
end function

function JsonValue.AsString( byref dflt as string = "" ) as string
    if( this.IsString( ) = false ) then return dflt
    return TextOf( J_( this.m_val )->valuestring )
end function

function JsonValue.AsLongInt( byval dflt as longint = 0 ) as longint
    if( this.IsNumber( ) = false ) then return dflt
    return clngint( J_( this.m_val )->valuedouble )
end function

function JsonValue.AsDouble( byval dflt as double = 0.0 ) as double
    if( this.IsNumber( ) = false ) then return dflt
    return J_( this.m_val )->valuedouble
end function

function JsonValue.AsBoolean( byval dflt as boolean = false ) as boolean
    if( this.IsBool( ) = false ) then return dflt
    return cJSON_IsTrue( J_( this.m_val ) ) <> 0
end function

'' ############################################################################
''  JsonArrayIterator / JsonArray
'' ############################################################################

constructor JsonArrayIterator( )
    this.m_cur = NULL
end constructor

constructor JsonArrayIterator( byval arr as any ptr )
    this.m_cur = NULL
    if( arr <> NULL ) then
        if( cJSON_IsArray( J_( arr ) ) <> 0 ) then this.m_cur = J_( arr )->child
    end if
end constructor

function JsonArrayIterator.IsValid( ) as boolean
    return this.m_cur <> NULL
end function

function JsonArrayIterator.Value( ) as JsonValue
    return JsonValue( this.m_cur )
end function

sub JsonArrayIterator.MoveNext( )
    if( this.m_cur <> NULL ) then this.m_cur = J_( this.m_cur )->next
end sub

constructor JsonArray( )
    this.m_arr = NULL
end constructor

constructor JsonArray( byval v as JsonValue )
    this.m_arr = iif( v.IsArray( ), v.Handle( ), cast( any ptr, NULL ) )
end constructor

function JsonArray.Count( ) as long
    if( this.m_arr = NULL ) then return 0
    return cJSON_GetArraySize( J_( this.m_arr ) )
end function

function JsonArray.GetIterator( ) as JsonArrayIterator
    return JsonArrayIterator( this.m_arr )
end function

function ArrayOf( byval v as JsonValue ) as JsonArray
    return JsonArray( v )
end function

'' ############################################################################
''  JsonDoc
'' ############################################################################

constructor JsonDoc( )
    this.m_root = NULL
end constructor

constructor JsonDoc( byref rhs as JsonDoc )
    this.m_root = NULL
    this.m_err = rhs.m_err
    if( rhs.m_root <> NULL ) then this.m_root = cJSON_Duplicate( J_( rhs.m_root ), 1 )
end constructor

operator JsonDoc.let( byref rhs as JsonDoc )
    if( @rhs = @this ) then exit operator
    this.Clear( )
    this.m_err = rhs.m_err
    if( rhs.m_root <> NULL ) then this.m_root = cJSON_Duplicate( J_( rhs.m_root ), 1 )
end operator

destructor JsonDoc( )
    this.Clear( )
end destructor

sub JsonDoc.Clear( )
    if( this.m_root <> NULL ) then
        cJSON_Delete( J_( this.m_root ) )
        this.m_root = NULL
    end if
    this.m_err = ""
end sub

function JsonDoc.Parse( byref text_ as string ) as boolean
    this.Clear( )

    if( len(text_) = 0 ) then
        this.m_err = "empty content"
        return false
    end if

    '' Strict RFC 8259: no comments, no trailing commas, no NaN, and NOTHING
    '' after the value. A client that sends those is broken, and accepting them
    '' would hide the bug. The length counts the string's terminating NUL, which
    '' is what lets cJSON's require-the-terminator check see the true end: given
    '' len( text_ ) alone, it would refuse every document.
    ''
    '' Where it stopped comes back through `endp`, not cJSON_GetErrorPtr: that is
    '' one global, and documents are parsed on the index workers too.
    dim as const zstring ptr endp = NULL
    this.m_root = cJSON_ParseWithLengthOpts( strptr(text_), len(text_) + 1, @endp, 1 )

    if( this.m_root = NULL ) then
        dim as long at_ = 0
        if( endp <> NULL ) then at_ = clng( cast( ubyte ptr, endp ) - cast( ubyte ptr, strptr(text_) ) )
        this.m_err = "invalid JSON (at byte " & at_ & ")"
        return false
    end if

    return true
end function

function JsonDoc.IsValid( ) as boolean
    return this.m_root <> NULL
end function

function JsonDoc.Root( ) as JsonValue
    return JsonValue( this.m_root )
end function

function JsonDoc.ErrorText( ) as string
    return this.m_err
end function

'' ############################################################################
''  JsonNode
'' ############################################################################

constructor JsonNode( )
    this.m_val = NULL
end constructor

constructor JsonNode( byval v as any ptr )
    this.m_val = v
end constructor

function JsonNode.Handle( ) as any ptr
    return this.m_val
end function

function JsonNode.IsValid( ) as boolean
    return this.m_val <> NULL
end function

'' ############################################################################
''  JsonBuilder
'' ############################################################################

constructor JsonBuilder( )
    this.m_root = NULL
    this.m_made = NULL
    this.m_madeCount = 0
    this.m_madeCap = 0
end constructor

'' Every node a factory hands out is recorded here, so the destructor can find
'' the ones nobody attached. A NULL (cJSON out of memory) is recorded as nothing.
function JsonBuilder.Made_( byval p as any ptr ) as JsonNode
    if( p = NULL ) then return JsonNode( )
    if( this.m_madeCount = this.m_madeCap ) then
        dim as long cap = iif( this.m_madeCap = 0, 32, this.m_madeCap * 2 )
        dim as any ptr ptr grown = reallocate( this.m_made, cap * sizeof( any ptr ) )
        if( grown = NULL ) then
            cJSON_Delete( J_( p ) )
            return JsonNode( )
        end if
        this.m_made = grown
        this.m_madeCap = cap
    end if
    this.m_made[this.m_madeCount] = p
    this.m_madeCount += 1
    return JsonNode( p )
end function

destructor JsonBuilder( )
    '' THE STRAYS FIRST. cJSON links a node into its parent through `prev`,
    '' which a fresh node has NULL: a recorded node with no `prev` that is not
    '' the root was never attached, so nothing else will free it, and its own
    '' children go with it. ALL are decided before ANY is freed -- a stray's
    '' child is recorded too, and asking it after its parent was deleted would
    '' read freed memory. Strays are never inside one another (each has no
    '' parent), so deleting the marked ones frees nothing twice. Then the root,
    '' which takes everything attached under it.
    for i as long = 0 to this.m_madeCount - 1
        dim as any ptr p = this.m_made[i]
        if( p = this.m_root orelse J_( p )->prev <> NULL ) then this.m_made[i] = NULL
    next
    for i as long = 0 to this.m_madeCount - 1
        if( this.m_made[i] <> NULL ) then cJSON_Delete( J_( this.m_made[i] ) )
    next
    if( this.m_root <> NULL ) then cJSON_Delete( J_( this.m_root ) )
    this.m_root = NULL
    if( this.m_made <> NULL ) then deallocate( this.m_made )
    this.m_made = NULL
    this.m_madeCount = 0
    this.m_madeCap = 0
end destructor

function JsonBuilder.IsValid( ) as boolean
    return true
end function

function JsonBuilder.NewObject( ) as JsonNode
    return this.Made_( cJSON_CreateObject( ) )
end function

function JsonBuilder.NewArray( ) as JsonNode
    return this.Made_( cJSON_CreateArray( ) )
end function

function JsonBuilder.CopyOf( byval v as JsonValue ) as JsonNode
    if( v.Handle( ) = NULL ) then return JsonNode( )
    return this.Made_( cJSON_Duplicate( J_( v.Handle( ) ), 1 ) )
end function

'' cJSON copies the value, so the FB string may be a temporary that dies
'' before the document is serialised. Sanitised here for the reply's sake;
'' Serialize sanitises again for the strings that arrive by other paths.
function JsonBuilder.NewString( byref v as string ) as JsonNode
    dim as string clean_ = SanitiseUtf8( v )
    return this.Made_( cJSON_CreateString( TextPtr(clean_) ) )
end function

'' A cJSON number is a double and prints with %1.15g, so 10^15 and beyond come
'' out in exponent form -- valid JSON, but not an integer to a strict reader.
'' A RAW node holds the integer's own decimal digits, which print verbatim.
function JsonBuilder.NewInt( byval v as longint ) as JsonNode
    dim as string digits = str( v )
    return this.Made_( cJSON_CreateRaw( strptr(digits) ) )
end function

function JsonBuilder.NewDouble( byval v as double ) as JsonNode
    return this.Made_( cJSON_CreateNumber( v ) )
end function

function JsonBuilder.NewBool( byval v as boolean ) as JsonNode
    return this.Made_( cJSON_CreateBool( iif( v, 1, 0 ) ) )
end function

function JsonBuilder.NewNull( ) as JsonNode
    return this.Made_( cJSON_CreateNull( ) )
end function

'' ----------------------------------------------------------------------------
''  Object writers -- every one goes through SetNode. cJSON copies the key.
'' ----------------------------------------------------------------------------

'' A NODE MAY BE ATTACHED MORE THAN ONCE -- the definition handler sets one
'' position object as both a range's "start" and its "end" -- and handlers have
'' always been able to. A cJSON node lives in one parent's child list, through
'' its own `next`/`prev`: linked a second time, the list becomes a cycle, the
'' printer runs to its circular limit and gives up, and freeing the tree frees
'' the node twice (heap corruption at exit). So a node that is already in a
'' list, or is the root, is attached as a deep copy instead.
function JsonBuilder.Attachable_( byval v as JsonNode ) as any ptr
    dim as cJSON ptr item = J_( v.Handle( ) )
    if( item->prev = NULL andalso v.Handle( ) <> this.m_root ) then return item
    return this.Made_( cJSON_Duplicate( item, 1 ) ).Handle( )
end function

function JsonBuilder.SetNode( byval obj as JsonNode, byref key as string, byval v as JsonNode ) as boolean
    if( obj.IsValid( ) = false orelse v.IsValid( ) = false ) then return false
    dim as any ptr item = this.Attachable_( v )
    if( item = NULL ) then return false
    return cJSON_AddItemToObject( J_( obj.Handle( ) ), TextPtr(key), J_( item ) ) <> 0
end function

function JsonBuilder.SetStr( byval obj as JsonNode, byref key as string, byref v as string ) as boolean
    return this.SetNode( obj, key, this.NewString( v ) )
end function

function JsonBuilder.SetInt( byval obj as JsonNode, byref key as string, byval v as longint ) as boolean
    return this.SetNode( obj, key, this.NewInt( v ) )
end function

function JsonBuilder.SetDouble( byval obj as JsonNode, byref key as string, byval v as double ) as boolean
    return this.SetNode( obj, key, this.NewDouble( v ) )
end function

function JsonBuilder.SetBool( byval obj as JsonNode, byref key as string, byval v as boolean ) as boolean
    return this.SetNode( obj, key, this.NewBool( v ) )
end function

function JsonBuilder.SetNull( byval obj as JsonNode, byref key as string ) as boolean
    return this.SetNode( obj, key, this.NewNull( ) )
end function

function JsonBuilder.PushNode( byval arr as JsonNode, byval v as JsonNode ) as boolean
    if( arr.IsValid( ) = false orelse v.IsValid( ) = false ) then return false
    dim as any ptr item = this.Attachable_( v )
    if( item = NULL ) then return false
    return cJSON_AddItemToArray( J_( arr.Handle( ) ), J_( item ) ) <> 0
end function

function JsonBuilder.PushStr( byval arr as JsonNode, byref v as string ) as boolean
    if( arr.IsValid( ) = false ) then return false
    return this.PushNode( arr, this.NewString( v ) )
end function

function JsonBuilder.PushInt( byval arr as JsonNode, byval v as longint ) as boolean
    if( arr.IsValid( ) = false ) then return false
    return this.PushNode( arr, this.NewInt( v ) )
end function

sub JsonBuilder.SetRoot( byval root as JsonNode )
    if( root.IsValid( ) = false ) then exit sub
    this.m_root = root.Handle( )
end sub

function JsonBuilder.Serialize( byval pretty as boolean = false ) as string
    if( this.m_root = NULL ) then return ""

    dim as zstring ptr buf
    if( pretty ) then
        buf = cJSON_Print( J_( this.m_root ) )
    else
        buf = cJSON_PrintUnformatted( J_( this.m_root ) )
    end if
    if( buf = NULL ) then return ""

    dim as string out_ = TextOf( buf )

    '' cJSON allocated it, so cJSON releases it. DEALLOCATE here would be a
    '' different allocator's free.
    cJSON_free( buf )

    '' The whole text, once: a value copied from another program's JSON
    '' (CopyOf) never passed NewString. Stray bytes can only be inside strings
    '' -- every structural character is ASCII -- so U+FFFD keeps the document
    '' valid JSON.
    return SanitiseUtf8( out_ )
end function

'' ############################################################################
''  Free helpers
'' ############################################################################

function JsonQuote( byref v as string ) as string
    dim as string out_ = """"

    for i as long = 0 to len(v) - 1
        dim as ubyte c = v[i]
        select case c
            case asc("""") : out_ &= "\"""
            case asc("\")  : out_ &= "\\"
            case 8         : out_ &= "\b"
            case 9         : out_ &= "\t"
            case 10        : out_ &= "\n"
            case 12        : out_ &= "\f"
            case 13        : out_ &= "\r"
            case else
                if( c < 32 ) then
                    out_ &= "\u" & lcase( hex( c, 4 ) )
                else
                    out_ &= chr( c )
                end if
        end select
    next

    return out_ & """"
end function
