'' ############################################################################
''  utils/position.ti -- the one place line/column/offset arithmetic lives
''
''  THREE COORDINATE SYSTEMS, AND THEY ARE NOT INTERCHANGEABLE:
''
''    LSP position    line (0-based) + character (0-based), and `character`
''                    counts UTF-16 CODE UNITS, not bytes and not characters.
''                    An emoji is 2. A CJK ideograph is 1, though it occupies
''                    3 bytes in the file.
''    byte offset     0-based index into the document's UTF-8 text. This is
''                    what a lexer, a parser and MID() all want.
''    SourcePosition  both at once, so a conversion is done once and carried.
''
''  Every conversion in the server goes through this module. Scattering the
''  arithmetic is how off-by-one bugs get into a language server, and they show
''  up as a hover that highlights the wrong word rather than as a crash.
''
''  LINE TERMINATORS: LF, CRLF and a lone CR all end a line, as the
''  specification requires. The terminator is NOT part of the line's content,
''  so a position may never point into the middle of a CRLF.
'' ############################################################################

#pragma once


'' A container held as a FIELD must be a named instantiation.
type OffsetArray as containers.Array( of longint )

type SourcePosition
    Line   as long      '' 0-based
    Column as long      '' 0-based, in UTF-16 code units
    Offset as longint   '' 0-based byte offset into the UTF-8 text
end type

type SourceRange
    StartPos as SourcePosition
    EndPos   as SourcePosition
end type

'' ----------------------------------------------------------------------------
''  LineIndex -- byte offset of the first byte of every line
''
''  Rebuilt whenever the text changes. For a 10 000-line file that is 80 KB and
''  one linear pass, which is cheaper than any scheme that tries to patch the
''  index incrementally and gets it subtly wrong.
'' ----------------------------------------------------------------------------
type LineIndex
    private:
        m_starts  as OffsetArray
        m_textLen as longint

    public:
        declare constructor( )

        declare sub Rebuild( byref text_ as string )

        declare function LineCount( ) as long
        declare function TextLength( ) as longint

        '' Byte offset of the first byte of `lineNo`. Out-of-range lines clamp
        '' to the first or last line, because LSP requires clamping rather
        '' than an error.
        declare function LineStart( byval lineNo as long ) as longint

        '' Byte offset one past the last CONTENT byte of `lineNo` -- i.e. the
        '' terminator is excluded.
        declare function LineContentEnd( byref text_ as string, byval lineNo as long ) as longint

        '' The line containing `offset`. Binary search: O(log lines).
        declare function LineOfOffset( byval offset as longint ) as long
end type

'' ----------------------------------------------------------------------------
''  Conversions
'' ----------------------------------------------------------------------------

'' UTF-16 code units spanned by text_[fromByte .. toByte-1]. Invalid UTF-8 is
'' counted one unit per byte rather than rejected: a language server must keep
'' working on a file the user is halfway through typing.
declare function Utf16UnitsInRange( byref text_ as string, byval fromByte as longint, byval toByte as longint ) as long

'' Byte offset within one line for a UTF-16 column, clamped to the line's
'' content end. Never lands inside a multi-byte sequence.
declare function Utf16ColumnToByte( byref text_ as string, byval lineStart as longint, byval lineEnd as longint, byval utf16Col as long ) as longint

'' LSP (line, character) -> byte offset, with LSP's clamping rules applied.
declare function LspPositionToOffset( byref text_ as string, byref idx as LineIndex, byval lineNo as long, byval character as long ) as longint

'' byte offset -> a fully populated SourcePosition.
declare function OffsetToSourcePosition( byref text_ as string, byref idx as LineIndex, byval offset as longint ) as SourcePosition

'' LSP (line, character) -> a fully populated SourcePosition.
declare function LspPositionToSourcePosition( byref text_ as string, byref idx as LineIndex, byval lineNo as long, byval character as long ) as SourcePosition

'' Convenience constructors, so a test or a handler need not fill in fields.
declare function MakeSourcePosition( byval lineNo as long, byval character as long, byval offset as longint ) as SourcePosition
declare function MakeSourceRange( byval startPos as SourcePosition, byval endPos as SourcePosition ) as SourceRange
