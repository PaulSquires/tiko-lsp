type Point
    x as long
    y as long
end type

sub Greet( byval name_ as string )
    print "hello " & name_
end sub

dim p as Point
p.x = 1
Greet( "world" )

' `Point` is also a reserved word (POINT), so the `as` check uses this one.
type Widget
    w as long
end type
dim q as Widget
dim pq as Widget ptr = @q
pq->w = 2
