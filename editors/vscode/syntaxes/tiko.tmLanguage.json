{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Tiko",
  "scopeName": "source.tiko",
  "comment": "Generated by gen_tmlanguage.py from the Zed highlights query. tiko is case-insensitive, so every word pattern is (?i). The server's semantic tokens refine this once it is running.",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#preprocessor"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.tiko",
          "begin": "/'",
          "end": "'/",
          "patterns": [
            {
              "include": "#comments"
            }
          ]
        },
        {
          "name": "comment.line.apostrophe.tiko",
          "match": "'.*$"
        },
        {
          "name": "comment.line.rem.tiko",
          "match": "(?i)(?<![\\w.])rem(?=\\s|$).*$"
        }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "match": "(?i)^\\s*(#\\s*(?:include|import))\\b(\\s+once\\b)?\\s*(\"[^\"]*\")?",
          "captures": {
            "1": {
              "name": "keyword.control.directive.tiko"
            },
            "2": {
              "name": "keyword.control.directive.tiko"
            },
            "3": {
              "name": "string.quoted.double.include.tiko"
            }
          }
        },
        {
          "match": "(?i)^\\s*(#\\s*(?:define|macro))\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.directive.tiko"
            },
            "2": {
              "name": "entity.name.function.preprocessor.tiko"
            }
          }
        },
        {
          "name": "keyword.control.directive.tiko",
          "match": "(?i)^\\s*#\\s*[A-Za-z_]+"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.escaped.tiko",
          "begin": "!\"",
          "end": "\"(?!\")",
          "patterns": [
            {
              "name": "constant.character.escape.tiko",
              "match": "\\\\.|\"\""
            }
          ]
        },
        {
          "name": "string.quoted.double.tiko",
          "begin": "\\$?\"",
          "end": "\"(?!\")",
          "patterns": [
            {
              "name": "constant.character.escape.tiko",
              "match": "\"\""
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.tiko",
          "match": "(?i)&h[0-9a-f]+[ul]*"
        },
        {
          "name": "constant.numeric.binary.tiko",
          "match": "(?i)&b[01]+[ul]*"
        },
        {
          "name": "constant.numeric.octal.tiko",
          "match": "(?i)&o?[0-7]+[ul]*"
        },
        {
          "name": "constant.numeric.decimal.tiko",
          "match": "(?i)(?<![\\w.])\\d+(\\.\\d*)?(e[+-]?\\d+)?[!#%&ful]*\\b"
        },
        {
          "name": "constant.language.boolean.tiko",
          "match": "(?i)\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.tiko",
          "match": "(?i)(?<![\\w.])(nullptr)(?![\\w$%&!#])"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "(?i)\\b(sub|function|property|constructor|destructor|operator)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": {
              "name": "storage.type.function.tiko"
            },
            "2": {
              "name": "entity.name.function.tiko"
            }
          }
        },
        {
          "match": "(?i)^\\s*(type|union|enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.tiko"
            },
            "2": {
              "name": "entity.name.type.tiko"
            }
          }
        },
        {
          "match": "(?i)\\b(namespace)\\s+([A-Za-z_][A-Za-z0-9_.]*)",
          "captures": {
            "1": {
              "name": "storage.type.namespace.tiko"
            },
            "2": {
              "name": "entity.name.namespace.tiko"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.tiko",
          "match": "(?i)(?<![\\w.])(continue|elseif|return|select|endif|gosub|until|while|case|else|exit|goto|loop|next|step|then|wend|end|for|do|if|to)(?![\\w$%&!#])"
        },
        {
          "name": "storage.modifier.tiko",
          "match": "(?i)(?<![\\w.])(protected|abstract|explicit|extends|private|virtual|public|shared|static|byref|byval|const)(?![\\w$%&!#])"
        },
        {
          "name": "storage.type.tiko",
          "match": "(?i)(?<![\\w.])(uinteger|ulongint|boolean|float32|float64|integer|longint|pointer|wstring|zstring|double|single|string|uint16|uint32|uint64|ushort|int16|int32|int64|short|ubyte|uint8|ulong|byte|int8|long|any|ptr)(?![\\w$%&!#])"
        },
        {
          "name": "keyword.other.tiko",
          "match": "(?i)(?<![\\w.])(constructor|destructor|namespace|function|operator|property|declare|extern|field|scope|union|enum|once|type|with|asm|sub|as|is|of)(?![\\w$%&!#])"
        },
        {
          "name": "support.function.builtin.tiko",
          "match": "(?i)(?<![\\w.])(defulongint|imagecreate|__fastcall|__thiscall|deflongint|implements|threadcall|cva_start|cvlongint|defushort|mklongint|culngint|cva_copy|defshort|defubyte|encoding|instrrev|overload|preserve|unsigned|va_first|andalso|clngint|cushort|cva_arg|cva_end|cvshort|defbyte|defined|defuint|defulng|dynamic|include|mkshort|palette|procptr|restore|stdcall|ustring|access|append|binary|circle|common|cshort|cubyte|defdbl|defint|deflng|defsng|defstr|delete|export|import|lbound|lprint|option|orelse|output|pascal|preset|random|resume|screen|sizeof|strptr|typeof|ubound|unlock|varptr|window|winput|alias|atan2|cbool|cbyte|cdecl|class|close|color|csign|cuint|culng|cunsg|erase|error|input|instr|lcase|local|ltrim|paint|point|print|redim|rtrim|ucase|using|width|write|acos|asin|base|call|cast|cdbl|cint|clng|cptr|csng|data|draw|frac|line|lock|lset|name|open|peek|poke|pset|read|rset|sadd|seek|swap|trim|view|wchr|wstr|abs|and|asc|atn|chr|cos|cvd|cvi|cvl|cvs|dim|eqv|err|exp|fix|get|iif|imp|int|len|let|lib|log|mid|mkd|mki|mkl|mks|mod|new|not|put|rem|sgn|shl|shr|sin|spc|sqr|str|tab|tan|var|xor|on|or)(?![\\w$%&!#])"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "match": "([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.tiko"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.tiko",
          "match": "(?i)->|[-+*/\\\\^&=<>@]|\\b(mod|and|or|xor|not|shl|shr|andalso|orelse|eqv|imp)\\b"
        }
      ]
    }
  }
}
