{
    ///////////////////////
    // LSP-tiko Settings //
    ///////////////////////

    // The tiko-lsp executable. Empty: the one in toolchainPath below, then
    // `tiko-lsp` on the PATH, then a tiko-lang folder in your home or Downloads
    // folder (or C:/tiko-lang, /opt/tiko-lang, ~/.local/tiko-lang). tiko-lsp comes
    // with tiko, beside the compiler.
    "server_path": "",

    // Arguments passed to the server. Add "--log-level", "debug",
    // "--log-file", "C:/temp/tiko-lsp.log" to see what it is doing; it never
    // writes to stdout.
    "server_arguments": ["--stdio"],

    // Generated by the plugin from server_path and server_arguments.
    // DO NOT CHANGE THIS.
    "command": [],

    // tiko source, by the scope Tiko.sublime-syntax gives it.
    "selector": "source.tiko",

    // Sent to the server once, in `initialize`: a change needs
    // `LSP: Restart Servers` to take effect.
    //
    // Leave an option out to let the server decide: an EMPTY string or list is
    // an instruction ("toolchainPath": "" and "compilerPath": "" turn off the
    // server's own search), not a default.
    "initializationOptions": {
        // The folder you unpacked tiko into -- the one named tiko-lang, e.g.
        // "C:/tiko-lang". Its server, headers, packages and compiler are used.
        // Left out: the server finds the toolchain it is installed in, a tiko on
        // the PATH, or a tiko-lang folder in your home or Downloads folder.
        // "toolchainPath": "C:/tiko-lang",

        // Overrides, one part of the toolchain at a time, for unusual layouts:
        // "includePaths": ["C:/tiko-lang/inc"],
        // "packagePaths": ["C:/tiko-lang/pkg"],
        // "compilerPath": "C:/tiko-lang/tiko.exe",
    }
}
