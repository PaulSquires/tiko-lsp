{
    ///////////////////////
    // LSP-tiko Settings //
    ///////////////////////

    // The tiko-lsp executable. Empty: `tiko-lsp` on the PATH, then
    // `bin/tiko-lsp.exe` inside a workspace folder.
    "server_path": "",

    // Arguments passed to the server. Add "--log-level", "debug",
    // "--log-file", "C:/temp/tiko-lsp.log" to see what it is doing; it never
    // writes to stdout.
    "server_arguments": ["--stdio"],

    // Generated by the plugin from server_path and server_arguments.
    // DO NOT CHANGE THIS.
    "command": [],

    // tiko source, by the scope Tiko.sublime-syntax gives it.
    "selector": "source.tiko",

    // Sent to the server once, in `initialize`: a change needs
    // `LSP: Restart Servers` to take effect.
    "initializationOptions": {
        // The toolchain's inc -- where `#include "windows.bi"` is found, e.g.
        // "C:/dev/tiko-editor-tiko/toolchains/tiko-windows/inc". The server reads
        // the headers the workspace includes from here, so Win32, AfxNova and
        // runtime names complete, hover and show signatures.
        "includePaths": [],

        // The toolchain's pkg -- what `#import "std/strings"` names. Usually
        // unnecessary: the `pkg` beside an include path is found on its own.
        "packagePaths": []
    }
}
