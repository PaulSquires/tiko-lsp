%YAML 1.2
---
# GENERATED by gen_sublime.py from the Zed highlights query -- do not edit by hand.
# tiko is case-insensitive, so every word pattern is (?i). The server's semantic
# tokens refine this once LSP-tiko is running.
name: Tiko
scope: source.tiko
file_extensions: [tiko, tko, ti, bas, bi, inc]

contexts:
  main:
    - include: comments
    - include: preprocessor
    - include: strings
    - include: numbers
    - include: declarations
    - include: keywords
    - include: calls
    - include: operators

  comments:
    - match: "/'"
      scope: punctuation.definition.comment.begin.tiko
      push: block-comment
    - match: "'.*$"
      scope: comment.line.apostrophe.tiko
    - match: '(?i)(?<![\w.])rem(?=\s|$).*$'
      scope: comment.line.rem.tiko

  block-comment:
    - meta_scope: comment.block.tiko
    - match: "'/"
      scope: punctuation.definition.comment.end.tiko
      pop: true
    - match: "/'"
      push: block-comment

  preprocessor:
    - match: '(?i)^\s*(#\s*(?:include|import))\b(\s+once\b)?\s*("[^"]*")?'
      captures:
        1: keyword.control.directive.tiko
        2: keyword.control.directive.tiko
        3: string.quoted.double.include.tiko
    - match: '(?i)^\s*(#\s*(?:define|macro))\s+([A-Za-z_][A-Za-z0-9_]*)'
      captures:
        1: keyword.control.directive.tiko
        2: entity.name.function.preprocessor.tiko
    - match: '(?i)^\s*#\s*[A-Za-z_]+'
      scope: keyword.control.directive.tiko

  strings:
    - match: '!"'
      scope: punctuation.definition.string.begin.tiko
      push: escaped-string
    - match: '\$?"'
      scope: punctuation.definition.string.begin.tiko
      push: string

  escaped-string:
    - meta_scope: string.quoted.double.escaped.tiko
    - match: '\\.|""'
      scope: constant.character.escape.tiko
    - match: '"'
      scope: punctuation.definition.string.end.tiko
      pop: true
    - match: '$'
      pop: true

  string:
    - meta_scope: string.quoted.double.tiko
    - match: '""'
      scope: constant.character.escape.tiko
    - match: '"'
      scope: punctuation.definition.string.end.tiko
      pop: true
    - match: '$'
      pop: true

  numbers:
    - match: '(?i)&h[0-9a-f]+[ul]*'
      scope: constant.numeric.hex.tiko
    - match: '(?i)&b[01]+[ul]*'
      scope: constant.numeric.binary.tiko
    - match: '(?i)&o?[0-7]+[ul]*'
      scope: constant.numeric.octal.tiko
    - match: '(?i)(?<![\w.])\d+(\.\d*)?(e[+-]?\d+)?[!#%&ful]*\b'
      scope: constant.numeric.decimal.tiko
    - match: '(?i)\b(true|false)\b'
      scope: constant.language.boolean.tiko
    - match: '(?i)(?<![\w.])(nullptr)(?![\w$%&!#])'
      scope: constant.language.null.tiko

  declarations:
    - match: '(?i)\b(sub|function|property|constructor|destructor|operator)\s+([A-Za-z_][A-Za-z0-9_]*(?:\.[A-Za-z_][A-Za-z0-9_]*)*)'
      captures:
        1: storage.type.function.tiko
        2: entity.name.function.tiko
    - match: '(?i)^\s*(type|union|enum|class|interface)\s+([A-Za-z_][A-Za-z0-9_]*)'
      captures:
        1: storage.type.tiko
        2: entity.name.type.tiko
    - match: '(?i)\b(namespace)\s+([A-Za-z_][A-Za-z0-9_.]*)'
      captures:
        1: storage.type.namespace.tiko
        2: entity.name.namespace.tiko

  keywords:
    - match: '(?i)(?<![\w.])(select)\s+(channel)(?![\w$%&!#])'
      captures:
        1: keyword.control.tiko
        2: keyword.control.tiko
    - match: '(?i)^\s*(get|set)\s*(?=$|'')'
      captures:
        1: keyword.other.tiko
    - match: '(?i)(?<![\w.])(end)\s+(get|set)(?![\w$%&!#])'
      captures:
        1: keyword.control.tiko
        2: keyword.other.tiko
    - match: '(?i)(?<![\w.])(continue|elseif|return|select|endif|gosub|until|while|case|else|exit|goto|loop|next|step|then|wend|end|for|do|if|to)(?![\w$%&!#])'
      scope: keyword.control.tiko
    - match: '(?i)(?<![\w.])(protected|abstract|explicit|extends|private|virtual|public|shared|static|byref|byval|const)(?![\w$%&!#])'
      scope: storage.modifier.tiko
    - match: '(?i)(?<![\w.])(uinteger|ulongint|boolean|float32|float64|integer|longint|pointer|ustring|wstring|zstring|double|single|string|uint16|uint32|uint64|ushort|int16|int32|int64|short|ubyte|uint8|ulong|byte|int8|long|any|ptr)(?![\w$%&!#])'
      scope: storage.type.tiko
    - match: '(?i)(?<![\w.])(constructor|destructor|implements|interface|namespace|function|inherits|operator|property|declare|extern|class|field|scope|union|enum|once|type|with|asm|sub|as|is|of)(?![\w$%&!#])'
      scope: keyword.other.tiko
    - match: '(?i)(?<![\w.])(defulongint|imagecreate|__fastcall|__thiscall|deflongint|threadcall|cva_start|cvlongint|defushort|mklongint|culngint|cva_copy|defshort|defubyte|encoding|instrrev|overload|preserve|unsigned|va_first|andalso|clngint|cushort|cva_arg|cva_end|cvshort|defbyte|defined|defuint|defulng|dynamic|include|mkshort|palette|procptr|restore|stdcall|access|append|binary|circle|common|cshort|cubyte|defdbl|defint|deflng|defsng|defstr|delete|export|import|lbound|lprint|option|orelse|output|pascal|preset|random|resume|screen|sizeof|strptr|typeof|ubound|unlock|varptr|window|winput|alias|atan2|cbool|cbyte|cdecl|close|color|csign|cuint|culng|cunsg|erase|error|input|instr|lcase|local|ltrim|paint|point|print|redim|rtrim|ucase|using|width|write|acos|asin|base|call|cast|cdbl|cint|clng|cptr|csng|data|draw|frac|line|lock|lset|name|open|peek|poke|pset|read|rset|sadd|seek|swap|trim|view|wchr|wstr|abs|and|asc|atn|chr|cos|cvd|cvi|cvl|cvs|dim|eqv|err|exp|fix|get|iif|imp|int|len|let|lib|log|mid|mkd|mki|mkl|mks|mod|new|not|put|rem|sgn|shl|shr|sin|spc|sqr|str|tab|tan|var|xor|on|or)(?![\w$%&!#])'
      scope: support.function.builtin.tiko

  calls:
    - match: '([A-Za-z_][A-Za-z0-9_]*)\s*(?=\()'
      captures:
        1: variable.function.tiko

  operators:
    - match: '(?i)->|[-+*/\\^&=<>@]|\b(mod|and|or|xor|not|shl|shr|andalso|orelse|eqv|imp)\b'
      scope: keyword.operator.tiko
