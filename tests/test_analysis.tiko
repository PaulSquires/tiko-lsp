'' ############################################################################
''  tests/test_analysis.tiko -- the lexer and the structural parser
''
''  The last group is the important one: it runs the analyser over THIS
''  PROJECT'S OWN SOURCE -- every .bas and .bi in src/ and tests/ -- and
''  requires zero diagnostics. Several thousand lines of real source is a
''  far better false-positive test than any hand-written sample, because a
''  language server that squiggles valid code is worse than one that reports
''  nothing at all.
''
''  Build: build\_run_tests.bat  (or build/_run_tests.sh)
'' ############################################################################

#import "std/containers"
#include once "assert.ti"
#include once "../src/analysis/lexer.ti"
#include once "../src/analysis/parser.ti"

const LF = chr(10)
const CR = chr(13)
const DQ = chr(34)

'' ----------------------------------------------------------------------------
''  Helpers
'' ----------------------------------------------------------------------------

private function DiagCount( byref src as string ) as long
    dim as DiagnosticArray diags
    AnalyzeSource( src, diags )
    return diags.Count( )
end function

private function FirstCode( byref src as string ) as string
    dim as DiagnosticArray diags
    AnalyzeSource( src, diags )
    if( diags.Count( ) = 0 ) then return ""
    return diags[0].Code_
end function

private function FirstMessage( byref src as string ) as string
    dim as DiagnosticArray diags
    AnalyzeSource( src, diags )
    if( diags.Count( ) = 0 ) then return ""
    return diags[0].Message_
end function

'' Asserts that a snippet is accepted without complaint.
private sub AssertClean( byref src as string, byref what_ as string )
    dim as DiagnosticArray diags
    AnalyzeSource( src, diags )
    if( diags.Count( ) = 0 ) then
        TestPass( what_ )
    else
        TestFail( what_, diags.Count( ) & " diagnostic(s), first: " & diags[0].Message_ )
    end if
end sub

private sub AssertOneCode( byref src as string, byref code_ as string, byref what_ as string )
    dim as DiagnosticArray diags
    AnalyzeSource( src, diags )
    if( diags.Count( ) = 1 andalso diags[0].Code_ = code_ ) then
        TestPass( what_ )
    else
        dim as string detail = diags.Count( ) & " diagnostic(s)"
        if( diags.Count( ) > 0 ) then detail &= ", first: " & diags[0].Code_ & " -- " & diags[0].Message_
        TestFail( what_, detail & " (wanted exactly one " & code_ & ")" )
    end if
end sub

'' Counts tokens of one kind, which is how the lexer groups are checked.
private function CountKind( byref src as string, byval kind as TokenKind ) as long
    dim as TokenArray tokens
    dim as DiagnosticArray diags
    LexSource( src, tokens, diags )

    dim as long n = 0
    for i as long = 0 to tokens.Count( ) - 1
        if( tokens[i].Kind = kind ) then n += 1
    next
    return n
end function

'' ----------------------------------------------------------------------------
TestGroup( "lexer: the basics" )

scope
    dim as TokenArray tokens
    dim as DiagnosticArray diags
    dim as string src = "dim as long count"
    LexSource( src, tokens, diags )

    AssertEqInt( diags.Count( ), 0, "a plain declaration lexes cleanly" )
    AssertEqInt( tokens[0].Kind, TK_KEYWORD, "dim is a keyword" )
    AssertEqInt( tokens[1].Kw, KW_AS, "as is recognised structurally" )
    AssertEqInt( tokens[2].Kind, TK_KEYWORD, "long is a keyword" )
    AssertEqInt( tokens[3].Kind, TK_IDENT, "count is an identifier" )
    AssertEqStr( TokenText( src, tokens[3] ), "count", "token text is sliced from the source" )
    AssertEqInt( tokens[ tokens.Count( ) - 1 ].Kind, TK_EOF, "the stream ends with EOF" )
end scope

scope
    '' Keyword recognition is case-insensitive, and reaches the whole table.
    AssertEqInt( KeywordOf( "SUB" ), KW_SUB, "keywords are case-insensitive" )
    AssertEqInt( KeywordOf( "Print" ), KW_OTHER, "a non-structural keyword is KW_OTHER" )
    AssertEqInt( KeywordOf( "customer" ), KW_NONE, "an ordinary name is not a keyword" )
    AssertTrue ( IsKeyword( "byref" ), "byref is reserved" )
    AssertFalse( IsKeyword( "byreff" ), "byreff is not" )
    AssertTrue ( AllKeywords( ).Count( ) > 200, "the table carries fbc's whole reserved list" )
end scope

'' ----------------------------------------------------------------------------
TestGroup( "lexer: comments" )

AssertEqInt( CountKind( "x = 1 ' trailing note", TK_COMMENT ), 1, "an apostrophe comment" )
AssertEqInt( CountKind( "rem a whole line", TK_COMMENT ), 1, "REM comments the line" )
AssertEqInt( CountKind( "/' block '/ x = 1", TK_COMMENT ), 1, "a block comment" )
AssertEqInt( CountKind( "/' outer /' inner '/ still outer '/ x = 1", TK_COMMENT ), 1, _
             "block comments NEST, so the first '/ does not end it" )
AssertEqInt( DiagCount( "x = 1 ' note" ), 0, "a comment is not a problem" )
AssertOneCode( "/' never closed" & LF & "x = 1", DIAGCODE_UNTERMINATED_COMMENT, _
               "an unterminated block comment is reported" )

'' ----------------------------------------------------------------------------
TestGroup( "lexer: strings" )

scope
    AssertEqInt( CountKind( "s = " & DQ & "hello" & DQ, TK_STRING ), 1, "a plain string" )
    AssertEqInt( CountKind( "s = " & DQ & "say " & DQ & DQ & "hi" & DQ & DQ & DQ, TK_STRING ), 1, _
                 "a doubled quote is an embedded quote, not a terminator" )
    AssertEqInt( CountKind( "s = !" & DQ & "a\" & DQ & "b" & DQ, TK_STRING ), 1, _
                 "!" & DQ & " escapes with a backslash" )
    AssertEqInt( CountKind( "s = $" & DQ & "c:\dev" & DQ, TK_STRING ), 1, _
                 "$" & DQ & " takes the backslash literally" )

    AssertOneCode( "s = " & DQ & "no end", DIAGCODE_UNTERMINATED_STRING, _
                   "an unterminated string is reported" )
    '' A string may not span a line: the error belongs to line 1, and line 2
    '' must still be analysed normally.
    AssertEqInt( DiagCount( "s = " & DQ & "no end" & LF & "x = 1" ), 1, _
                 "an unterminated string does not swallow the next line" )
end scope

'' ----------------------------------------------------------------------------
TestGroup( "lexer: block strings" )

scope
    '' tiko's '"""' literal. The rules are the compiler's (lexer.tiko
    '' ScanBlockString); each assertion below is one of them.
    dim as string Q3 = DQ & DQ & DQ

    dim as string blk = "s = " & Q3 & LF & _
                        "    print x" & LF & _
                        "    end sub" & LF & _
                        "    " & Q3 & LF
    AssertEqInt( CountKind( blk, TK_STRING ), 1, "a block string is ONE string token" )
    AssertEqInt( CountKind( blk, TK_KEYWORD ), 0, "words in its body are not keywords" )
    AssertEqInt( CountKind( blk, TK_IDENT ), 1, "nor identifiers -- only 's' is" )
    AssertEqInt( DiagCount( blk ), 0, "and an 'end sub' in the body is not an orphan closer" )

    AssertEqInt( CountKind( "s = " & Q3 & "abc" & Q3 & LF & "x = 1", TK_IDENT ), 2, _
                 "'" & Q3 & "abc" & Q3 & "' is the ordinary string " & DQ & "abc" & DQ & ", ended on its line" )
    AssertEqInt( DiagCount( "s = " & Q3 & "abc" & Q3 ), 0, "and is clean" )

    AssertEqInt( CountKind( "s = " & Q3 & "   " & LF & "  a" & LF & "  " & Q3, TK_STRING ), 1, _
                 "spaces after the opener still open one" )
    AssertEqInt( CountKind( "s = !" & Q3 & LF & "  a\t" & LF & "  " & Q3, TK_STRING ), 1, _
                 "and so does !" & Q3 )
    AssertEqInt( CountKind( "s = $" & Q3 & LF & "  a" & LF & "  " & Q3, TK_STRING ), 1, _
                 "and $" & Q3 )

    '' What follows the closing quotes is code.
    dim as string tail_ = "print len( " & Q3 & LF & "  a" & LF & "  " & Q3 & " & " & DQ & "b" & DQ & " )"
    AssertEqInt( DiagCount( tail_ ), 0, "the parenthesis after the closer balances" )
    AssertEqInt( CountKind( tail_, TK_STRING ), 2, "and the string after it is its own token" )

    '' A body line that starts with "" but not """ does not close it.
    AssertEqInt( CountKind( "s = " & Q3 & LF & "  " & DQ & DQ & " two" & LF & "  " & Q3, TK_STRING ), 1, _
                 "a body line starting with two quotes does not close it" )

    '' CRLF files: the CR is not part of any line's content.
    AssertEqInt( DiagCount( "s = " & Q3 & CR & LF & "    a" & CR & LF & "    " & Q3 & CR & LF ), 0, _
                 "a CRLF block string is clean" )

    '' A blank line, whatever it holds, is exempt from the margin.
    AssertEqInt( DiagCount( "s = " & Q3 & LF & "    a" & LF & "  " & LF & LF & "    b" & LF & "    " & Q3 ), 0, _
                 "blank lines are exempt from the margin" )

    AssertOneCode( "s = " & Q3 & LF & "    ok" & LF & "  shallow" & LF & "    " & Q3, _
                   DIAGCODE_BLOCK_STRING_MARGIN, "a line left of the margin is reported" )
    AssertOneCode( "s = " & Q3 & LF & chr(9) & "tab" & LF & "    " & Q3, _
                   DIAGCODE_BLOCK_STRING_MARGIN, "a tab is never counted as spaces" )
    AssertOneCode( "s = " & Q3 & LF & "    never closed" & LF & "x = 1", _
                   DIAGCODE_UNTERMINATED_BLOCK_STRING, "a block string with no closing line is reported" )

    '' An unterminated block swallows the rest of the file, as the compiler's does.
    AssertEqInt( CountKind( "s = " & Q3 & LF & "x = 1" & LF & "sub F( )", TK_KEYWORD ), 0, _
                 "and swallows the rest of the file" )
end scope

'' ----------------------------------------------------------------------------
TestGroup( "lexer: numbers" )

AssertEqInt( CountKind( "x = 123", TK_NUMBER ), 1, "a decimal integer" )
AssertEqInt( CountKind( "x = 1.5", TK_NUMBER ), 1, "a real" )
AssertEqInt( CountKind( "x = .5", TK_NUMBER ), 1, "a leading-dot real" )
AssertEqInt( CountKind( "x = 1e10", TK_NUMBER ), 1, "an exponent" )
AssertEqInt( CountKind( "x = 1.5e-3", TK_NUMBER ), 1, "a signed exponent" )
AssertEqInt( CountKind( "x = &hFF", TK_NUMBER ), 1, "hexadecimal" )
AssertEqInt( CountKind( "x = &b1010", TK_NUMBER ), 1, "binary" )
AssertEqInt( CountKind( "x = &o17", TK_NUMBER ), 1, "octal" )
AssertEqInt( CountKind( "x = 10ull", TK_NUMBER ), 1, "a literal suffix" )
AssertEqInt( DiagCount( "x = 1e10" ), 0, "a valid literal is not a problem" )

AssertOneCode( "x = 1.2.3", DIAGCODE_INVALID_NUMBER, "two decimal points is an error" )
AssertOneCode( "x = &hzz", DIAGCODE_INVALID_NUMBER, "hex with no digits is an error" )
AssertOneCode( "x = 12abc", DIAGCODE_INVALID_NUMBER, "a number running into a word is an error" )

'' SDL3's binding: a #define body is not code until it is expanded, and neither
'' is a #macro's -- tiko accepts both with no expansion in sight.
AssertClean( "#define SDL_TriggerBreakpoint() ( _asm ( long 0x03 ) )", "a malformed number in a #define body is not reported" )
AssertClean( "#macro M( )" & LF & "x = 0x03" & LF & "#endmacro", "a malformed number in a #macro body is not reported" )
AssertOneCode( "#define A 1" & LF & "x = 0x03", DIAGCODE_INVALID_NUMBER, "the line after a #define is code again" )

'' ----------------------------------------------------------------------------
TestGroup( "lexer: line structure" )

scope
    '' An underscore continuation makes two physical lines one logical line,
    '' which is what lets `if ... then` be recognised across a wrap.
    AssertEqInt( CountKind( "a = 1" & LF & "b = 2", TK_EOL ), 2, "two lines, two EOLs" )
    AssertEqInt( CountKind( "a = 1 + _" & LF & "2", TK_EOL ), 1, _
                 "an underscore continuation produces no EOL" )
    AssertEqInt( CountKind( "a = 1 + _ ' why" & LF & "2", TK_EOL ), 1, _
                 "a comment after the underscore does not end the continuation" )
    AssertEqInt( CountKind( "_myVar = 1", TK_IDENT ), 1, _
                 "a leading underscore is an identifier, not a continuation" )
    AssertEqInt( CountKind( "a = 1" & CR & LF & "b = 2", TK_EOL ), 2, "CRLF counts once" )
end scope

scope
    AssertEqInt( CountKind( "#include once " & DQ & "fb/map.bi" & DQ, TK_PP ), 1, "a directive" )
    AssertEqInt( CountKind( "print #1, x", TK_PP ), 0, _
                 "a '#' that is not at the head of a line is not a directive" )
    AssertEqInt( CountKind( "a$ = " & DQ & "x" & DQ, TK_IDENT ), 1, "a type suffix stays on the name" )
    AssertOneCode( "x = 1 ` 2", DIAGCODE_UNEXPECTED_CHAR, "a byte that begins nothing is reported" )
end scope

'' ----------------------------------------------------------------------------
TestGroup( "parser: procedures" )

AssertClean( "sub Test( )" & LF & "    print 1" & LF & "end sub", "a balanced sub" )
AssertClean( "function Add( byval a as long ) as long" & LF & "    return a" & LF & "end function", _
             "a balanced function" )
AssertClean( "private sub Hidden( )" & LF & "end sub", "PRIVATE qualifies the sub, it does not hide it" )
AssertClean( "declare sub Later( )", "a declare opens nothing" )

'' TYPED VARIADICS (tiko-lang RFC-0001): '...' after an array parameter's type, the last one.
AssertClean( "function Sum( nums() as const long ... ) as long" & LF & "    return 0" & LF & "end function", _
             "a typed variadic parameter" )
AssertClean( "declare function Fmt( byref f as const ustring, args() as const FormatArg ... ) as ustring", _
             "a typed variadic in a declare" )
AssertClean( "type Bag" & LF & "    as long n" & LF & "    declare constructor( xs() as const long ... )" & LF & "end type", _
             "a typed variadic constructor" )
AssertClean( "dim as function( xs() as const long ... ) as long fp", "a typed variadic procedure type" )
AssertClean( "print Sum( 1, 2, 3 ), Sum( ), Sum( xs( ) )", "calls packing, empty and spread" )
AssertClean( "function Add( ) as long" & LF & "    function = 1" & LF & "end function", _
             "`function = expr` sets the result, it does not open a procedure" )
AssertClean( "sub Customer.SetName( byref v as string )" & LF & "end sub", "a dotted member name" )
AssertClean( "constructor Foo( )" & LF & "end constructor" & LF & _
             "destructor Foo( )" & LF & "end destructor", "constructor and destructor" )
AssertClean( "operator Foo.let( byref rhs as Foo )" & LF & "end operator", "an operator body" )
AssertClean( "property Foo.Name( ) as string" & LF & "end property", "a property body" )

scope
    AssertOneCode( "sub Test( )" & LF & "    print 1", DIAGCODE_UNCLOSED_BLOCK, _
                   "a sub with no end sub" )
    AssertContains( FirstMessage( "sub Test( )" & LF & "print 1" ), "'sub Test'", _
                    "the message names the procedure" )
    AssertContains( FirstMessage( "sub Test( )" & LF & "print 1" ), "end sub", _
                    "and says what is missing" )

    AssertOneCode( "end sub", DIAGCODE_UNEXPECTED_END, "an end sub with no sub" )
    AssertContains( FirstMessage( "end sub" ), "no matching", "the message says what is missing" )
end scope

'' ----------------------------------------------------------------------------
TestGroup( "parser: conditionals and loops" )

AssertClean( "if x then" & LF & "    print 1" & LF & "end if", "a block if" )
AssertClean( "if x then print 1", "a single-line if opens nothing" )
AssertClean( "if x then print 1 else print 2", "a single-line if/else opens nothing" )
AssertClean( "if x then" & LF & "print 1" & LF & "elseif y then" & LF & "print 2" & LF & _
             "else" & LF & "print 3" & LF & "end if", "elseif and else inside an if" )
AssertClean( "if x then" & LF & "print 1" & LF & "endif", "ENDIF closes an if" )
AssertClean( "if x then ' why" & LF & "print 1" & LF & "end if", _
             "a trailing comment does not stop THEN ending the line" )
AssertClean( "select case x" & LF & "case 1" & LF & "print 1" & LF & "case else" & LF & "end select", _
             "select case" )

'' std/tasks: `select channel` waits on several channels; its arms are not CASE
'' expressions but receive/send/timeout clauses.
AssertClean( "select channel" & LF & "case receive v from ch : print v" & LF & _
             "case send 2 to ch : print 2" & LF & "case timeout 10" & LF & "case else" & LF & "end select", _
             "select channel opens a SELECT" )
AssertClean( "do" & LF & "SELECT Channel   ' wait" & LF & "case receive from ctx.Done( ) : exit do" & LF & _
             "end select" & LF & "loop", "select channel is case-insensitive and takes a comment" )
AssertClean( "dim as long channel" & LF & "select case channel" & LF & "case 1" & LF & "end select", _
             "a variable called channel still selects" )
AssertClean( "while x" & LF & "wend", "while/wend" )
AssertClean( "do" & LF & "loop until x", "do/loop" )
AssertClean( "do while x" & LF & "loop", "do while/loop" )
AssertClean( "for i as long = 0 to 9" & LF & "next", "for/next" )
AssertClean( "for i as long = 0 to 9" & LF & "next i", "for/next with the counter named" )
AssertClean( "for each v in items" & LF & "next", "for each/next" )
AssertClean( "for i as long = 0 to 1" & LF & "for j as long = 0 to 1" & LF & "next j, i", _
             "next j, i closes BOTH loops" )
AssertClean( "do" & LF & "if x then exit do" & LF & "loop", "exit do closes nothing" )
AssertClean( "for i as long = 0 to 9" & LF & "continue for" & LF & "next", "continue for closes nothing" )

AssertOneCode( "if x then" & LF & "print 1", DIAGCODE_UNCLOSED_BLOCK, "a block if with no end if" )
AssertOneCode( "end if", DIAGCODE_UNEXPECTED_END, "an end if with no if" )
AssertOneCode( "wend", DIAGCODE_UNEXPECTED_END, "a wend with no while" )
AssertOneCode( "next", DIAGCODE_UNEXPECTED_END, "a next with no for" )
AssertOneCode( "else", DIAGCODE_ORPHAN_CLAUSE, "an else outside an if" )
AssertOneCode( "case 1", DIAGCODE_ORPHAN_CLAUSE, "a case outside a select" )
AssertContains( FirstMessage( "case 1" ), "select", "the message says which block it wanted" )

'' ----------------------------------------------------------------------------
TestGroup( "parser: types and the rest" )

AssertClean( "type Customer" & LF & "    Name_ as string" & LF & "end type", "a type block" )
AssertClean( "type Ptr_ as Customer ptr", "`type X as Y` is an alias and opens nothing" )
AssertClean( "type StrArray as FB.Array( of string )", "a generic alias opens nothing" )
AssertClean( "type Customer extends Person" & LF & "end type", "an extending type still opens" )
AssertClean( "type Customer" & LF & "    declare sub SetName( )" & LF & "end type", _
             "a declare inside a type opens nothing" )
AssertClean( "union U" & LF & "    a as long" & LF & "end union", "a union" )
AssertClean( "enum Colours" & LF & "    Red" & LF & "end enum", "an enum" )
AssertClean( "enum Small as uint8" & LF & "    A1" & LF & "end enum", "a typed enum still opens" )
AssertClean( "enum Color as ubyte" & LF & "    A1" & LF & "end enum", _
             "a typed enum named by a reserved word still opens" )
AssertClean( "type T" & LF & "    enum as long" & LF & "end type", "`enum as long` in a TYPE is a field" )
AssertClean( "namespace App" & LF & "end namespace", "a namespace" )
AssertClean( "scope" & LF & "end scope", "a scope" )
AssertClean( "with obj" & LF & "end with", "a with block" )
AssertClean( "extern " & DQ & "C" & DQ & LF & "declare sub c_free( )" & LF & "end extern", _
             "extern " & DQ & "C" & DQ & " opens a block" )
AssertClean( "extern shared_thing as long", "`extern x as y` declares and opens nothing" )
AssertClean( "#ifdef __FB_WIN32__" & LF & "const SEP = 1" & LF & "#else" & LF & _
             "const SEP = 2" & LF & "#endif", "#ifdef / #else / #endif" )
AssertClean( "#macro Twice( x )" & LF & "x" & LF & "x" & LF & "#endmacro", "#macro / #endmacro" )
AssertClean( "#pragma once", "an ordinary directive is ignored" )

AssertOneCode( "type Customer" & LF & "Name_ as string", DIAGCODE_UNCLOSED_BLOCK, "a type with no end type" )
AssertOneCode( "#if defined(X)" & LF & "print 1", DIAGCODE_UNCLOSED_BLOCK, "an #if with no #endif" )
AssertOneCode( "#endif", DIAGCODE_UNEXPECTED_END, "an #endif with no #if" )
AssertOneCode( "#else", DIAGCODE_ORPHAN_CLAUSE, "an #else outside an #if" )

'' ----------------------------------------------------------------------------
''  Everything below was found by running this analyser over 432,000 lines of
''  FreeBASIC-COMPATIBLE source -- fbc's own compiler and standard library,
''  AfxNova, and the fbc test suite. tiko is FreeBASIC-compatible, so all of it
''  is tiko source too, and every one of these was a false positive on code
''  that is valid in both.
'' ----------------------------------------------------------------------------
TestGroup( "parser: forms found in real source" )

'' fbc's ir-gas64.bas: an anonymous nested type inside a union.
AssertClean( "union ustab" & LF & "full as longint" & LF & "type" & LF & _
             "offst as long" & LF & "end type" & LF & "end union", _
             "an anonymous nested TYPE opens a block" )

'' fbc's objinfo.bas: a macro parameter named NAME, which is a reserved word.
AssertClean( "#macro DEF( NAME, SZ )" & LF & "type NAME" & LF & "cmd as ulong" & LF & _
             "end type" & LF & "#endmacro", _
             "a type whose name lexes as a keyword still opens a block" )

'' AfxNova's AfxTOM.bi: a COM vtable field named Select.
AssertClean( "type ITextRangeVtbl" & LF & _
             "Select as function( byval this as any ptr ) as HRESULT" & LF & _
             "end type", "a field named `Select` is not a SELECT block" )
AssertClean( "type T" & LF & "With_ as long" & LF & "Do_ as long" & LF & "end type", _
             "fields named after block keywords are fields" )

'' Bindings #cinclude/c2t write keep C's names, keywords included: cJSON's list link
'' and SDL3's assertion record.
AssertClean( "type cJSON" & LF & "next as cJSON ptr" & LF & "prev as cJSON ptr" & LF & "end type", _
             "a field named `next` closes no FOR" )
AssertClean( "type SDL_AssertData" & LF & "function as const zstring ptr" & LF & "line as int32" & LF & "end type", _
             "a field named `function` opens no body" )
AssertClean( "union U" & LF & "loop as long" & LF & "wend as long" & LF & "end union", _
             "fields named after loop closers, in a union" )
AssertOneCode( "sub F( )" & LF & "next as long" & LF & "end sub", DIAGCODE_UNEXPECTED_END, _
               "outside a TYPE, `next as` is still a NEXT" )

'' fbc's fslink.bi and string.bi: a macro that expands to a block opener.
AssertClean( "#define FBEXTERN extern " & DQ & "C" & DQ & LF & _
             "FBEXTERN" & LF & "declare sub c_free( )" & LF & "end extern", _
             "a #define that opens a block is followed to its `end`" )

'' fbc's scheduler.bi: the opener is inside a #if branch, the closer outside.
AssertClean( "#ifdef __FB_WIN32__" & LF & "extern " & DQ & "Windows" & DQ & LF & _
             "#else" & LF & "extern " & DQ & "C" & DQ & LF & "#endif" & LF & _
             "declare sub f( )" & LF & "end extern", _
             "an EXTERN opened in one #if branch is closed after the #endif" )

'' fbc's temp-var-dtors.bas: one macro opens a scope, another closes it.
AssertClean( "#macro setup_( )" & LF & "scope" & LF & "#endmacro" & LF & _
             "#macro check_( )" & LF & "end scope" & LF & "#endmacro", _
             "a macro body is a fragment and is not required to balance" )

'' fbc's structs tests: constructor chaining.
AssertClean( "constructor T( )" & LF & "print 1" & LF & "constructor( 5 )" & LF & _
             "end constructor", "`constructor( 5 )` chains, it does not open" )

'' fbc's ir-gas64.bas: a block comment after the line-continuation underscore.
AssertClean( "dim x = ( 1, _ /' why '/" & LF & "2 )", _
             "a block comment may follow the continuation underscore" )

'' fbc's vector.bi: `_` as a macro paste argument, not a continuation.
scope
    dim as TokenArray tokens
    dim as DiagnosticArray diags
    LexSource( "V3##_( x, y, z )" & LF & "next_line = 1", tokens, diags )
    AssertEqInt( diags.Count( ), 0, "a macro paste is not a problem" )
    AssertEqInt( CountKind( "V3##_( x, y, z )" & LF & "b = 1", TK_EOL ), 2, _
                 "`_(` is a paste, not a continuation, so the line still ends" )
end scope

'' fbc's decl-const.bas and friends: method modifiers.
AssertClean( "private const function DirEntry.Name( ) as ustring" & LF & _
             "return this.m_name" & LF & "end function", "a CONST method" )
AssertClean( "private virtual destructor Renderer( )" & LF & "end destructor", _
             "a VIRTUAL destructor" )

'' fb/vector.bi: `operator = expr` sets a result; `operator = ( ... ) as T`
'' defines the equality operator. Same two words, opposite meanings.
AssertClean( "operator = ( byref a as V, byref b as V ) as boolean" & LF & _
             "operator = ( a.x = b.x )" & LF & "end operator", _
             "`operator =` both defines and assigns, and only one opens" )

'' UTF-8 initialiser braces are punctuation, not stray characters.
AssertClean( "dim a( 0 to 2 ) as long = { 1, 2, 3 }", "an array initialiser" )

scope
    '' A UTF-8 BOM is not three unexpected characters.
    AssertEqInt( DiagCount( chr(&hEF) & chr(&hBB) & chr(&hBF) & "dim as long i" ), 0, _
                 "a UTF-8 BOM is skipped" )
    '' A UTF-16 source cannot be read at all, and says nothing rather than
    '' thousands of things.
    AssertEqInt( DiagCount( chr(&hFF) & chr(&hFE) & chr(&h23) & chr(0) ), 0, _
                 "a UTF-16 source is left alone" )
end scope

'' ----------------------------------------------------------------------------
TestGroup( "parser: lambdas" )

'' Every one of these is a shape from fbc's tests/generics.
AssertClean( "dim as function( byref as long, byref as long ) as boolean less = _" & LF & _
             "function( byref x as long, byref y as long ) as boolean" & LF & _
             "return x < y" & LF & "end function", _
             "a lambda assigned to a function pointer" )
AssertClean( "SortBy( a, function( byref x as long, byref y as long ) as boolean" & LF & _
             "return x > y" & LF & "end function )", _
             "a lambda as a call argument, with the call's ) after its end" )
AssertClean( "var c = sub[ byref total ]( byval item as long )" & LF & _
             "total += item" & LF & "end sub", "a lambda with a capture list" )
AssertClean( "dim pick as function( byref a as long ) byref as long = _" & LF & _
             "function( byref a as long ) byref as long" & LF & _
             "return a" & LF & "end function", "a BYREF return type" )
AssertClean( "dim cmp as function cdecl( byval p as any ptr ) as long = _" & LF & _
             "function cdecl( byval p as any ptr ) as long" & LF & _
             "return 0" & LF & "end function", "a calling convention" )
AssertClean( "dim mk as function( ) as function( byval x as long ) as long = _" & LF & _
             "function( ) as function( byval x as long ) as long" & LF & _
             "return 0" & LF & "end function", "a lambda returning a function type" )
AssertClean( "return function( byval x as long ) as long : return x * 7 : end function", _
             "a lambda after RETURN, all on one line" )

'' The false positive the tail test exists to prevent: this is a CAST.
AssertClean( "p = cast( function( ) as long, q )", "a cast to a function type opens nothing" )
AssertClean( "dim as function( ) as long fp", "a function-pointer declaration opens nothing" )

'' ----------------------------------------------------------------------------
TestGroup( "parser: statements and END" )

AssertClean( "end", "`end` alone is the END statement, not a closer" )
AssertClean( "end 1", "`end 1` is the END statement with an exit code" )
AssertClean( "sub Go( )" & LF & "    end 2" & LF & "end sub", "END inside a sub does not close it" )
AssertClean( "sub A( ) : print 1 : end sub", "colons separate statements on one line" )
AssertClean( "label_:" & LF & "goto label_", "a label is not a block" )

'' ----------------------------------------------------------------------------
TestGroup( "parser: parentheses" )

AssertClean( "x = ( 1 + ( 2 * 3 ) )", "balanced parentheses" )
AssertClean( "x = arr( 3 )[ 1 ]", "brackets balance too" )
AssertClean( "sub F( byval a as long, _" & LF & "       byval b as long )" & LF & "end sub", _
             "a parameter list wrapped with an underscore stays one statement" )
AssertOneCode( "x = ( 1 + 2", DIAGCODE_UNBALANCED_PAREN, "an unclosed parenthesis" )
AssertOneCode( "x = 1 + 2 )", DIAGCODE_UNBALANCED_PAREN, "a stray closing parenthesis" )

'' ----------------------------------------------------------------------------
TestGroup( "parser: recovery" )

scope
    '' One missing END IF must produce ONE diagnostic, pointing at the IF --
    '' not a cascade, and not blame on the END SUB that follows.
    dim as string src = "sub Test( )" & LF & _
                        "    if x then" & LF & _
                        "        print 1" & LF & _
                        "end sub"
    dim as DiagnosticArray diags
    AnalyzeSource( src, diags )

    AssertEqInt( diags.Count( ), 1, "a missing end if inside a sub is ONE diagnostic" )
    if( diags.Count( ) = 1 ) then
        AssertEqStr( diags[0].Code_, DIAGCODE_MISMATCHED_END, "reported as a mismatched end" )
        AssertContains( diags[0].Message_, "'if'", "and it names the if" )

        '' The range must cover the IF on line 2, not the END SUB on line 4.
        dim as long ifAt = instr( src, "if x" ) - 1
        AssertEqInt( diags[0].StartOffset, ifAt, "the range points at the unclosed IF" )
    end if
end scope

scope
    '' Two independent problems are two diagnostics, and the second one is
    '' still found after the first.
    dim as string src = "sub A( )" & LF & _
                        "end sub" & LF & _
                        "sub B( )" & LF & _
                        "x = " & DQ & "unterminated" & LF & _
                        "end sub" & LF & _
                        "wend"
    dim as DiagnosticArray diags
    AnalyzeSource( src, diags )
    AssertEqInt( diags.Count( ), 2, "an early error does not hide a later one" )
end scope

scope
    '' Nothing at all should crash or complain.
    AssertEqInt( DiagCount( "" ), 0, "an empty document is clean" )
    AssertEqInt( DiagCount( LF & LF & LF ), 0, "blank lines are clean" )
    AssertEqInt( DiagCount( "   " ), 0, "whitespace is clean" )
    AssertEqInt( DiagCount( "' just a comment" ), 0, "a comment-only document is clean" )
end scope

scope
    '' Half-typed text, which is what a language server actually sees.
    AssertTrue( DiagCount( "sub " ) >= 0, "`sub ` mid-word does not crash" )
    AssertTrue( DiagCount( "dim x as " ) >= 0, "`dim x as ` does not crash" )
    AssertTrue( DiagCount( "if ( " ) >= 0, "`if ( ` does not crash" )
    AssertTrue( DiagCount( "type " ) >= 0, "`type ` does not crash" )
    AssertTrue( DiagCount( "end " ) >= 0, "`end ` does not crash" )
    AssertTrue( DiagCount( "#" ) >= 0, "a lone # does not crash" )
    AssertTrue( DiagCount( DQ ) >= 0, "a lone quote does not crash" )
end scope

'' ----------------------------------------------------------------------------
''  The real-source pass
''
''  Run with the project root as argv(1). Every .bas and .bi under src/ and
''  tests/ must analyse with ZERO diagnostics -- they are all valid tiko,
''  compiled by this very build.
'' ----------------------------------------------------------------------------
private function ReadWholeFile( byref path_ as string, byref outText as string ) as boolean
    dim as long f = freefile( )
    if( open( path_ for binary access read as #f ) <> 0 ) then return false
    dim as longint n = lof( f )
    outText = ""
    if( n > 0 ) then
        outText = space( n )
        get #f, , outText
    end if
    close #f
    return true
end function

private sub CheckRealSource( byref root as string )
    TestGroup( "the analyser against this project's own source" )

    dim as string dirs( 0 to 6 ) = { "src", NativePath( "src\json" ), NativePath( "src\rpc" ), NativePath( "src\lsp" ), _
                                     NativePath( "src\document" ), NativePath( "src\handlers" ), NativePath( "src\utils" ) }
    dim as long filesSeen = 0
    dim as long filesClean = 0
    dim as long linesSeen = 0

    for d as long = 0 to ubound( dirs )
        dim as string pattern = root & NativePath( "\" ) & dirs(d) & NativePath( "\*.t*" )
        dim as string leaf = dir( pattern )

        while( len(leaf) > 0 )
            dim as string full = root & NativePath( "\" ) & dirs(d) & NativePath( "\" ) & leaf
            dim as string body
            if( ReadWholeFile( full, body ) ) then
                filesSeen += 1
                for k as long = 0 to len(body) - 1
                    if( body[k] = 10 ) then linesSeen += 1
                next

                dim as DiagnosticArray diags
                AnalyzeSource( body, diags )
                if( diags.Count( ) = 0 ) then
                    filesClean += 1
                else
                    TestFail( "clean: " & dirs(d) & NativePath( "\" ) & leaf, _
                              diags.Count( ) & " diagnostic(s), first at byte " & _
                              diags[0].StartOffset & ": " & diags[0].Message_ )
                end if
            end if
            leaf = dir( )
        wend
    next

    AssertTrue( filesSeen >= 20, "found the project's sources (" & filesSeen & " files)" )
    AssertEqInt( filesClean, filesSeen, filesSeen & " real source files, " & linesSeen & _
                 " lines, zero false positives" )
end sub

'' ----------------------------------------------------------------------------

dim as string root = command( 1 )
if( len(root) > 0 ) then
    CheckRealSource( root )
else
    print
    print "-- the real-source pass was skipped (no project root given)"
end if

end TestSummary( "analysis" )
