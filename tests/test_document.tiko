'' ############################################################################
''  tests/test_document.tiko -- URIs, the document model, the document manager
''
''  The incremental-edit tests are the important ones. Every LSP client sends
''  ranges, each applying to the document as the PREVIOUS change left it, and a
''  buffer that drifts from the editor's copy produces wrong answers forever
''  after -- silently, and only for the user who typed the offending sequence.
'' ############################################################################

#import "std/containers"
#include once "assert.ti"
#include once "../src/utils/uri.ti"
#include once "../src/document/document.ti"
#include once "../src/document/document_manager.ti"

const LF = chr(10)
const CR = chr(13)

const CJK1  = chr(228,184,173)          '' 中  3 bytes, 1 UTF-16 unit
const EMOJI = chr(240,159,152,128)      '' U+1F600  4 bytes, 2 UTF-16 units

#ifdef __FB_WIN32__
    const SEP = "\"
#else
    const SEP = "/"
#endif

'' ----------------------------------------------------------------------------
TestGroup( "URI: scheme" )

AssertEqStr( UriScheme( "file:///c%3A/dev/x.bas" ), "file", "file scheme" )
AssertEqStr( UriScheme( "untitled:Untitled-1" ), "untitled", "untitled scheme" )
AssertEqStr( UriScheme( "git:/repo/x.bas?ref" ), "git", "git scheme" )
AssertEqStr( UriScheme( "C:\dev\x.bas" ), "", "a Windows path is not a URI" )
AssertEqStr( UriScheme( "plain.bas" ), "", "a bare filename has no scheme" )
AssertTrue ( UriIsFile( "FILE:///c%3A/x.bas" ), "the scheme is case-insensitive" )
AssertFalse( UriIsFile( "untitled:Untitled-1" ), "untitled is not a file URI" )

'' ----------------------------------------------------------------------------
TestGroup( "URI: percent decoding" )

AssertEqStr( UriDecode( "c%3A/dev" ), "c:/dev", "%3A decodes to a colon" )
AssertEqStr( UriDecode( "a%20b" ), "a b", "%20 decodes to a space" )
AssertEqStr( UriDecode( "plain" ), "plain", "text without escapes is unchanged" )
AssertEqStr( UriDecode( "100%" ), "100%", "a trailing bare %% is kept verbatim" )
AssertEqStr( UriDecode( "%zz" ), "%zz", "an invalid escape is kept verbatim" )
'' A percent-encoded UTF-8 sequence decodes byte by byte and reassembles.
AssertEqStr( UriDecode( "%E4%B8%AD" ), CJK1, "percent-encoded UTF-8 reassembles" )

'' ----------------------------------------------------------------------------
TestGroup( "URI: to path" )

scope
    #ifdef __FB_WIN32__
        AssertEqStr( UriToPath( "file:///c%3A/dev/x.bas" ), "C:\dev\x.bas", "encoded drive letter" )
        AssertEqStr( UriToPath( "file:///c:/dev/x.bas" ), "C:\dev\x.bas", "unencoded drive letter" )
        AssertEqStr( UriToPath( "file:///C:/dev/my%20file.bas" ), "C:\dev\my file.bas", "escaped space in a path" )
        AssertEqStr( UriToPath( "file://server/share/x.bas" ), "\\server\share\x.bas", "UNC authority" )
    #else
        AssertEqStr( UriToPath( "file:///home/u/x.bas" ), "/home/u/x.bas", "posix path" )
        AssertEqStr( UriToPath( "file:///home/u/my%20file.bas" ), "/home/u/my file.bas", "escaped space in a path" )
    #endif

    AssertEqStr( UriToPath( "untitled:Untitled-1" ), "", "a non-file URI has no path" )
    AssertEqStr( UriToPath( "file:///c%3A/dev/x.bas?v=2" ), UriToPath( "file:///c%3A/dev/x.bas" ), "a query is stripped" )
    AssertEqStr( UriToPath( "file:///c%3A/dev/x.bas#L10" ), UriToPath( "file:///c%3A/dev/x.bas" ), "a fragment is stripped" )
end scope

'' ----------------------------------------------------------------------------
TestGroup( "URI: from path, and round trip" )

scope
    dim as string uri = PathToUri( "C:" & SEP & "dev" & SEP & "x.bas" )
    AssertEqStr( uri, "file:///c%3A/dev/x.bas", "a drive path encodes the colon, as clients do" )
    AssertEqStr( UriToPath( uri ), "C:" & SEP & "dev" & SEP & "x.bas", "path -> uri -> path round-trips" )

    AssertEqStr( PathToUri( "" ), "", "an empty path has no URI" )
    AssertContains( PathToUri( "C:" & SEP & "dev" & SEP & "my file.bas" ), "%20", "a space is encoded" )
end scope

'' ----------------------------------------------------------------------------
TestGroup( "URI: display name" )

AssertEqStr( UriFileName( "file:///c%3A/dev/tiko/frmMain.bas" ), "frmMain.bas", "last segment" )
AssertEqStr( UriFileName( "file:///c%3A/dev/my%20file.bas" ), "my file.bas", "last segment is decoded" )
AssertEqStr( UriFileName( "untitled:Untitled-1" ), "untitled:Untitled-1", "no slash means the whole URI" )

'' ----------------------------------------------------------------------------
TestGroup( "document: opening" )

scope
    dim as TextDocument doc = TextDocument( "file:///c%3A/dev/x.bas", "tiko", 1, _
                                            "dim as long i" & LF & "print i" )

    AssertEqStr( doc.Uri( ), "file:///c%3A/dev/x.bas", "the URI is kept verbatim" )
    AssertEqStr( doc.LanguageId( ), "tiko", "the language id is kept" )
    AssertEqInt( doc.Version( ), 1, "the version is kept" )
    AssertEqInt( doc.LineCount( ), 2, "the line index is built on open" )
    AssertEqStr( doc.LineText( 0 ), "dim as long i", "line 0 text" )
    AssertEqStr( doc.LineText( 1 ), "print i", "line 1 text" )
    AssertEqStr( doc.LineText( 9 ), "", "a line past the end is empty, not an error" )
    AssertFalse( doc.IsDirty( ), "a freshly opened document is not dirty" )
    AssertTrue ( len( doc.FilePath( ) ) > 0, "a file URI yields a path" )
end scope

scope
    dim as TextDocument doc = TextDocument( "untitled:Untitled-1", "tiko", 0, "" )
    AssertEqStr( doc.FilePath( ), "", "an untitled document has no path" )
    AssertEqInt( doc.LineCount( ), 1, "an empty document is one line" )
    AssertEqStr( doc.Text( ), "", "an empty document has no text" )
end scope

'' ----------------------------------------------------------------------------
TestGroup( "document: full replacement" )

scope
    dim as TextDocument doc = TextDocument( "file:///x", "tiko", 1, "old" )
    doc.ReplaceAll( "new" & LF & "text", 7 )

    AssertEqStr( doc.Text( ), "new" & LF & "text", "the text is replaced" )
    AssertEqInt( doc.Version( ), 7, "the version follows" )
    AssertEqInt( doc.LineCount( ), 2, "the line index is rebuilt" )
    AssertTrue ( doc.IsDirty( ), "a change marks the document dirty" )

    doc.MarkSaved( )
    AssertFalse( doc.IsDirty( ), "didSave clears dirty" )
end scope

'' ----------------------------------------------------------------------------
TestGroup( "document: incremental edits" )

scope
    dim as TextDocument doc = TextDocument( "file:///x", "tiko", 1, "line1" & LF & "line2" )

    '' Insert at the very start: an empty range.
    doc.ApplyRange( 0, 0, 0, 0, "AA", 2 )
    AssertEqStr( doc.Text( ), "AAline1" & LF & "line2", "an empty range inserts" )
    AssertEqInt( doc.Version( ), 2, "the version follows an edit" )

    '' Replace within one line.
    doc.ApplyRange( 0, 0, 0, 2, "", 3 )
    AssertEqStr( doc.Text( ), "line1" & LF & "line2", "an empty replacement deletes" )

    '' Append at the end of the document.
    doc.ApplyRange( 1, 5, 1, 5, "!", 4 )
    AssertEqStr( doc.Text( ), "line1" & LF & "line2!", "an edit at the end appends" )

    '' Delete across the line break: two lines become one.
    doc.ApplyRange( 0, 5, 1, 0, "", 5 )
    AssertEqStr( doc.Text( ), "line1line2!", "deleting the terminator joins the lines" )
    AssertEqInt( doc.LineCount( ), 1, "the line count follows" )

    '' Insert a newline: one line becomes two.
    doc.ApplyRange( 0, 5, 0, 5, LF, 6 )
    AssertEqStr( doc.Text( ), "line1" & LF & "line2!", "inserting a terminator splits the line" )
    AssertEqInt( doc.LineCount( ), 2, "the line count follows again" )
end scope

scope
    '' What typing actually looks like: one character at a time, each with its
    '' own range, each against the previous state.
    dim as TextDocument doc = TextDocument( "file:///x", "tiko", 1, "" )
    dim as string want = "dim as long i"

    for i as long = 0 to len(want) - 1
        doc.ApplyRange( 0, i, 0, i, chr( want[i] ), i + 2 )
    next

    AssertEqStr( doc.Text( ), want, "13 single-character insertions build the line" )
    AssertEqInt( doc.Version( ), len(want) + 1, "each keystroke advanced the version" )
    AssertEqInt( doc.LineCount( ), 1, "still one line" )
end scope

scope
    '' Ranges are in UTF-16 columns, so an edit after a CJK character must not
    '' be placed by byte count.
    dim as TextDocument doc = TextDocument( "file:///x", "tiko", 1, _
                                            "print """ & CJK1 & """" )
    '' Columns: p=0 r=1 i=2 n=3 t=4 space=5 quote=6 CJK=7 quote=8
    doc.ApplyRange( 0, 7, 0, 8, "X", 2 )
    AssertEqStr( doc.Text( ), "print ""X""", "a CJK character is replaced by UTF-16 column" )
end scope

scope
    '' An astral character is TWO columns wide, and deleting it takes both.
    dim as TextDocument doc = TextDocument( "file:///x", "tiko", 1, "a" & EMOJI & "b" )
    doc.ApplyRange( 0, 1, 0, 3, "", 2 )
    AssertEqStr( doc.Text( ), "ab", "a surrogate pair is deleted as two columns" )
end scope

scope
    '' Hostile input: a reversed range, and coordinates past the end. Neither
    '' may lose the buffer.
    dim as TextDocument doc = TextDocument( "file:///x", "tiko", 1, "abcdef" )

    doc.ApplyRange( 0, 4, 0, 1, "-", 2 )
    AssertEqStr( doc.Text( ), "a-ef", "a reversed range is normalised, not dropped" )

    doc.ApplyRange( 0, 99, 0, 99, "Z", 3 )
    AssertEqStr( doc.Text( ), "a-efZ", "an out-of-range edit clamps to the end" )

    doc.ApplyRange( 42, 0, 99, 0, "!", 4 )
    AssertEqStr( doc.Text( ), "a-efZ!", "a line past the end clamps to the end" )
end scope

'' ----------------------------------------------------------------------------
TestGroup( "document: coordinates" )

scope
    dim as TextDocument doc = TextDocument( "file:///x", "tiko", 1, _
                                            "sub Test" & CR & LF & "end sub" )

    AssertEqInt( doc.LineCount( ), 2, "CRLF text is two lines" )
    AssertEqStr( doc.LineText( 0 ), "sub Test", "the CR is not part of the line text" )
    AssertEqInt( doc.PositionToOffset( 1, 0 ), 10, "line 1 starts after the CRLF" )

    dim as SourcePosition p = doc.OffsetToPosition( 10 )
    AssertEqInt( p.Line, 1, "offset 10 is on line 1" )
    AssertEqInt( p.Column, 0, "offset 10 is at column 0" )
end scope

'' ----------------------------------------------------------------------------
TestGroup( "document manager" )

scope
    dim as DocumentManager mgr

    AssertEqInt( mgr.Count( ), 0, "a new manager holds nothing" )
    AssertTrue ( mgr.Find( "file:///nope" ) = 0, "an unknown URI yields NULL" )
    AssertFalse( mgr.IsOpen( "file:///nope" ), "an unknown URI is not open" )
    AssertFalse( mgr.Close( "file:///nope" ), "closing an unknown URI reports false" )

    dim as TextDocumentPtr a = mgr.Open( "file:///a.bas", "tiko", 1, "aaa" )
    dim as TextDocumentPtr b = mgr.Open( "file:///b.bas", "tiko", 1, "bbb" )

    AssertTrue ( a <> 0 andalso b <> 0, "both documents opened" )
    AssertEqInt( mgr.Count( ), 2, "the manager holds two" )
    AssertTrue ( mgr.Find( "file:///a.bas" ) = a, "lookup returns the same object" )
    AssertEqStr( mgr.Find( "file:///b.bas" )->Text( ), "bbb", "and its content" )

    '' A lookup must never insert: this is the classic map-indexer trap.
    mgr.Find( "file:///ghost.bas" )
    AssertEqInt( mgr.Count( ), 2, "a failed lookup does NOT create an entry" )

    '' Re-opening keeps the same object, so a pointer held elsewhere stays good.
    dim as TextDocumentPtr again = mgr.Open( "file:///a.bas", "tiko", 9, "zzz" )
    AssertTrue ( again = a, "re-opening returns the same pointer" )
    AssertEqStr( a->Text( ), "zzz", "re-opening replaces the content" )
    AssertEqInt( a->Version( ), 9, "re-opening takes the new version" )
    AssertEqInt( mgr.Count( ), 2, "re-opening does not add a document" )

    AssertTrue ( mgr.Close( "file:///a.bas" ), "closing an open document reports true" )
    AssertEqInt( mgr.Count( ), 1, "the manager holds one" )
    AssertTrue ( mgr.Find( "file:///a.bas" ) = 0, "the closed document is gone" )

    dim uris as containers.Array( of string ) = mgr.OpenUris( )
    AssertEqInt( uris.Count( ), 1, "OpenUris lists what is open" )
    AssertEqStr( uris[0], "file:///b.bas", "and lists the right one" )

    mgr.CloseAll( )
    AssertEqInt( mgr.Count( ), 0, "CloseAll empties the manager" )
end scope

scope
    '' Open and close a hundred documents to exercise the allocate/free path.
    dim as DocumentManager mgr
    for i as long = 1 to 100
        mgr.Open( "file:///doc" & i & ".bas", "tiko", 1, "line" & LF & "line" )
    next
    AssertEqInt( mgr.Count( ), 100, "a hundred documents open" )

    for i as long = 1 to 100 step 2
        mgr.Close( "file:///doc" & i & ".bas" )
    next
    AssertEqInt( mgr.Count( ), 50, "fifty closed, fifty remain" )
    AssertTrue ( mgr.Find( "file:///doc50.bas" ) <> 0, "an even-numbered document survives" )
    AssertTrue ( mgr.Find( "file:///doc51.bas" ) = 0, "an odd-numbered document is gone" )
end scope

'' AN EDITOR OPENS AND CLOSES FILES ONE AT A TIME, all session long. std/containers' Map
'' (tiko-lang before 92036e012) never cleared the tombstones a Remove leaves, so after
'' eight open/close cycles its table held no empty slot and Put stored nothing: every
'' document opened from then on was lost -- its didChange and didClose were "not open",
'' its diagnostics never refreshed. One document at a time, forty times, with one other
'' kept open throughout as an editor's pinned tab would be.
scope
    dim as DocumentManager mgr
    mgr.Open( "file:///pinned.tiko", "tiko", 1, "x" )
    dim as long lost = 0
    for i as long = 1 to 40
        dim as string u = "file:///cycle" & i & ".tiko"
        mgr.Open( u, "tiko", 1, "y" )
        if( mgr.Find( u ) = 0 orelse mgr.Count( ) <> 2 ) then lost += 1
        if( mgr.Close( u ) = false ) then lost += 1
    next
    AssertEqInt( lost, 0, "forty open/close cycles lose no document" )
    AssertEqInt( mgr.Count( ), 1, "and the pinned one is all that is left open" )
    AssertTrue ( mgr.Find( "file:///pinned.tiko" ) <> 0, "still findable" )
end scope

end TestSummary( "document" )
